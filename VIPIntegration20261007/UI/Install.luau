body.AutomaticCanvasSize = Enum.AutomaticSize.None
body.BackgroundTransparency = 1
body.BorderSizePixel = 0
body.ScrollBarThickness = 4
body.ScrollBarImageColor3 = Color3.fromRGB(30, 44, 77)
