 local frame=Instance.new("Frame")
 frame.Name="ArtFallback"
 frame.Size=UDim2.fromScale(1,1)
 frame.BackgroundColor3=color
 frame.BorderSizePixel=0
 frame.ZIndex=host.ReusableSkin.ZIndex
 local corner=Instance.new("UICorner") corner.CornerRadius=UDim.new(0,radius) corner.Parent=frame
 local outline=Instance.new("UIStroke") outline.Color=Color3.fromRGB(27,39,70) outline.Thickness=thickness outline.Parent=frame
 frame.Parent=host
end
