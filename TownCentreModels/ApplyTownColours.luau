local selected=Selection:Get()
assert(#selected>0,"Select the imported town-centre or gift-truck model first")
local changed=0
local seen={}
local function apply(part)
 if seen[part] or not part:IsA("BasePart") then return end
 seen[part]=true
 local entry=palette[part.Name] or palette[part.Name:gsub("%.%d+$","")]
 if not entry then return end
 part.Color=Color3.fromRGB(entry[1],entry[2],entry[3])
 part.Transparency=entry[4]
 part.Material=entry[5] and Enum.Material.Metal or Enum.Material.SmoothPlastic
 part.Reflectance=entry[5] and 0.03 or 0
 part.Anchored=true
 part.CanCollide=entry[6]
 part.CanTouch=false
 if part:IsA("MeshPart") and entry[6] then part.CollisionFidelity=Enum.CollisionFidelity.Hull end
 changed+=1
end
for _,item in selected do
 apply(item)
 for _,part in item:GetDescendants() do apply(part) end
end
assert(changed>0,"No matching exported parts were found; retain the original mesh names when importing")
print("Town-centre colours and collision settings applied to "..changed.." parts")
