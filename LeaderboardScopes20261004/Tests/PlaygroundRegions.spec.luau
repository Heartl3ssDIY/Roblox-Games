local names = {
	Europe = "Europe",
	NorthAmerica = "North America",
	SouthAmerica = "South America",
	Africa = "Africa",
	Asia = "Asia",
	Oceania = "Oceania",
}
local assigned = 0
for country, expected in sourceExpectations do
	local region = Regions.Resolve(country)
	check(region ~= nil and region.id == expected, country .. " region mismatch")
	check(region.name == names[expected], country .. " display name mismatch")
	check(Regions.Resolve(string.lower(country)) == region, country .. " lowercase mismatch")
	check(table.isfrozen(region), country .. " result must be immutable")
	assigned += 1
end
check(assigned == 249, "Source coverage changed")
local documented = 0
for country in string.gmatch(documentedCodes, "%u%u") do
	local region = Regions.Resolve(country)
	check(region ~= nil or country == "AQ" or country == "XX", country .. " documented Roblox code missing")
	documented += 1
end
check(documented == 250, "Documented Roblox country code coverage changed")
for first = 65, 90 do
	for second = 65, 90 do
		local country = string.char(first, second)
		local region = Regions.Resolve(country)
		check((region and region.id) == sourceExpectations[country], country .. " unexpected assignment")
	end
end
for _, value in { "", "USA", "G", "en-US", " GB", "GB ", "G1", "12", "G_", "ÅX", "éé", "??", "UK", "XK", "ZZ", "XX", "AQ", 12, true, false, {}, function() end } do
	check(Regions.Resolve(value) == nil, "Invalid value was assigned: " .. tostring(value))
end
check(Regions.Resolve(nil) == nil, "nil must be unavailable")
check(table.isfrozen(Regions), "API must be immutable")
local mutable = pcall(function() Regions.Resolve("GB").id = "Asia" end)
check(not mutable and Regions.Resolve("GB").id == "Europe", "Result mutation changed future resolutions")
print("PASS " .. checks .. " region checks; 249 assignments, 250 documented Roblox codes, all 676 ASCII pairs")
