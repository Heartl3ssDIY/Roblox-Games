local RunService = game:GetService("RunService")
assert(not RunService:IsRunning(), "Stop the playtest before applying the attack update")
assert(game.PlaceId == 111313211501470, "Wrong place: expected Anime Combat Units")
local storage = game:GetService("ReplicatedStorage")
local function normalized(source)
    return source:gsub("\r", ""):gsub("%s+$", "")
end
for name, source in pairs(payload.sources) do
    local compiled, message = loadstring(source, name)
    assert(compiled, message)
    local current = storage:FindFirstChild(name)
    if payload.expected[name] then
        assert(current and current:IsA("ModuleScript"), "Missing module: " .. name)
        assert(normalized(current.Source) == normalized(payload.expected[name]), "Source changed since backup: " .. name)
    else
        assert(not current, "A module named " .. name .. " already exists; inspect it before replacing")
    end
end
local backup = Instance.new("Folder")
backup.Name = "BeforeAttackTiming_20260926_" .. tostring(os.time())
for name in pairs(payload.expected) do storage[name]:Clone().Parent = backup end
backup:SetAttribute("IncludesFullPlace", false)
backup.Parent = game:GetService("ServerStorage")
local added = {}
local ok, failure = pcall(function()
    for name, source in pairs(payload.sources) do
        local module = storage:FindFirstChild(name)
        if not module then
            module = Instance.new("ModuleScript")
            module.Name = name
            table.insert(added, module)
            module.Parent = storage
        end
        module.Source = source
    end
end)
if not ok then
    for name in pairs(payload.expected) do storage[name].Source = backup[name].Source end
    for _, module in ipairs(added) do module:Destroy() end
    error(failure)
end
return game:GetService("HttpService"):JSONEncode({installed=true,backup=backup:GetFullName(),savedOrPublished=false})