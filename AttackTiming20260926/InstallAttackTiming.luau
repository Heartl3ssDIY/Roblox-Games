local payload = game:GetService("HttpService"):JSONDecode([====[{"expected":{"AttackAnimator":"local MatchClock = require(game:GetService(\"ReplicatedStorage\"):WaitForChild(\"MatchClock\"))\nlocal RunService = game:GetService(\"RunService\")\nlocal AttackAnimator = {}\nlocal states = {}\nlocal connection\n\nlocal function getState(model)\n\tif states[model] then return states[model] end\n\tlocal state = { joints = {}, walking = false, walkWeight = 0, attackTime = -10, duration = 0.35, clock = 0 }\n\tfor _, joint in ipairs(model:GetDescendants()) do\n\t\tif joint:IsA(\"Motor6D\") then\n\t\t\tstate.joints[joint] = joint.C0\n\t\tend\n\tend\n\tstates[model] = state\n\treturn state\nend\n\nlocal function poseJoint(joint, rest, state, strength)\n\tlocal name = joint.Name:gsub(\" \", \"\")\n\tlocal swing = math.sin(state.clock * 11) * 0.45 * state.walkWeight\n\tlocal rotation = CFrame.identity\n\tif name == \"RightHip\" or name == \"LeftShoulder\" then rotation = CFrame.Angles(swing, 0, 0) end\n\tif name == \"LeftHip\" or name == \"RightShoulder\" then rotation = CFrame.Angles(-swing, 0, 0) end\n\tlocal target = rest * rotation\n\tlocal bothArms = state.unitName == \"Master Roshu\" or state.unitName == \"Tein\"\n\tif strength > 0 and (name == \"RightShoulder\" or (name == \"LeftShoulder\" and bothArms)) then\n\t\tlocal angle = state.unitName == \"Tein\" and 135 or 90\n\t\tlocal attack = rest * CFrame.Angles(math.rad(angle), 0, 0)\n\t\tif joint.Name:find(\" \") then\n\t\t\tattack = CFrame.new(rest.Position) * CFrame.Angles(math.rad(angle), 0, 0)\n\t\tend\n\t\ttarget = target:Lerp(attack, strength)\n\tend\n\treturn target\nend\n\nlocal function update(dt)\n    if MatchClock.isPaused() then return end\n\tlocal now = MatchClock.now()\n\tfor model, state in pairs(states) do\n\t\tif not model.Parent then\n\t\t\tstates[model] = nil\n\t\telse\n\t\t\tstate.clock += dt\n\t\t\tstate.walkWeight += ((state.walking and 1 or 0) - state.walkWeight) * (1 - math.exp(-12 * dt))\n\t\t\tlocal age = now - state.attackTime\n\t\t\tlocal strength = math.clamp(math.min(age / 0.06, (state.duration - age) / 0.12), 0, 1)\n\t\t\tstrength = strength * strength * (3 - 2 * strength)\n\t\t\tfor joint, rest in pairs(state.joints) do\n\t\t\t\tif joint.Parent then\n\t\t\t\t\tjoint.C0 = joint.C0:Lerp(poseJoint(joint, rest, state, strength), 1 - math.exp(-25 * dt))\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tif not next(states) and connection then\n\t\tconnection:Disconnect()\n\t\tconnection = nil\n\tend\nend\n\nlocal function start()\n\tif not connection then connection = RunService.RenderStepped:Connect(update) end\nend\n\nfunction AttackAnimator.setWalking(model, walking)\n\tgetState(model).walking = walking\n\tstart()\nend\n\nfunction AttackAnimator.play(model, unitName)\n\tlocal state = getState(model)\n\tstate.unitName = unitName\n\tstate.attackTime = MatchClock.now()\n\tstate.duration = unitName == \"Master Roshu\" and 0.7 or 0.3\n\tstart()\nend\n\nfunction AttackAnimator.stop(model)\n\tlocal state = states[model]\n\tif not state then return end\n\tfor joint, rest in pairs(state.joints) do\n\t\tif joint.Parent then joint.C0 = rest end\n\tend\n\tstates[model] = nil\n\tif not next(states) and connection then connection:Disconnect(); connection = nil end\nend\n\nfunction AttackAnimator.stopAll()\n\tfor model in pairs(states) do AttackAnimator.stop(model) end\n\tif connection then connection:Disconnect() connection = nil end\nend\n\nreturn AttackAnimator\n\n\r\n","UnitData":"export type Range = {\n\tcategory: string,\n\tvalue: number,\n}\n\nexport type Unit = {\n\tid: string,\n\tname: string,\n\trarity: string,\n\ttype: string,\n\tmobile: boolean,\n\tlines: { string },\n\thealth: number,\n\tdamage: number,\n\trange: Range,\n\thitSpeed: number,\n\tdamagePattern: string,\n\tability: string?,\n\tmodel: string,\n}\n\nlocal Units: { [string]: Unit } = {\n\tYumcha = {\n\t\tid = \"Yumcha\",\n\t\tname = \"Yumcha\",\n\t\trarity = \"Common\",\n\t\ttype = \"Melee\",\n\t\tmobile = true,\n\t\tlines = { \"front\" },\n\t\thealth = 126,\n\t\tdamage = 13,\n\t\trange = { category = \"Short\", value = 1 },\n\t\thitSpeed = 0.3,\n\t\tdamagePattern = \"Single\",\n\t\tability = nil,\n\t\tmodel = \"Yumcha\",\n\t},\n\n\tGoku = {\n\t\tid = \"Goku\",\n\t\tname = \"Goku\",\n\t\trarity = \"Common\",\n\t\ttype = \"Ranged\",\n\t\tmobile = false,\n\t\tlines = { \"back\" },\n\t\thealth = 152,\n\t\tdamage = 26,\n\t\trange = { category = \"Long\", value = 4 },\n\t\thitSpeed = 1.0,\n\t\tdamagePattern = \"Single\",\n\t\tability = nil,\n\t\tmodel = \"Guku\",\n\t},\n\n\tKrillen = {\n\t\tid = \"Krillen\",\n\t\tname = \"Krillen\",\n\t\trarity = \"Common\",\n\t\ttype = \"Melee\",\n\t\tmobile = true,\n\t\tlines = { \"front\" },\n\t\thealth = 67,\n\t\tdamage = 13,\n\t\trange = { category = \"Short\", value = 1 },\n\t\thitSpeed = 0.3,\n\t\tdamagePattern = \"Single\",\n\t\tability = nil,\n\t\tmodel = \"Krillen\",\n\t},\n\n\tTein = {\n\t\tid = \"Tein\",\n\t\tname = \"Tein\",\n\t\trarity = \"Common\",\n\t\ttype = \"Energy\",\n\t\tmobile = true,\n\t\tlines = { \"mid\" },\n\t\thealth = 93,\n\t\tdamage = 100,\n\t\trange = { category = \"Short\", value = 2 },\n\t\thitSpeed = 1.0,\n\t\tdamagePattern = \"AoE\",\n\t\tability = nil,\n\t\tmodel = \"Tein\",\n\t},\n\n\tMasterRoshu = {\n\t\tid = \"MasterRoshu\",\n\t\tname = \"Master Roshu\",\n\t\trarity = \"Common\",\n\t\ttype = \"Tank\",\n\t\tmobile = false,\n\t\tlines = { \"back\" },\n\n\t\thealth = 190,\n\t\tdamage = 133,\n\t\trange = { category = \"Long\", value = 5 },\n\t\thitSpeed = 5.3,\n\t\tdamagePattern = \"Blast Single\",\n\t\tability = nil,\n\t\tmodel = \"Master Roshu\",\n\t},\n\n\tBluma = {\n\t\tid = \"Bluma\",\n\t\tname = \"Bluma\",\n\t\trarity = \"Common\",\n\t\ttype = \"Artillery\",\n\t\tmobile = true,\n\t\tlines = { \"front\" },\n\t\thealth = 79,\n\t\tdamage = 18,\n\t\trange = { category = \"Short\", value = 1 },\n\t\thitSpeed = 0.5,\n\t\tdamagePattern = \"Artillery Single\",\n\t\tability = nil,\n\t\tmodel = \"Bluma\",\n\n\t\tunlockable = true,\n\t\tunlockArena = \"Tenkaichi\",\n\t\tunlockPoints = 40,\n\t},\n\n\tPikkolo = {\n\t\tid = \"Pikkolo\",\n\t\tname = \"Pikkolo\",\n\t\trarity = \"Rare\",\n\t\ttype = \"Energy\",\n\t\tmobile = true,\n\t\tlines = { \"mid\" },\n\t\thealth = 161,\n\t\tdamage = 24,\n\t\trange = { category = \"Short\", value = 1 },\n\t\thitSpeed = 0.3,\n\t\tdamagePattern = \"Blast Single\",\n\t\tability = \"Nameekian Split\",\n\n\t\tmodel = \"Pikkolo\",\n\t\tunlockable = true,\n\t\tunlockArena = \"Tenkaichi\",\n\t\tunlockPoints = 100,\n\t},\n}\n\nlocal UnitData = {}\nUnitData.Units = Units\n\nfunction UnitData.get(id: string): Unit?\n\treturn Units[id]\nend\n\nfunction UnitData.all(): { [string]: Unit }\n\treturn Units\nend\n\nreturn UnitData\n\n\n","CombatController":"local MatchClock = require(game:GetService(\"ReplicatedStorage\"):WaitForChild(\"MatchClock\"))\nlocal MatchSettings = require(game:GetService(\"ReplicatedStorage\"):WaitForChild(\"MatchSettings\"))\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal Debris = game:GetService(\"Debris\")\nlocal UnitData = require(ReplicatedStorage.UnitData)\nlocal ArenaConfig = require(ReplicatedStorage.ArenaConfig)\nlocal PlayerData = require(ReplicatedStorage.PlayerData)\nlocal AttackAnimator = require(ReplicatedStorage.AttackAnimator)\nlocal CombatController = {}\nlocal active\nlocal ranges = { 7, 14, 22, 32, 44 }\nlocal colors = {\n\t[\"Master Roshu\"] = Color3.fromRGB(65, 165, 255),\n\tGoku = Color3.fromRGB(255, 210, 70),\n\tPikkolo = Color3.fromRGB(170, 85, 255),\n\tTein = Color3.fromRGB(255, 155, 65),\n}\n\nlocal function position(unit)\n\treturn unit.simPivot.Position\nend\n\nlocal function flatDistance(a, b)\n\tlocal delta = position(a) - position(b)\n\treturn Vector2.new(delta.X, delta.Z).Magnitude\nend\n\nlocal function makeUnit(model)\n\tlocal id = model:GetAttribute(\"UnitId\")\n\tlocal data = UnitData.get(id)\n\tif not data or not model.PrimaryPart then return nil end\n\tlocal side = model:GetAttribute(\"Side\")\n\tlocal health, damage = data.health, data.damage\n\tif side == \"player\" then health, damage = PlayerData.unitStats(id, health, damage) end\n\tmodel:SetAttribute(\"Health\", health)\n\tmodel:SetAttribute(\"MaxHealth\", health)\n\tlocal humanoid = model:FindFirstChildOfClass(\"Humanoid\")\n\tif humanoid then humanoid.MaxHealth = health humanoid.Health = health end\n\treturn {\n\t\tmodel = model, data = data, side = side, hp = health, maxHp = health,\n\t\tsimPivot = model:GetPivot(), visualFrom = model:GetPivot(), visualTarget = model:GetPivot(),\n\t\tvisualStarted = MatchClock.now(), visualDuration = 0.1,\n\t\tdamage = damage, cooldown = 0.2, range = ranges[data.range.value] or 7,\n\t}\nend\n\nlocal function alive(unit)\n\treturn unit.hp > 0 and unit.model.Parent ~= nil\nend\n\nlocal function nearestEnemy(unit, units)\n\tlocal nearest, distance = nil, math.huge\n\tif unit.target and alive(unit.target) then\n\t\tlocal current = flatDistance(unit, unit.target)\n\t\tif current <= unit.range then return unit.target, current end\n\tend\n\tfor _, enemy in ipairs(units) do\n\t\tif enemy.side ~= unit.side and alive(enemy) then\n\t\t\tlocal current = flatDistance(unit, enemy)\n\t\t\tif current < distance then nearest, distance = enemy, current end\n\t\tend\n\tend\n\treturn nearest, distance\nend\n\nlocal function effectPart(folder, color)\n\tlocal part = Instance.new(\"Part\")\n\tpart.Anchored = true\n\tpart.CanCollide = false\n\tpart.CanTouch = false\n\tpart.CanQuery = false\n\tpart.CastShadow = false\n\tpart.Material = Enum.Material.Neon\n\tpart.Color = color\n\tpart.Parent = folder\n\treturn part\nend\n\nlocal function flash(folder, point, color, size)\n\tlocal part = effectPart(folder, color)\n\tpart.Name = \"Impact\"\n\tpart.Shape = Enum.PartType.Ball\n\tpart.Size = Vector3.one * 0.3\n\tpart.Position = point\n\tTweenService:Create(part, TweenInfo.new(0.2), { Size = Vector3.one * size, Transparency = 1 }):Play()\n\tDebris:AddItem(part, 0.22)\nend\n\nlocal function attackEffect(session, unit, target)\n    if not MatchSettings.effectsEnabled() then return end\n\tlocal color = colors[unit.data.name] or Color3.fromRGB(255, 190, 100)\n\tlocal targetBody = target.model:FindFirstChild(\"UpperTorso\") or target.model:FindFirstChild(\"Torso\") or target.model.PrimaryPart\n\tlocal finish = targetBody.Position\n\tflash(session.effects, finish, color, unit.data.type == \"Melee\" and 1.8 or 2.6)\n\tif unit.data.type == \"Melee\" then return end\n\tlocal hand = unit.model:FindFirstChild(\"RightHand\") or unit.model:FindFirstChild(\"Right Arm\") or unit.model.PrimaryPart\n\tif unit.data.name == \"Tein\" then hand = unit.model:FindFirstChild(\"Head\") or hand end\n\tlocal start = hand.Position\n\tlocal length = (finish - start).Magnitude\n\tif length < 0.1 then return end\n\tlocal thickness = unit.data.type == \"Tank\" and 0.9 or 0.35\n\tfor i = 1, 2 do\n\t\tlocal beam = effectPart(session.effects, i == 1 and color or Color3.new(1, 1, 1))\n\t\tbeam.Name = \"EnergyBeam\"\n\t\tlocal width = i == 1 and thickness * 2 or thickness\n\t\tbeam.Size = Vector3.new(width, width, length)\n\t\tbeam.CFrame = CFrame.lookAt((start + finish) / 2, finish)\n\t\tbeam.Transparency = i == 1 and 0.55 or 0\n\t\tTweenService:Create(beam, TweenInfo.new(0.18), { Transparency = 1 }):Play()\n\t\tDebris:AddItem(beam, 0.2)\n\tend\nend\n\nlocal function defeat(unit)\n\tAttackAnimator.stop(unit.model)\n\tunit.model:SetAttribute(\"Defeated\", true)\n\tfor _, part in ipairs(unit.model:GetDescendants()) do\n\t\tif part:IsA(\"BasePart\") then\n\t\t\tTweenService:Create(part, TweenInfo.new(0.4), { Transparency = 1 }):Play()\n\t\tend\n\tend\n\tDebris:AddItem(unit.model, 0.45)\nend\n\nlocal function stepCombat(session, dt)\n\tlocal damage = {}\n\tfor _, unit in ipairs(session.units) do\n\t\tif alive(unit) then\n\t\t\tunit.cooldown = math.max(0, unit.cooldown - dt)\n\t\t\tlocal target, distance = nearestEnemy(unit, session.units)\n\t\t\tunit.target = target\n\t\t\tif target then\n\t\t\t\tlocal point = position(unit)\n\t\t\t\tlocal direction = position(target) - point\n\t\t\t\tdirection = Vector3.new(direction.X, 0, direction.Z)\n\t\t\t\tlocal moving = distance > unit.range\n\t\t\t\tif moving and direction.Magnitude > 0.01 then\n\t\t\t\t\tlocal speed = unit.data.mobile and 14 or 4.9\n\t\t\t\t\tpoint = ArenaConfig.clampPosition(point + direction.Unit * math.min(speed * dt, distance - unit.range + 0.05))\n\t\t\t\tend\n\t\t\t\tif direction.Magnitude > 0.01 then\n\t\t\t\t\tunit.simPivot = CFrame.lookAt(point, point + direction)\n\t\t\t\t\tunit.visualFrom = unit.model:GetPivot()\n\t\t\t\t\tunit.visualTarget = unit.simPivot\n\t\t\t\t\tunit.visualStarted = MatchClock.now()\n\t\t\t\t\tunit.visualDuration = dt\n\t\t\t\tend\n\t\t\t\tAttackAnimator.setWalking(unit.model, moving)\n\t\t\t\tif not moving and unit.cooldown <= 0 then\n\t\t\t\t\tAttackAnimator.play(unit.model, unit.data.name)\n\t\t\t\t\tattackEffect(session, unit, target)\n\t\t\t\t\tdamage[target] = (damage[target] or 0) + unit.damage\n\t\t\t\t\tunit.cooldown = math.max(0.1, unit.data.hitSpeed)\n\t\t\t\t\tsession.attacks += 1\n\t\t\t\tend\n\t\t\telse\n\t\t\t\tAttackAnimator.setWalking(unit.model, false)\n\t\t\tend\n\t\tend\n\tend\n\tfor unit, amount in pairs(damage) do\n\t\tunit.hp = math.max(0, unit.hp - amount)\n\t\tunit.model:SetAttribute(\"Health\", unit.hp)\n\t\tlocal humanoid = unit.model:FindFirstChildOfClass(\"Humanoid\")\n\t\tif humanoid then humanoid.Health = math.max(0.01, unit.hp) end\n\t\tif unit.hp == 0 then defeat(unit) end\n\tend\n\tsession.arena:SetAttribute(\"CombatAttacks\", session.attacks)\nend\n\nlocal function renderCombat(session)\n\tif active ~= session or MatchClock.isPaused() then return end\n\tlocal now = MatchClock.now()\n\tfor _, unit in ipairs(session.units) do\n\t\tif alive(unit) then\n\t\t\tlocal alpha = math.clamp((now - unit.visualStarted) / math.max(unit.visualDuration, 1 / 240), 0, 1)\n\t\t\tunit.model:PivotTo(unit.visualFrom:Lerp(unit.visualTarget, alpha))\n\t\tend\n\tend\nend\n\nlocal function result(session)\n\tlocal count = { player = 0, opponent = 0 }\n\tlocal health = { player = 0, opponent = 0 }\n\tlocal starting = { player = 0, opponent = 0 }\n\tfor _, unit in ipairs(session.units) do\n\t\tstarting[unit.side] += unit.maxHp\n\t\tif alive(unit) then\n\t\t\tcount[unit.side] += 1\n\t\t\thealth[unit.side] += unit.hp\n\t\tend\n\tend\n\tif count.player == 0 or count.opponent == 0 then\n\t\treturn true, count.player > 0 and \"player\" or (count.opponent > 0 and \"opponent\" or nil)\n\tend\n\tif session.elapsed < session.limit then return false end\n\tlocal playerHealth = health.player / math.max(1, starting.player)\n\tlocal opponentHealth = health.opponent / math.max(1, starting.opponent)\n\tif math.abs(playerHealth - opponentHealth) < 0.001 then return true, nil end\n\treturn true, playerHealth > opponentHealth and \"player\" or \"opponent\"\nend\n\nfunction CombatController.cancel()\n\tif active then\n\t\tif active.connection then active.connection:Disconnect() end\n\t\tif active.renderConnection then active.renderConnection:Disconnect() end\n\t\tfor _, unit in ipairs(active.units) do\n\t\t\tif alive(unit) then unit.model:PivotTo(unit.simPivot) end\n\t\tend\n\t\tif active.effects then active.effects:Destroy() end\n\t\tactive = nil\n\tend\n\tAttackAnimator.stopAll()\nend\n\nfunction CombatController.run(onEnd, options)\n\tCombatController.cancel()\n\toptions = options or {}\n\tlocal arena = ArenaConfig.getArena()\n\tlocal folder = arena and arena:FindFirstChild(\"DeployedUnits\")\n\tif not folder then task.defer(onEnd, nil) return end\n\tlocal session = { arena = arena, units = {}, elapsed = 0, accumulator = 0, attacks = 0, limit = options.timeLimit or 30 }\n\tsession.effects = Instance.new(\"Folder\")\n\tsession.effects.Name = \"CombatEffects\"\n\tsession.effects.Parent = arena\n\tfor _, model in ipairs(folder:GetChildren()) do\n\t\tlocal unit = makeUnit(model)\n\t\tif unit then table.insert(session.units, unit) end\n\tend\n\ttable.sort(session.units, function(a, b) return a.model:GetAttribute(\"SpawnIndex\") < b.model:GetAttribute(\"SpawnIndex\") end)\n\tactive = session\n\tsession.renderConnection = RunService.RenderStepped:Connect(function() renderCombat(session) end)\n\tarena:SetAttribute(\"CombatAttacks\", 0)\n\tsession.connection = RunService.Heartbeat:Connect(function(dt)\n\t\tif active ~= session then return end\n\t\tif not folder.Parent or (options.isCurrent and not options.isCurrent()) then\n\t\t\tCombatController.cancel()\n\t\t\treturn\n\t\tend\n        if MatchClock.isPaused() then return end\n\t\tsession.elapsed += dt\n\t\tsession.accumulator += dt\n\t\tif session.accumulator < 0.1 then return end\n\t\tlocal step = math.min(session.accumulator, 0.2)\n\t\tsession.accumulator = 0\n\t\tstepCombat(session, step)\n\t\tlocal finished, winner = result(session)\n\t\tif finished then\n\t\t\tCombatController.cancel()\n\t\t\tarena:SetAttribute(\"LastRoundWinner\", winner or \"draw\")\n\t\t\ttask.defer(onEnd, winner)\n\t\tend\n\tend)\nend\n\nreturn CombatController\n\n\r\n"},"sources":{"AttackTimeline":"local AttackTimeline = {}\n\nfunction AttackTimeline.get(unitName, unitType, hitSpeed)\n\tlocal speed = tonumber(hitSpeed) or 1\n\tif speed ~= speed or speed == math.huge or speed == -math.huge then speed = 1 end\n\tlocal profile = {\n\t\tkind = \"Ranged\", releaseAt = 0.46, duration = 0.89,\n\t\tcooldown = math.max(speed, 1.05), beamDuration = 0.16,\n\t}\n\tif unitName == \"Master Roshu\" or unitName == \"Master Roshi\" then\n\t\tprofile.kind = \"Roshi\"\n\t\tprofile.releaseAt, profile.duration = 1.35, 2.25\n\t\tprofile.cooldown, profile.beamDuration = math.max(speed, 2.4), 0.38\n\telseif unitType == \"Melee\" then\n\t\tprofile.kind = \"Melee\"\n\t\tprofile.releaseAt, profile.duration = 0.22, 0.50\n\t\tprofile.cooldown, profile.beamDuration = math.max(speed, 0.60), 0\n\telseif unitName == \"Pikkolo\" then\n\t\tprofile.kind = \"Pikkolo\"\n\t\tprofile.releaseAt, profile.duration = 0.38, 0.73\n\t\tprofile.cooldown = math.max(speed, 0.82)\n\telseif unitName == \"Tein\" then\n\t\tprofile.kind = \"Tein\"\n\t\tprofile.releaseAt, profile.duration = 0.50, 0.93\n\t\tprofile.cooldown, profile.beamDuration = math.max(speed, 1.05), 0.18\n\telseif unitName == \"Bluma\" then\n\t\tprofile.kind = \"Bluma\"\n\t\tprofile.releaseAt, profile.duration = 0.30, 0.62\n\t\tprofile.cooldown, profile.beamDuration = math.max(speed, 0.72), 0.12\n\tend\n\treturn profile\nend\n\nreturn AttackTimeline\r\n","AttackAnimator":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\r\nlocal MatchClock = require(ReplicatedStorage:WaitForChild(\"MatchClock\"))\r\nlocal AttackTimeline = require(ReplicatedStorage:WaitForChild(\"AttackTimeline\"))\r\nlocal RunService = game:GetService(\"RunService\")\r\nlocal AttackAnimator = {}\r\nlocal states = {}\r\nlocal connection\r\n\r\nlocal function ease(t)\r\n\tt = math.clamp(t, 0, 1)\r\n\treturn t * t * t * (t * (t * 6 - 15) + 10)\r\nend\r\n\r\nlocal function rotation(x, y, z)\r\n\treturn CFrame.Angles(math.rad(x or 0), math.rad(y or 0), math.rad(z or 0))\r\nend\r\n\r\nlocal function body(r15, y, z, pitch, yaw, roll, joints)\r\n\tlocal pose = joints or {}\r\n\tlocal root = CFrame.new(0, y or 0, z or 0) * rotation(pitch, r15 and (yaw or 0) * 0.45 or yaw, roll)\r\n\tpose.Root, pose.RootJoint = root, root\r\n\tif r15 then pose.Waist = rotation((pitch or 0) * 0.35, (yaw or 0) * 0.55, (roll or 0) * 0.35) end\r\n\treturn pose\r\nend\r\n\r\nlocal function r6Palm(side, target, offset)\r\n\tlocal lever = Vector3.new(side * 0.5, -1.5, 0).Unit\r\n\tlocal shoulder = Vector3.new(side, 0.5, 0) + offset\r\n\tlocal direction = (target - shoulder).Unit\r\n\tlocal axis = lever:Cross(direction)\r\n\tlocal turn = CFrame.identity\r\n\tif axis.Magnitude > 0.00001 then\r\n\t\tturn = CFrame.fromAxisAngle(axis.Unit, math.acos(math.clamp(lever:Dot(direction), -1, 1)))\r\n\tend\r\n\treturn CFrame.new(offset) * turn\r\nend\r\n\r\nlocal function chargeArms(r15)\r\n\tif r15 then\r\n\t\treturn {\r\n\t\t\tLeftShoulder = rotation(38, -14, 38), LeftElbow = rotation(95, 0, 0),\r\n\t\t\tLeftWrist = rotation(-15, -20, -15),\r\n\t\t\tRightShoulder = rotation(-18, 8, -8), RightElbow = rotation(115, 0, 0),\r\n\t\t\tRightWrist = rotation(10, 20, 18),\r\n\t\t}\r\n\tend\r\n\treturn {\r\n\t\tLeftShoulder = r6Palm(-1, Vector3.new(0.22, -0.23, -0.90), Vector3.new(0.18, -0.15, 0.10)),\r\n\t\tRightShoulder = r6Palm(1, Vector3.new(0.59, -0.38, -0.97), Vector3.new(-0.10, 0.12, 0.05)),\r\n\t}\r\nend\r\n\r\nlocal function blastArms(r15, pitch)\r\n\tif not r15 then\r\n\t\tlocal angle = math.rad((pitch or 90) - 90)\r\n\t\tlocal height, reach = 0.4 + math.sin(angle) * 1.38, -math.cos(angle) * 1.38\r\n\t\treturn {\r\n\t\t\tLeftShoulder = r6Palm(-1, Vector3.new(-0.20, height, reach), Vector3.new(0.08, 0, 0)),\r\n\t\t\tRightShoulder = r6Palm(1, Vector3.new(0.20, height, reach), Vector3.new(-0.08, 0, 0)),\r\n\t\t}\r\n\tend\r\n\treturn {\r\n\t\tLeftShoulder = CFrame.new(r15 and 0.04 or 0.12, 0, 0) * rotation(pitch or 90, 0, 9),\r\n\t\tRightShoulder = CFrame.new(r15 and -0.04 or -0.12, 0, 0) * rotation(pitch or 90, 0, -9),\r\n\t\tLeftElbow = rotation(6, 0, 0), RightElbow = rotation(6, 0, 0),\r\n\t\tLeftWrist = rotation(0, -8, 0), RightWrist = rotation(0, 8, 0),\r\n\t}\r\nend\r\n\r\nlocal function lifted(pose, r15, fold)\r\n\tpose.LeftHip = rotation(fold or 28, -5, -12)\r\n\tpose.RightHip = rotation((fold or 28) - 12, 6, 12)\r\n\tif r15 then\r\n\t\tpose.LeftKnee, pose.RightKnee = rotation(-62, 0, 0), rotation(-48, 0, 0)\r\n\t\tpose.LeftAnkle, pose.RightAnkle = rotation(18, 0, 0), rotation(14, 0, 0)\r\n\tend\r\n\treturn pose\r\nend\r\n\r\nlocal function frame(time, phase, pose)\r\n\treturn {time = time, phase = phase, pose = pose or {}}\r\nend\r\n\r\nlocal function makeFrames(kind, r15)\r\n\tif kind == \"Roshi\" then\r\n\t\tlocal crouch = body(r15, -0.32, 0, 12, -8, 0, {\r\n\t\t\tLeftShoulder = rotation(-20, 0, -12), RightShoulder = rotation(-26, 0, 12),\r\n\t\t\tLeftHip = rotation(-26, 0, -14), RightHip = rotation(-26, 0, 14),\r\n\t\t\tLeftKnee = rotation(-38, 0, 0), RightKnee = rotation(-38, 0, 0),\r\n\t\t})\r\n\t\tlocal ascent = lifted(body(r15, 1.95, 0.06, -7, -18, -2, chargeArms(r15)), r15, 46)\r\n\t\tlocal charge = lifted(body(r15, 2.80, 0.05, -4, -28, -3, chargeArms(r15)), r15, 30)\r\n\t\tcharge.Neck = rotation(3, 24, 2)\r\n\t\tlocal gather = lifted(body(r15, 2.80, 0.07, -6, -32, -3, chargeArms(r15)), r15, 30)\r\n\t\tgather.Neck = rotation(4, 27, 1)\r\n\t\tlocal ready = lifted(body(r15, 2.78, 0.06, -5, -30, -2, chargeArms(r15)), r15, 29)\r\n\t\tready.Neck = rotation(3, 25, 1)\r\n\t\tlocal fire = lifted(body(r15, 2.72, 0.10, 2, 2, 0, blastArms(r15, 91)), r15, 26)\r\n\t\tlocal recoil = lifted(body(r15, 2.63, 0.24, -9, -2, 0, blastArms(r15, 98)), r15, 32)\r\n\t\tlocal hold = lifted(body(r15, 2.48, 0.18, -5, 0, 0, blastArms(r15, 95)), r15, 24)\r\n\t\tlocal descend = body(r15, 1.03, 0.08, 5, 0, 0, {\r\n\t\t\tLeftShoulder = rotation(32, 0, -14), RightShoulder = rotation(32, 0, 14),\r\n\t\t\tLeftHip = rotation(-8, 0, -10), RightHip = rotation(-8, 0, 10),\r\n\t\t\tLeftKnee = rotation(-24, 0, 0), RightKnee = rotation(-24, 0, 0),\r\n\t\t})\r\n\t\tlocal landing = body(r15, -0.24, 0, 10, 0, 0, {\r\n\t\t\tLeftShoulder = rotation(15, 0, -22), RightShoulder = rotation(15, 0, 22),\r\n\t\t\tLeftHip = rotation(-20, 0, -12), RightHip = rotation(-20, 0, 12),\r\n\t\t\tLeftKnee = rotation(-34, 0, 0), RightKnee = rotation(-34, 0, 0),\r\n\t\t})\r\n\t\treturn {\r\n\t\t\tframe(0, \"Windup\"), frame(0.16, \"Takeoff\", crouch),\r\n\t\t\tframe(0.42, \"Jump\", ascent), frame(0.68, \"Charge\", charge),\r\n\t\t\tframe(1.05, \"Charge\", gather), frame(1.25, \"Charge\", ready),\r\n\t\t\tframe(1.35, \"Release\", fire), frame(1.46, \"Fire\", recoil),\r\n\t\t\tframe(1.73, \"Fire\", hold), frame(1.96, \"Landing\", descend),\r\n\t\t\tframe(2.09, \"Landing\", landing), frame(2.25, \"Idle\"),\r\n\t\t}\r\n\telseif kind == \"Melee\" then\r\n\t\tlocal pull = body(r15, -0.04, 0.03, -3, -18, 1, {\r\n\t\t\tRightShoulder = rotation(-35, -12, 12), RightElbow = rotation(95, 0, 0),\r\n\t\t\tLeftShoulder = rotation(r15 and 34 or 62, 0, -16), LeftElbow = rotation(90, 0, 0),\r\n\t\t\tNeck = rotation(0, 14, 0),\r\n\t\t})\r\n\t\tlocal strike = body(r15, -0.07, -0.18, 8, 20, 0, {\r\n\t\t\tRightShoulder = rotation(96, -4, -5), RightElbow = rotation(4, 0, 0),\r\n\t\t\tLeftShoulder = rotation(28, 0, -15), LeftElbow = rotation(95, 0, 0),\r\n\t\t\tNeck = rotation(-3, -14, 0), LeftHip = rotation(-10, 0, 0), RightHip = rotation(13, 0, 0),\r\n\t\t})\r\n\t\treturn {\r\n\t\t\tframe(0, \"Windup\"), frame(0.13, \"Windup\", pull),\r\n\t\t\tframe(0.22, \"Release\", strike), frame(0.29, \"Recovery\", strike), frame(0.50, \"Idle\"),\r\n\t\t}\r\n\telseif kind == \"Pikkolo\" then\r\n\t\tlocal gather = body(r15, -0.04, 0.02, -3, -17, 0, {\r\n\t\t\tRightShoulder = rotation(r15 and 108 or 138, 8, -14),\r\n\t\t\tRightElbow = rotation(r15 and 65 or 0, 0, 0), RightWrist = rotation(-15, 0, 0),\r\n\t\t\tLeftShoulder = rotation(-10, 0, -12), Neck = rotation(0, 14, 0),\r\n\t\t})\r\n\t\tlocal fire = body(r15, -0.03, -0.04, 3, 8, 0, {\r\n\t\t\tRightShoulder = rotation(94, 0, -5), RightElbow = rotation(6, 0, 0),\r\n\t\t\tLeftShoulder = rotation(-12, 0, -16), Neck = rotation(-1, -7, 0),\r\n\t\t})\r\n\t\treturn {\r\n\t\t\tframe(0, \"Windup\"), frame(0.16, \"Charge\", gather), frame(0.28, \"Charge\", gather),\r\n\t\t\tframe(0.38, \"Release\", fire), frame(0.54, \"Recovery\", fire), frame(0.73, \"Idle\"),\r\n\t\t}\r\n\telseif kind == \"Tein\" then\r\n\t\tlocal gather = body(r15, -0.10, 0.02, -3, 0, 0, {\r\n\t\t\tLeftShoulder = rotation(r15 and 62 or 109, 0, 27),\r\n\t\t\tRightShoulder = rotation(r15 and 62 or 109, 0, -27),\r\n\t\t\tLeftElbow = rotation(66, 0, 0), RightElbow = rotation(66, 0, 0),\r\n\t\t\tLeftWrist = rotation(0, -22, -15), RightWrist = rotation(0, 22, 15),\r\n\t\t\tLeftHip = rotation(-10, 0, -10), RightHip = rotation(-10, 0, 10),\r\n\t\t})\r\n\t\tlocal fire = body(r15, -0.04, 0.04, -4, 0, 0, blastArms(r15, 100))\r\n\t\treturn {\r\n\t\t\tframe(0, \"Windup\"), frame(0.21, \"Charge\", gather), frame(0.39, \"Charge\", gather),\r\n\t\t\tframe(0.50, \"Release\", fire), frame(0.68, \"Recovery\", fire), frame(0.93, \"Idle\"),\r\n\t\t}\r\n\telseif kind == \"Bluma\" then\r\n\t\tlocal aim = body(r15, -0.02, 0, 0, -8, 0, {\r\n\t\t\tRightShoulder = rotation(77, 0, -5), RightElbow = rotation(22, 0, 0),\r\n\t\t\tLeftShoulder = rotation(59, 8, 26), LeftElbow = rotation(60, 0, 0),\r\n\t\t\tNeck = rotation(0, 8, 0),\r\n\t\t})\r\n\t\tlocal fire = body(r15, -0.02, 0, 0, -3, 0, {\r\n\t\t\tRightShoulder = rotation(91, 0, -5), RightElbow = rotation(8, 0, 0),\r\n\t\t\tLeftShoulder = rotation(66, 4, 23), LeftElbow = rotation(48, 0, 0),\r\n\t\t})\r\n\t\tlocal recoil = body(r15, -0.02, 0.06, -4, -4, 0, {\r\n\t\t\tRightShoulder = rotation(106, 0, -5), RightElbow = rotation(18, 0, 0),\r\n\t\t\tLeftShoulder = rotation(76, 4, 23), LeftElbow = rotation(54, 0, 0),\r\n\t\t})\r\n\t\treturn {\r\n\t\t\tframe(0, \"Windup\"), frame(0.17, \"Aim\", aim), frame(0.30, \"Release\", fire),\r\n\t\t\tframe(0.36, \"Recoil\", recoil), frame(0.43, \"Recovery\", fire), frame(0.62, \"Idle\"),\r\n\t\t}\r\n\tend\r\n\tlocal pull = body(r15, -0.03, 0.03, -4, -20, 0, {\r\n\t\tRightShoulder = rotation(-28, -12, 14), RightElbow = rotation(104, 0, 0),\r\n\t\tRightWrist = rotation(-12, 0, 0),\r\n\t\tLeftShoulder = rotation(r15 and 22 or 42, 0, -18), LeftElbow = rotation(82, 0, 0),\r\n\t\tNeck = rotation(0, 16, 0),\r\n\t})\r\n\tlocal fire = body(r15, -0.04, -0.04, 4, 11, 0, {\r\n\t\tRightShoulder = rotation(93, -3, -6), RightElbow = rotation(5, 0, 0),\r\n\t\tLeftShoulder = rotation(4, 0, -16), LeftElbow = rotation(42, 0, 0),\r\n\t\tNeck = rotation(-2, -9, 0),\r\n\t})\r\n\tlocal recoil = body(r15, -0.04, 0.07, -4, 6, 0, {\r\n\t\tRightShoulder = rotation(101, -3, -6), RightElbow = rotation(11, 0, 0),\r\n\t\tLeftShoulder = rotation(2, 0, -16), LeftElbow = rotation(42, 0, 0),\r\n\t\tNeck = rotation(1, -6, 0),\r\n\t})\r\n\treturn {\r\n\t\tframe(0, \"Windup\"), frame(0.19, \"Charge\", pull), frame(0.35, \"Charge\", pull),\r\n\t\tframe(0.46, \"Release\", fire), frame(0.53, \"Recoil\", recoil),\r\n\t\tframe(0.62, \"Recovery\", fire), frame(0.89, \"Idle\"),\r\n\t}\r\nend\r\n\r\nlocal frameSets = {}\r\nfor _, kind in ipairs({\"Roshi\", \"Melee\", \"Pikkolo\", \"Tein\", \"Bluma\", \"Ranged\"}) do\r\n\tframeSets[kind] = {R6 = makeFrames(kind, false), R15 = makeFrames(kind, true)}\r\nend\r\n\r\nfunction AttackAnimator.sample(profile, elapsed, r15)\r\n\tlocal set = frameSets[profile.kind] or frameSets.Ranged\r\n\tlocal frames = set[r15 and \"R15\" or \"R6\"]\r\n\tlocal age = math.max(0, tonumber(elapsed) or 0)\r\n\tif age >= frames[#frames].time then return {}, \"Idle\" end\r\n\tfor index = 2, #frames do\r\n\t\tlocal a, b = frames[index - 1], frames[index]\r\n\t\tif age <= b.time then\r\n\t\t\tlocal alpha = ease((age - a.time) / (b.time - a.time))\r\n\t\t\tlocal pose = {}\r\n\t\t\tfor name, value in pairs(a.pose) do\r\n\t\t\t\tpose[name] = value:Lerp(b.pose[name] or CFrame.identity, alpha)\r\n\t\t\tend\r\n\t\t\tfor name, value in pairs(b.pose) do\r\n\t\t\t\tif not pose[name] then pose[name] = CFrame.identity:Lerp(value, alpha) end\r\n\t\t\tend\r\n\t\t\treturn pose, age == b.time and b.phase or a.phase\r\n\t\tend\r\n\tend\r\n\treturn {}, \"Idle\"\r\nend\r\n\r\nlocal function walkingPose(state, now)\r\n\tlocal swing = math.sin((now - state.walkEpoch) * 11) * 0.40 * state.walkWeight\r\n\treturn {\r\n\t\tRightHip = CFrame.Angles(swing, 0, 0), LeftHip = CFrame.Angles(-swing, 0, 0),\r\n\t\tLeftShoulder = CFrame.Angles(swing * 0.75, 0, 0), RightShoulder = CFrame.Angles(-swing * 0.75, 0, 0),\r\n\t}\r\nend\r\n\r\nlocal function apply(state, now, elapsed)\r\n\tlocal pose, phase\r\n\tlocal attack = state.attack\r\n\tif attack then\r\n\t\tlocal age = elapsed or math.max(0, now - attack.startedAt)\r\n\t\tpose, phase = AttackAnimator.sample(attack.profile, age, state.r15)\r\n\t\tif age >= attack.profile.duration then\r\n\t\t\tstate.attack = nil\r\n\t\telse\r\n\t\t\tlocal blend = ease(age / 0.10)\r\n\t\t\tif blend < 1 then\r\n\t\t\t\tfor name, origin in pairs(attack.from) do\r\n\t\t\t\t\tpose[name] = origin:Lerp(pose[name] or CFrame.identity, blend)\r\n\t\t\t\tend\r\n\t\t\tend\r\n\t\tend\r\n\telse\r\n\t\tpose, phase = walkingPose(state, now), \"Idle\"\r\n\tend\r\n\tfor _, entry in ipairs(state.joints) do\r\n\t\tif entry.joint.Parent then\r\n\t\t\tlocal offset = pose[entry.name] or CFrame.identity\r\n\t\t\tentry.current = offset\r\n\t\t\t-- Pose translations and rotations use Part0's body axes, including R6's rotated rest joints.\r\n\t\t\tentry.joint.C0 = entry.position * offset * entry.rotation\r\n\t\t\tentry.joint.Transform = CFrame.identity\r\n\t\tend\r\n\tend\r\n\treturn phase\r\nend\r\n\r\nlocal function update()\r\n\tlocal paused = MatchClock.isPaused()\r\n\tlocal now = MatchClock.now()\r\n\tfor model, state in pairs(states) do\r\n\t\tif not model.Parent then\r\n\t\t\tAttackAnimator.stop(model)\r\n\t\telseif paused then\r\n\t\t\t-- Animator tracks still evaluate while MatchClock is paused.\r\n\t\t\tfor _, entry in ipairs(state.joints) do\r\n\t\t\t\tif entry.joint.Parent then entry.joint.Transform = CFrame.identity end\r\n\t\t\tend\r\n\t\telse\r\n\t\t\tlocal dt = math.max(0, now - state.updatedAt)\r\n\t\t\tstate.updatedAt = now\r\n\t\t\tlocal target = state.walking and not state.attack and 1 or 0\r\n\t\t\tstate.walkWeight += (target - state.walkWeight) * (1 - math.exp(-12 * dt))\r\n\t\t\tapply(state, now)\r\n\t\tend\r\n\tend\r\nend\r\n\r\nlocal function getState(model)\r\n\tif states[model] then return states[model] end\r\n\tlocal now = MatchClock.now()\r\n\tlocal state = {\r\n\t\tmodel = model, r15 = model:FindFirstChild(\"UpperTorso\") ~= nil,\r\n\t\tjoints = {}, walking = false, walkWeight = 0, walkEpoch = now, updatedAt = now,\r\n\t}\r\n\tfor _, joint in ipairs(model:GetDescendants()) do\r\n\t\tif joint:IsA(\"Motor6D\") and joint.Part0 and joint.Part1 then\r\n\t\t\tlocal name = joint.Name:gsub(\" \", \"\")\r\n\t\t\tif joint.Part0.Name == \"HumanoidRootPart\" then name = state.r15 and \"Root\" or \"RootJoint\" end\r\n\t\t\ttable.insert(state.joints, {\r\n\t\t\t\tjoint = joint, name = name, original = joint.C0, originalTransform = joint.Transform,\r\n\t\t\t\tposition = CFrame.new(joint.C0.Position), rotation = joint.C0.Rotation,\r\n\t\t\t\tcurrent = CFrame.identity,\r\n\t\t\t})\r\n\t\tend\r\n\tend\r\n\tstates[model] = state\r\n\tstate.destroying = model.Destroying:Connect(function() AttackAnimator.stop(model) end)\r\n\treturn state\r\nend\r\n\r\nlocal function start()\r\n\tif not connection then connection = RunService.PreSimulation:Connect(update) end\r\nend\r\n\r\nfunction AttackAnimator.setWalking(model, walking)\r\n\tgetState(model).walking = walking == true\r\n\tstart()\r\nend\r\n\r\nfunction AttackAnimator.play(model, unitName, profile, startedAt)\r\n\tlocal state = getState(model)\r\n\tlocal now = MatchClock.now()\r\n\tif state.attack and now - state.attack.startedAt < state.attack.profile.duration then return false end\r\n\tprofile = profile or AttackTimeline.get(unitName, nil, nil)\r\n\tlocal from = {}\r\n\tfor _, entry in ipairs(state.joints) do from[entry.name] = entry.current end\r\n\tstate.attack = {profile = profile, startedAt = startedAt or now, from = from}\r\n\tstate.walking = false\r\n\tstart()\r\n\tapply(state, now)\r\n\treturn true\r\nend\r\n\r\nfunction AttackAnimator.poseNow(model, elapsed)\r\n\tlocal state = states[model]\r\n\tif not state then return false end\r\n\tif MatchClock.isPaused() then return false end\r\n\treturn true, apply(state, MatchClock.now(), elapsed)\r\nend\r\n\r\nfunction AttackAnimator.stop(model)\r\n\tlocal state = states[model]\r\n\tif not state then return end\r\n\tstates[model] = nil\r\n\tif state.destroying then state.destroying:Disconnect() end\r\n\tfor _, entry in ipairs(state.joints) do\r\n\t\tif entry.joint.Parent then\r\n\t\t\tentry.joint.C0 = entry.original\r\n\t\t\tentry.joint.Transform = entry.originalTransform\r\n\t\tend\r\n\tend\r\n\tif not next(states) and connection then\r\n\t\tconnection:Disconnect()\r\n\t\tconnection = nil\r\n\tend\r\nend\r\n\r\nfunction AttackAnimator.stopAll()\r\n\tlocal models = {}\r\n\tfor model in pairs(states) do table.insert(models, model) end\r\n\tfor _, model in ipairs(models) do AttackAnimator.stop(model) end\r\nend\r\n\r\nreturn AttackAnimator\r\n\r\n","UnitData":"export type Range = {\n\tcategory: string,\n\tvalue: number,\n}\n\nexport type Unit = {\n\tid: string,\n\tname: string,\n\trarity: string,\n\ttype: string,\n\tmobile: boolean,\n\tlines: { string },\n\thealth: number,\n\tdamage: number,\n\trange: Range,\n\thitSpeed: number,\n\tdamagePattern: string,\n\tability: string?,\n\tmodel: string,\n}\n\nlocal Units: { [string]: Unit } = {\n\tYumcha = {\n\t\tid = \"Yumcha\",\n\t\tname = \"Yumcha\",\n\t\trarity = \"Common\",\n\t\ttype = \"Melee\",\n\t\tmobile = true,\n\t\tlines = { \"front\" },\n\t\thealth = 126,\n\t\tdamage = 13,\n\t\trange = { category = \"Short\", value = 1 },\n\t\thitSpeed = 0.60,\n\t\tdamagePattern = \"Single\",\n\t\tability = nil,\n\t\tmodel = \"Yumcha\",\n\t},\n\n\tGoku = {\n\t\tid = \"Goku\",\n\t\tname = \"Goku\",\n\t\trarity = \"Common\",\n\t\ttype = \"Ranged\",\n\t\tmobile = false,\n\t\tlines = { \"back\" },\n\t\thealth = 152,\n\t\tdamage = 26,\n\t\trange = { category = \"Long\", value = 4 },\n\t\thitSpeed = 1.05,\n\t\tdamagePattern = \"Single\",\n\t\tability = nil,\n\t\tmodel = \"Guku\",\n\t},\n\n\tKrillen = {\n\t\tid = \"Krillen\",\n\t\tname = \"Krillen\",\n\t\trarity = \"Common\",\n\t\ttype = \"Melee\",\n\t\tmobile = true,\n\t\tlines = { \"front\" },\n\t\thealth = 67,\n\t\tdamage = 13,\n\t\trange = { category = \"Short\", value = 1 },\n\t\thitSpeed = 0.60,\n\t\tdamagePattern = \"Single\",\n\t\tability = nil,\n\t\tmodel = \"Krillen\",\n\t},\n\n\tTein = {\n\t\tid = \"Tein\",\n\t\tname = \"Tein\",\n\t\trarity = \"Common\",\n\t\ttype = \"Energy\",\n\t\tmobile = true,\n\t\tlines = { \"mid\" },\n\t\thealth = 93,\n\t\tdamage = 100,\n\t\trange = { category = \"Short\", value = 2 },\n\t\thitSpeed = 1.05,\n\t\tdamagePattern = \"AoE\",\n\t\tability = nil,\n\t\tmodel = \"Tein\",\n\t},\n\n\tMasterRoshu = {\n\t\tid = \"MasterRoshu\",\n\t\tname = \"Master Roshu\",\n\t\trarity = \"Common\",\n\t\ttype = \"Tank\",\n\t\tmobile = false,\n\t\tlines = { \"back\" },\n\n\t\thealth = 190,\n\t\tdamage = 133,\n\t\trange = { category = \"Long\", value = 5 },\n\t\thitSpeed = 5.3,\n\t\tdamagePattern = \"Blast Single\",\n\t\tability = nil,\n\t\tmodel = \"Master Roshu\",\n\t},\n\n\tBluma = {\n\t\tid = \"Bluma\",\n\t\tname = \"Bluma\",\n\t\trarity = \"Common\",\n\t\ttype = \"Artillery\",\n\t\tmobile = true,\n\t\tlines = { \"front\" },\n\t\thealth = 79,\n\t\tdamage = 18,\n\t\trange = { category = \"Short\", value = 1 },\n\t\thitSpeed = 0.72,\n\t\tdamagePattern = \"Artillery Single\",\n\t\tability = nil,\n\t\tmodel = \"Bluma\",\n\n\t\tunlockable = true,\n\t\tunlockArena = \"Tenkaichi\",\n\t\tunlockPoints = 40,\n\t},\n\n\tPikkolo = {\n\t\tid = \"Pikkolo\",\n\t\tname = \"Pikkolo\",\n\t\trarity = \"Rare\",\n\t\ttype = \"Energy\",\n\t\tmobile = true,\n\t\tlines = { \"mid\" },\n\t\thealth = 161,\n\t\tdamage = 24,\n\t\trange = { category = \"Short\", value = 1 },\n\t\thitSpeed = 0.82,\n\t\tdamagePattern = \"Blast Single\",\n\t\tability = \"Nameekian Split\",\n\n\t\tmodel = \"Pikkolo\",\n\t\tunlockable = true,\n\t\tunlockArena = \"Tenkaichi\",\n\t\tunlockPoints = 100,\n\t},\n}\n\nlocal UnitData = {}\nUnitData.Units = Units\n\nfunction UnitData.get(id: string): Unit?\n\treturn Units[id]\nend\n\nfunction UnitData.all(): { [string]: Unit }\n\treturn Units\nend\n\nreturn UnitData\n\n\n","CombatController":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal Debris = game:GetService(\"Debris\")\nlocal MatchClock = require(ReplicatedStorage:WaitForChild(\"MatchClock\"))\nlocal MatchSettings = require(ReplicatedStorage:WaitForChild(\"MatchSettings\"))\nlocal UnitData = require(ReplicatedStorage.UnitData)\nlocal ArenaConfig = require(ReplicatedStorage.ArenaConfig)\nlocal PlayerData = require(ReplicatedStorage.PlayerData)\nlocal AttackAnimator = require(ReplicatedStorage.AttackAnimator)\nlocal AttackTimeline = require(ReplicatedStorage:WaitForChild(\"AttackTimeline\"))\nlocal CombatController = {}\nlocal active\nlocal ranges = {7, 14, 22, 32, 44}\nlocal colors = {\n    [\"Master Roshu\"] = Color3.fromRGB(65, 165, 255),\n    Goku = Color3.fromRGB(255, 210, 70),\n    Pikkolo = Color3.fromRGB(170, 85, 255),\n    Tein = Color3.fromRGB(255, 155, 65),\n}\n\nlocal function position(unit)\n    return unit.simPivot.Position\nend\n\nlocal function flatDistance(a, b)\n    local delta = position(a) - position(b)\n    return Vector2.new(delta.X, delta.Z).Magnitude\nend\n\nlocal function makeUnit(model)\n    local id = model:GetAttribute(\"UnitId\")\n    local data = UnitData.get(id)\n    if not data or not model.PrimaryPart then return nil end\n    local side = model:GetAttribute(\"Side\")\n    local health, damage = data.health, data.damage\n    if side == \"player\" then health, damage = PlayerData.unitStats(id, health, damage) end\n    model:SetAttribute(\"Health\", health)\n    model:SetAttribute(\"MaxHealth\", health)\n    local humanoid = model:FindFirstChildOfClass(\"Humanoid\")\n    if humanoid then humanoid.MaxHealth = health humanoid.Health = health end\n    local joints = {}\n    for _, joint in ipairs(model:GetDescendants()) do\n        if joint:IsA(\"Motor6D\") and joint.Part0 and joint.Part1 then joints[joint.Part1] = joint end\n    end\n    local profile = AttackTimeline.get(data.name, data.type, data.hitSpeed)\n    model:SetAttribute(\"AttackCooldown\", profile.cooldown)\n    return {\n        model = model, data = data, side = side, hp = health, maxHp = health,\n        simPivot = model:GetPivot(), visualFrom = model:GetPivot(), visualTarget = model:GetPivot(),\n        visualStarted = MatchClock.now(), visualDuration = .1,\n        damage = damage, nextAttackAt = MatchClock.now() + .2,\n        profile = profile, joints = joints, range = ranges[data.range.value] or 7,\n    }\nend\n\nlocal function alive(unit)\n    return unit.hp > 0 and unit.model.Parent ~= nil\nend\n\nlocal function nearestEnemy(unit, units)\n    local nearest, distance = nil, math.huge\n    if unit.target and alive(unit.target) then\n        local current = flatDistance(unit, unit.target)\n        if current <= unit.range then return unit.target, current end\n    end\n    for _, enemy in ipairs(units) do\n        if enemy.side ~= unit.side and alive(enemy) then\n            local current = flatDistance(unit, enemy)\n            if current < distance then nearest, distance = enemy, current end\n        end\n    end\n    return nearest, distance\nend\n\nlocal function effectPart(folder, color, name)\n    local part = Instance.new(\"Part\")\n    part.Name = name\n    part.Anchored = true\n    part.CanCollide = false\n    part.CanTouch = false\n    part.CanQuery = false\n    part.CastShadow = false\n    part.Material = Enum.Material.Neon\n    part.Color = color\n    part.Transparency = 1\n    part.Parent = folder\n    return part\nend\n\nlocal function colorFor(unit)\n    return colors[unit.data.name] or Color3.fromRGB(255, 190, 100)\nend\n\nlocal function posedFrame(unit, part, visited)\n    local joint = unit.joints[part]\n    if not joint or not joint.Parent or not joint.Part0 then return part.CFrame end\n    visited = visited or {}\n    if visited[part] then return part.CFrame end\n    visited[part] = true\n    return posedFrame(unit, joint.Part0, visited) * joint.C0 * joint.Transform * joint.C1:Inverse()\nend\n\nlocal function palm(unit, right)\n    local model = unit.model\n    local part = model:FindFirstChild(right and \"RightHand\" or \"LeftHand\")\n        or model:FindFirstChild(right and \"Right Arm\" or \"Left Arm\") or model.PrimaryPart\n    if not part then return model:GetPivot().Position end\n    return posedFrame(unit, part):PointToWorldSpace(Vector3.new(0, -part.Size.Y * .4, -.08))\nend\n\nlocal function emissionPoint(unit)\n    local right = palm(unit, true)\n    if unit.profile.kind == \"Roshi\" or unit.data.name == \"Tein\" then\n        return (right + palm(unit, false)) / 2\n    end\n    return right\nend\n\nlocal function bodyPoint(unit)\n    local body = unit.model:FindFirstChild(\"UpperTorso\") or unit.model:FindFirstChild(\"Torso\") or unit.model.PrimaryPart\n    return body and posedFrame(unit, body).Position or position(unit)\nend\n\nlocal function clearCharge(attack)\n    if attack.charge then\n        for _, part in ipairs(attack.charge) do part:Destroy() end\n        attack.charge = nil\n    end\nend\n\nlocal function beginAttack(session, unit, target, now)\n    local profile = unit.profile\n    local attack = {target = target, started = now, released = false}\n    unit.attack = attack\n    unit.nextAttackAt = now + profile.cooldown\n    AttackAnimator.setWalking(unit.model, false)\n    AttackAnimator.play(unit.model, unit.data.name, profile, now)\n    if unit.data.type ~= \"Melee\" and MatchSettings.effectsEnabled() then\n        attack.charge = {\n            effectPart(session.effects, colorFor(unit), \"ChargeGlow\"),\n            effectPart(session.effects, Color3.new(1, 1, 1), \"ChargeCore\"),\n        }\n        for _, part in ipairs(attack.charge) do part.Shape = Enum.PartType.Ball end\n    end\nend\n\nlocal function releaseEffect(session, unit, target, now)\n    if not MatchSettings.effectsEnabled() then return end\n    local color = colorFor(unit)\n    local hit = effectPart(session.effects, color, \"Impact\")\n    hit.Shape = Enum.PartType.Ball\n    local shot = {\n        unit = unit, target = target, started = now,\n        duration = math.max(.22, unit.profile.beamDuration),\n        finish = bodyPoint(target), impact = hit,\n    }\n    if unit.data.type ~= \"Melee\" then\n        shot.beams = {\n            effectPart(session.effects, color, \"EnergyGlow\"),\n            effectPart(session.effects, Color3.new(1, 1, 1), \"EnergyCore\"),\n        }\n        for _, beam in ipairs(shot.beams) do beam.Shape = Enum.PartType.Cylinder end\n    end\n    table.insert(session.shots, shot)\nend\n\nlocal function defeat(unit)\n    if unit.attack then clearCharge(unit.attack); unit.attack = nil end\n    AttackAnimator.stop(unit.model)\n    unit.model:SetAttribute(\"Defeated\", true)\n    for _, part in ipairs(unit.model:GetDescendants()) do\n        if part:IsA(\"BasePart\") then\n            TweenService:Create(part, TweenInfo.new(.4), {Transparency = 1}):Play()\n        end\n    end\n    Debris:AddItem(unit.model, .45)\nend\n\nlocal function applyDamage(damage)\n    for unit, amount in pairs(damage) do\n        unit.hp = math.max(0, unit.hp - amount)\n        unit.model:SetAttribute(\"Health\", unit.hp)\n        local humanoid = unit.model:FindFirstChildOfClass(\"Humanoid\")\n        if humanoid then humanoid.Health = math.max(.01, unit.hp) end\n        if unit.hp == 0 then defeat(unit) end\n    end\nend\n\nlocal function updateAttacks(session, now)\n    local damage = {}\n    for _, unit in ipairs(session.units) do\n        local attack = unit.attack\n        if attack then\n            if not alive(unit) then\n                clearCharge(attack)\n                unit.attack = nil\n            else\n                local age = now - attack.started\n                if not attack.released and age >= unit.profile.releaseAt then\n                    attack.released = true\n                    clearCharge(attack)\n                    AttackAnimator.poseNow(unit.model, age)\n                    if alive(attack.target) and flatDistance(unit, attack.target) <= unit.range + .75 then\n                        releaseEffect(session, unit, attack.target, now)\n                        damage[attack.target] = (damage[attack.target] or 0) + unit.damage\n                        session.attacks += 1\n                    end\n                end\n                if age >= unit.profile.duration then\n                    clearCharge(attack)\n                    unit.attack = nil\n                end\n            end\n        end\n    end\n    applyDamage(damage)\n    session.arena:SetAttribute(\"CombatAttacks\", session.attacks)\nend\n\nlocal function stepCombat(session, dt, now)\n    for _, unit in ipairs(session.units) do\n        if alive(unit) then\n            if unit.attack then\n                AttackAnimator.setWalking(unit.model, false)\n            else\n                local target, distance = nearestEnemy(unit, session.units)\n                unit.target = target\n                if target then\n                    local point = position(unit)\n                    local direction = position(target) - point\n                    direction = Vector3.new(direction.X, 0, direction.Z)\n                    local moving = distance > unit.range\n                    if moving and direction.Magnitude > .01 then\n                        local speed = unit.data.mobile and 14 or 4.9\n                        point = ArenaConfig.clampPosition(point + direction.Unit * math.min(speed * dt, distance - unit.range + .05))\n                    end\n                    if direction.Magnitude > .01 then\n                        unit.simPivot = CFrame.lookAt(point, point + direction)\n                        unit.visualFrom = unit.model:GetPivot()\n                        unit.visualTarget = unit.simPivot\n                        unit.visualStarted = now\n                        unit.visualDuration = dt\n                    end\n                    AttackAnimator.setWalking(unit.model, moving)\n                    if not moving and now >= unit.nextAttackAt then beginAttack(session, unit, target, now) end\n                else\n                    AttackAnimator.setWalking(unit.model, false)\n                end\n            end\n        end\n    end\nend\n\nlocal function renderEffects(session, now)\n    local enabled = MatchSettings.effectsEnabled()\n    for _, unit in ipairs(session.units) do\n        local attack = unit.attack\n        if attack and attack.charge then\n            local age = now - attack.started\n            local chargeStart = unit.profile.kind == \"Roshi\" and .48 or 0\n            local progress = math.clamp((age - chargeStart) / math.max(.01, unit.profile.releaseAt - chargeStart), 0, 1)\n            local size = .14 + progress * (unit.profile.kind == \"Roshi\" and 1.15 or .6)\n            local point = emissionPoint(unit)\n            for i, part in ipairs(attack.charge) do\n                part.Position = point\n                part.Size = Vector3.one * size * (i == 1 and 1.65 or .7)\n                part.Transparency = enabled and age >= chargeStart and (i == 1 and .6 - .22 * progress or .2) or 1\n            end\n        end\n    end\n    for index = #session.shots, 1, -1 do\n        local shot = session.shots[index]\n        local age = now - shot.started\n        if age >= shot.duration then\n            shot.impact:Destroy()\n            if shot.beams then for _, beam in ipairs(shot.beams) do beam:Destroy() end end\n            table.remove(session.shots, index)\n        else\n            local fade = math.clamp(age / shot.duration, 0, 1)\n            if shot.target.model.Parent then shot.finish = bodyPoint(shot.target) end\n            shot.impact.Position = shot.finish\n            shot.impact.Size = Vector3.one * (.3 + fade * (shot.unit.profile.kind == \"Roshi\" and 3.3 or 1.7))\n            shot.impact.Transparency = enabled and fade or 1\n            if shot.beams then\n                local start = emissionPoint(shot.unit)\n                local distance = (shot.finish - start).Magnitude\n                local beamFade = math.clamp(age / math.max(.01, shot.unit.profile.beamDuration), 0, 1)\n                local width = (shot.unit.profile.kind == \"Roshi\" and 1.0 or .32) * (1 - beamFade * .55)\n                local beamFrame = distance > .01 and CFrame.lookAt((start + shot.finish) / 2, shot.finish) * CFrame.Angles(0, math.pi / 2, 0)\n                for i, beam in ipairs(shot.beams) do\n                    if beamFrame then\n                        beam.Size = Vector3.new(math.max(.01, distance), width * (i == 1 and 2.5 or 1), width * (i == 1 and 2.5 or 1))\n                        beam.CFrame = beamFrame\n                    end\n                    beam.Transparency = enabled and beamFrame and (i == 1 and .55 + beamFade * .45 or beamFade) or 1\n                end\n            end\n        end\n    end\nend\n\nlocal function renderCombat(session)\n    if active ~= session or MatchClock.isPaused() then return end\n    local now = MatchClock.now()\n    for _, unit in ipairs(session.units) do\n        if alive(unit) then\n            local alpha = math.clamp((now - unit.visualStarted) / math.max(unit.visualDuration, 1 / 240), 0, 1)\n            unit.model:PivotTo(unit.visualFrom:Lerp(unit.visualTarget, alpha))\n        end\n    end\n    renderEffects(session, now)\nend\n\nlocal function result(session)\n    local count = {player = 0, opponent = 0}\n    local health = {player = 0, opponent = 0}\n    local starting = {player = 0, opponent = 0}\n    for _, unit in ipairs(session.units) do\n        starting[unit.side] += unit.maxHp\n        if alive(unit) then\n            count[unit.side] += 1\n            health[unit.side] += unit.hp\n        end\n    end\n    if count.player == 0 or count.opponent == 0 then\n        return true, count.player > 0 and \"player\" or (count.opponent > 0 and \"opponent\" or nil)\n    end\n    if session.elapsed < session.limit then return false end\n    local playerHealth = health.player / math.max(1, starting.player)\n    local opponentHealth = health.opponent / math.max(1, starting.opponent)\n    if math.abs(playerHealth - opponentHealth) < .001 then return true, nil end\n    return true, playerHealth > opponentHealth and \"player\" or \"opponent\"\nend\n\nfunction CombatController.cancel()\n    if active then\n        if active.connection then active.connection:Disconnect() end\n        if active.renderConnection then active.renderConnection:Disconnect() end\n        for _, unit in ipairs(active.units) do\n            if alive(unit) then unit.model:PivotTo(unit.simPivot) end\n        end\n        if active.effects then active.effects:Destroy() end\n        active = nil\n    end\n    AttackAnimator.stopAll()\nend\n\nfunction CombatController.run(onEnd, options)\n    CombatController.cancel()\n    options = options or {}\n    local arena = ArenaConfig.getArena()\n    local folder = arena and arena:FindFirstChild(\"DeployedUnits\")\n    if not folder then task.defer(onEnd, nil) return end\n    local session = {arena = arena, units = {}, shots = {}, elapsed = 0, accumulator = 0, attacks = 0, limit = options.timeLimit or 30}\n    session.effects = Instance.new(\"Folder\")\n    session.effects.Name = \"CombatEffects\"\n    session.effects.Parent = arena\n    for _, model in ipairs(folder:GetChildren()) do\n        local unit = makeUnit(model)\n        if unit then table.insert(session.units, unit) end\n    end\n    table.sort(session.units, function(a, b) return a.model:GetAttribute(\"SpawnIndex\") < b.model:GetAttribute(\"SpawnIndex\") end)\n    active = session\n    session.renderConnection = RunService.RenderStepped:Connect(function() renderCombat(session) end)\n    arena:SetAttribute(\"CombatAttacks\", 0)\n    session.connection = RunService.Heartbeat:Connect(function(dt)\n        if active ~= session then return end\n        if not folder.Parent or (options.isCurrent and not options.isCurrent()) then CombatContr