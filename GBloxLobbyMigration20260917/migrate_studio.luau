local sourcePatches=H:JSONDecode([====[{"ServerScriptService.LobbyCoins":"local Players=game:GetService(\"Players\")\nlocal Run=game:GetService(\"RunService\")\nlocal Data=require(script.Parent:WaitForChild(\"PlayerData\"))\nlocal folder=workspace:WaitForChild(\"LobbyCoins\")\nlocal floor=workspace:WaitForChild(\"Lobby\"):WaitForChild(\"Lobby floor\")\nlocal event=game.ReplicatedStorage:WaitForChild(\"LobbyCoinCollected\")\nlocal rng=Random.new() local busy={} local accumulator=0\nlocal Placement=(function()\n-- Spatial placement shared by the live coin service and Edit-mode migration checks.\nlocal Placement={}\nfunction Placement.Contains(floor,position,margin)\n local p=floor.CFrame:PointToObjectSpace(position)\n margin=margin or 5\n return math.abs(p.X)<=floor.Size.X/2-margin and math.abs(p.Z)<=floor.Size.Z/2-margin\n  and math.abs(p.Y-(floor.Size.Y/2+2.8))<.1\nend\nfunction Placement.IsClear(floor,folder,coin,position)\n if not Placement.Contains(floor,position,5) then return false end\n local excluded={floor,folder}\n local nav=workspace:FindFirstChild(\"LobbyNavigationTargets\")\n if nav then table.insert(excluded,nav) end\n local overlap=OverlapParams.new()\n overlap.FilterType=Enum.RaycastFilterType.Exclude\n overlap.FilterDescendantsInstances=excluded\n if #workspace:GetPartBoundsInBox(CFrame.new(position+Vector3.new(0,1.2,0)),Vector3.new(5,7.5,5),overlap)>0 then return false end\n for _,other in folder:GetChildren() do\n  if other~=coin and other:IsA(\"BasePart\") and (other.Position-position).Magnitude<6 then return false end\n end\n return true\nend\nfunction Placement.Find(floor,folder,coin,rng,attempts)\n for _=1,attempts or 400 do\n  local position=floor.CFrame:PointToWorldSpace(Vector3.new(\n   rng:NextNumber(-floor.Size.X/2+5,floor.Size.X/2-5),\n   floor.Size.Y/2+2.8,\n   rng:NextNumber(-floor.Size.Z/2+5,floor.Size.Z/2-5)))\n  if (position-coin.Position).Magnitude>=12 and Placement.IsClear(floor,folder,coin,position) then return position end\n end\n return nil\nend\nreturn Placement\n\nend)()\nlocal function location(coin)\n return Placement.Find(floor,folder,coin,rng,400)\nend\nRun.Heartbeat:Connect(function(dt)\n accumulator+=dt if accumulator<.12 then return end accumulator=0\n for _,coin in folder:GetChildren() do\n  if not coin:IsA(\"BasePart\") or busy[coin] then continue end\n  for _,player in Players:GetPlayers() do\n   local character=player.Character local root=character and character:FindFirstChild(\"HumanoidRootPart\") local hum=character and character:FindFirstChildOfClass(\"Humanoid\")\n   if not root or not hum or hum.Health<=0 or player:GetAttribute(\"PlayerDataReady\")~=true or (root.Position-coin.Position).Magnitude>4.5 then continue end\n   local ray=RaycastParams.new() ray.FilterType=Enum.RaycastFilterType.Exclude ray.FilterDescendantsInstances={character,folder} ray.RespectCanCollide=true\n   if workspace:Raycast(root.Position,coin.Position-root.Position,ray) then continue end\n   local destination=location(coin) if not destination then break end\n   busy[coin]=true\n   local amount=coin:GetAttribute(\"CashValue\")\n   local result,awarded=Data.AddEarnedCash(player,amount)\n   if result==nil then busy[coin]=nil break end\n   coin.Transparency=1\n   event:FireClient(player,awarded)\n   task.delay(.35,function()\n    if coin.Parent then\n     coin.CFrame=CFrame.new(destination) coin:SetAttribute(\"RestCFrame\",coin.CFrame)\n     coin.Transparency=0\n    end\n    busy[coin]=nil\n   end)\n   break\n  end\n end\nend)","ServerScriptService.GlobalLeaderboardServer":"local Players = game:GetService(\"Players\")\n\nlocal PlayerData = require(\n\tgame.ServerScriptService:WaitForChild(\n\t\t\"PlayerData\"\n\t)\n)\n\nlocal display = workspace:WaitForChild(\"LeaderboardDisplay\")\n\nlocal boards = display\nlocal podiums = display\nlocal nameCache = {}\n\nlocal boardConfigs = {\n\t{\n\t\tModel = boards:WaitForChild(\"WinsBoard\"),\n\t\tStore = PlayerData.OrderedStores.Wins,\n\t\tAscending = false,\n\t\tFormat = function(value)\n\t\t\treturn tostring(math.floor(value)) .. \" wins\"\n\t\tend,\n\t\tPodium = podiums:WaitForChild(\n\t\t\t\"WinsChampion\"\n\t\t),\n\t\tLabel = \"MOST WINS\",\n\t},\n\t{\n\t\tModel = boards:WaitForChild(\"CashBoard\"),\n\t\tStore = PlayerData.OrderedStores.TotalCash,\n\t\tAscending = false,\n\t\tFormat = function(value)\n\t\t\treturn \"$\"\n\t\t\t\t.. tostring(\n\t\t\t\t\tmath.floor(value)\n\t\t\t\t)\n\t\tend,\n\t},\n\t{\n\t\tModel = boards:WaitForChild(\"FastestBoard\"),\n\t\tStore = PlayerData.OrderedStores.FastestTime,\n\t\tAscending = true,\n\t\tFormat = function(value)\n\t\t\treturn string.format(\n\t\t\t\t\"%.2fs\",\n\t\t\t\tvalue / 1000\n\t\t\t)\n\t\tend,\n\t\tPodium = podiums:WaitForChild(\n\t\t\t\"FastestChampion\"\n\t\t),\n\t\tLabel = \"FASTEST 5-ROUND TIME\",\n\t},\n}\n\nlocal function playerName(userId)\n\tif nameCache[userId] then\n\t\treturn nameCache[userId]\n\tend\n\n\tlocal success, result = pcall(\n\t\tPlayers.GetNameFromUserIdAsync,\n\t\tPlayers,\n\t\tuserId\n\t)\n\n\tlocal name =\n\t\tsuccess and result\n\t\tor \"Player \" .. tostring(userId)\n\n\tnameCache[userId] = name\n\treturn name\nend\n\nlocal function setRow(row, rank, name, value)\n\trow.Rank.Text = tostring(rank)\n\trow.Player.Text = name\n\trow.Value.Text = value\nend\n\nlocal function readBoard(config)\n\tlocal entries\n\tlocal success, message = pcall(function()\n\t\tlocal pages =\n\t\t\tconfig.Store:GetSortedAsync(\n\t\t\t\tconfig.Ascending,\n\t\t\t\t10\n\t\t\t)\n\n\t\tentries = pages:GetCurrentPage()\n\tend)\n\n\tif not success then\n\t\twarn(\n\t\t\t\"[Leaderboards] Could not refresh\",\n\t\t\tconfig.Model.Name,\n\t\t\tmessage\n\t\t)\n\n\t\treturn nil, message\n\tend\n\n\treturn entries\nend\n\nlocal function clearAvatar(podium)\n\tlocal old =\n\t\tpodium:FindFirstChild(\n\t\t\t\"ChampionAvatar\"\n\t\t)\n\n\tif old then\n\t\told:Destroy()\n\tend\nend\n\nlocal function updateChampion(\n\tpodium,\n\tuserId,\n\tname,\n\tvalue,\n\tlabelText\n)\n\tlocal label =\n\t\tpodium.SignAnchor.ChampionGui.ChampionLabel\n\n\tif not userId then\n\t\tclearAvatar(podium)\n\t\tpodium:SetAttribute(\"ChampionUserId\", 0)\n\t\tlabel.Text =\n\t\t\t\"#1 \"\n\t\t\t.. labelText\n\t\t\t.. string.char(10)\n\t\t\t.. \"No champion yet\"\n\n\t\treturn\n\tend\n\n\tlabel.Text =\n\t\t\"#1 \"\n\t\t.. labelText\n\t\t.. string.char(10)\n\t\t.. name\n\t\t.. \"  \"\n\t\t.. value\n\n\tif podium:GetAttribute(\"ChampionUserId\")\n\t\t== userId then\n\n\t\treturn\n\tend\n\n\tclearAvatar(podium)\n\n\tlocal success, avatar = pcall(function()\n\t\tlocal description =\n\t\t\tPlayers:GetHumanoidDescriptionFromUserId(\n\t\t\t\tuserId\n\t\t\t)\n\n\t\treturn Players:CreateHumanoidModelFromDescription(\n\t\t\tdescription,\n\t\t\tEnum.HumanoidRigType.R15\n\t\t)\n\tend)\n\n\tif not success or not avatar then\n\t\twarn(\n\t\t\t\"[Leaderboards] Could not display champion\",\n\t\t\tuserId,\n\t\t\tavatar\n\t\t)\n\n\t\treturn\n\tend\n\n\tavatar.Name = \"ChampionAvatar\"\n\n\tfor _, object in ipairs(\n\t\tavatar:GetDescendants()\n\t) do\n\t\tif object:IsA(\"BasePart\") then\n\t\t\tobject.Anchored = true\n\t\t\tobject.CanCollide = false\n\t\t\tobject.CanTouch = false\n\t\t\tobject.CanQuery = false\n\t\telseif object:IsA(\"Script\")\n\t\t\tor object:IsA(\"LocalScript\") then\n\n\t\t\tobject:Destroy()\n\t\tend\n\tend\n\n\tlocal humanoid =\n\t\tavatar:FindFirstChildOfClass(\n\t\t\t\"Humanoid\"\n\t\t)\n\n\tif humanoid then\n\t\thumanoid.DisplayDistanceType =\n\t\t\tEnum.HumanoidDisplayDistanceType.None\n\tend\n\n\tavatar.Parent = podium\n\n\tlocal anchor = podium.AvatarAnchor\n\tavatar:PivotTo(\n\t\tCFrame.lookAt(\n\t\t\tanchor.Position,\n\t\t\tanchor.Position\n\t\t\t\t- anchor.CFrame.RightVector\n\t\t)\n\t)\n\n\tlocal highlight = Instance.new(\"Highlight\")\n\thighlight.Name = \"ChampionOutline\"\n\thighlight.FillTransparency = 1\n\thighlight.OutlineColor =\n\t\tpodium.UpperStep.Color\n\thighlight.OutlineTransparency = 0\n\thighlight.Parent = avatar\n\n\tpodium:SetAttribute(\n\t\t\"ChampionUserId\",\n\t\tuserId\n\t)\nend\n\nlocal function refreshBoard(config)\n\tlocal rows =\n\t\tconfig.Model.Screen.BoardGui.Background.Rows\n\n\tlocal entries, message = readBoard(config)\n\n\tif not entries then\n\t\tfor rank = 1, 10 do\n\t\t\tlocal row =\n\t\t\t\trows:FindFirstChild(\n\t\t\t\t\t\"Row\" .. rank\n\t\t\t\t)\n\n\t\t\tif row then\n\t\t\t\tsetRow(\n\t\t\t\t\trow,\n\t\t\t\t\trank,\n\t\t\t\t\trank == 1\n\t\t\t\t\t\tand \"Rankings unavailable\"\n\t\t\t\t\t\tor \"\",\n\t\t\t\t\t\"\"\n\t\t\t\t)\n\t\t\tend\n\t\tend\n\n\t\treturn\n\tend\n\n\tfor rank = 1, 10 do\n\t\tlocal row =\n\t\t\trows:FindFirstChild(\n\t\t\t\t\"Row\" .. rank\n\t\t\t)\n\n\t\tlocal entry = entries[rank]\n\n\t\tif row and entry then\n\t\t\tlocal userId =\n\t\t\t\ttonumber(entry.key)\n\n\t\t\tlocal name =\n\t\t\t\tuserId\n\t\t\t\tand playerName(userId)\n\t\t\t\tor \"Unknown\"\n\n\t\t\tsetRow(\n\t\t\t\trow,\n\t\t\t\trank,\n\t\t\t\tname,\n\t\t\t\tconfig.Format(entry.value)\n\t\t\t)\n\t\telseif row then\n\t\t\tsetRow(\n\t\t\t\trow,\n\t\t\t\trank,\n\t\t\t\t\"No record yet\",\n\t\t\t\t\"--\"\n\t\t\t)\n\t\tend\n\tend\n\n\tif config.Podium then\n\t\tlocal top = entries[1]\n\t\tlocal userId =\n\t\t\ttop and tonumber(top.key)\n\n\t\tupdateChampion(\n\t\t\tconfig.Podium,\n\t\t\tuserId,\n\t\t\tuserId and playerName(userId),\n\t\t\ttop and config.Format(top.value),\n\t\t\tconfig.Label\n\t\t)\n\tend\nend\n\nlocal function refreshAll()\n\tfor _, config in ipairs(boardConfigs) do\n\t\trefreshBoard(config)\n\tend\nend\n\ntask.delay(3, refreshAll)\n\nwhile task.wait(60) do\n\trefreshAll()\nend","ServerScriptService.QueueServer":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal TeleportService = game:GetService(\"TeleportService\")\nlocal PlayerData = require(game.ServerScriptService:WaitForChild(\"PlayerData\"))\n\nlocal Zone = require(\n\tReplicatedStorage.Modules.Zone\n)\n\nlocal teleportZones =\n\tworkspace:WaitForChild(\"TeleportZones\")\n\nlocal configuration =\n\tteleportZones:WaitForChild(\"Configuration\")\n\nlocal lobbyPosition =\n\tteleportZones:WaitForChild(\"LobbyPos\")\n\nlocal lowestPlayers = 2\nlocal highestPlayers = 6\n\nconfiguration:WaitForChild(\n\t\"HighestPlayer\"\n).Value = highestPlayers\n\nlocal countdownLength =\n\tmath.max(\n\t\t1,\n\t\tconfiguration:WaitForChild(\n\t\t\t\"Countdown\"\n\t\t).Value\n\t)\n\nlocal createTime =\n\tmath.max(\n\t\t1,\n\t\tconfiguration:WaitForChild(\n\t\t\t\"TimeBeforeExpires\"\n\t\t).Value\n\t)\n\nlocal defaultPlayers =\n\tmath.min(6, highestPlayers)\n\nlocal destinationValue =\n\tconfiguration:WaitForChild(\n\t\t\"DestinationPlaceId\"\n\t)\n\nlocal queueEvent =\n\tReplicatedStorage:FindFirstChild(\n\t\t\"QueueEvent\"\n\t)\n\nif not queueEvent then\n\tqueueEvent = Instance.new(\"RemoteEvent\")\n\tqueueEvent.Name = \"QueueEvent\"\n\tqueueEvent.Parent = ReplicatedStorage\nend\n\nlocal zoneData = {}\nlocal playerZones = {}\n\nlocal function getRoot(player)\n\tlocal character = player.Character\n\n\tif not character then\n\t\treturn nil\n\tend\n\n\treturn character:FindFirstChild(\n\t\t\"HumanoidRootPart\"\n\t)\nend\n\nlocal function movePlayer(player, part)\n\tlocal character = player.Character\n\n\tif not character or not part then\n\t\treturn\n\tend\n\n\tcharacter:PivotTo(\n\t\tpart.CFrame * CFrame.new(0, 3, 0)\n\t)\nend\n\nlocal function playerIndex(data, player)\n\tfor index, member in ipairs(data.Players) do\n\t\tif member == player then\n\t\t\treturn index\n\t\tend\n\tend\n\n\treturn nil\nend\n\nlocal function leader(data)\n\treturn data.Players[1]\nend\n\nlocal function stateText(data)\n\tif data.State == \"Configuring\" then\n\t\treturn \"Creating party...\"\n\n\telseif data.State == \"Waiting\" then\n\t\treturn \"Waiting for players...\"\n\n\telseif data.State == \"Teleporting\" then\n\t\treturn \"Teleporting...\"\n\tend\n\n\treturn \"Waiting for players...\"\nend\n\nlocal function updateBillboard(data)\n\tlocal billboard =\n\t\tdata.Model:FindFirstChild(\n\t\t\t\"BillboardGui\"\n\t\t)\n\n\tif not billboard then\n\t\treturn\n\tend\n\n\tlocal playerCount =\n\t\tbillboard:FindFirstChild(\n\t\t\t\"PlayerCount\"\n\t\t)\n\n\tlocal stateLabel =\n\t\tbillboard:FindFirstChild(\n\t\t\t\"StateLabel\"\n\t\t)\n\n\tif playerCount then\n\t\tplayerCount.Text =\n\t\t\ttostring(#data.Players)\n\t\t\t.. \"/\"\n\t\t\t.. tostring(data.MaxPlayers)\n\tend\n\n\tif stateLabel then\n\t\tstateLabel.Text = stateText(data)\n\tend\nend\n\nlocal function sendPartyState(data, timeLeft)\n\tlocal currentLeader = leader(data)\n\n\tfor _, player in ipairs(data.Players) do\n\t\tif player.Parent == Players then\n\t\t\tqueueEvent:FireClient(\n\t\t\t\tplayer,\n\t\t\t\t\"PartyState\",\n\t\t\t\t{\n\t\t\t\t\tZone = data.Model.Name,\n\t\t\t\t\tState = data.State,\n\t\t\t\t\tPlayers = #data.Players,\n\t\t\t\t\tMaxPlayers = data.MaxPlayers,\n\t\t\t\t\tBotCount = data.BotCount,\n\t\t\t\t\tIsLeader = player == currentLeader,\n\t\t\t\t\tTimeLeft = timeLeft,\n\t\t\t\t\tExpiresAt = data.ExpiresAt,\n\t\t\t\t\tHighestPlayer = highestPlayers\n\t\t\t\t}\n\t\t\t)\n\t\tend\n\tend\nend\n\nlocal function resetZone(data, movePlayers)\n\tdata.Version += 1\n\n\tlocal oldPlayers =\n\t\ttable.clone(data.Players)\n\n\ttable.clear(data.Players)\n\n\tdata.State = \"Idle\"\n\tdata.MaxPlayers = defaultPlayers\n\tdata.BotCount = 0\n\tdata.ExpiresAt = 0\n\n\tfor _, player in ipairs(oldPlayers) do\n\t\tif playerZones[player] == data then\n\t\t\tplayerZones[player] = nil\n            player:SetAttribute(\"GBloxInParty\", false)\n\t\tend\n\n\t\tif player.Parent == Players then\n\t\t\tqueueEvent:FireClient(\n\t\t\t\tplayer,\n\t\t\t\t\"Hide\"\n\t\t\t)\n\n\t\t\tif movePlayers then\n\t\t\t\tmovePlayer(\n\t\t\t\t\tplayer,\n\t\t\t\t\tlobbyPosition\n\t\t\t\t)\n\t\t\tend\n\t\tend\n\tend\n\n\tupdateBillboard(data)\nend\n\nlocal function removePlayer(\n\tplayer,\n\tdata,\n\tmoveToLobby\n)\n\tlocal index =\n\t\tplayerIndex(\n\t\t\tdata,\n\t\t\tplayer\n\t\t)\n\n\tif not index then\n\t\treturn\n\tend\n\n\ttable.remove(\n\t\tdata.Players,\n\t\tindex\n\t)\n\n\tif playerZones[player] == data then\n\t\tplayerZones[player] = nil\n        player:SetAttribute(\"GBloxInParty\", false)\n\tend\n\n\tif player.Parent == Players then\n\t\tqueueEvent:FireClient(\n\t\t\tplayer,\n\t\t\t\"Hide\"\n\t\t)\n\n\t\tif moveToLobby then\n\t\t\tmovePlayer(\n\t\t\t\tplayer,\n\t\t\t\tlobbyPosition\n\t\t\t)\n\t\tend\n\tend\n\n\tif #data.Players == 0 then\n\t\tresetZone(data, false)\n\t\treturn\n\tend\n\n\tupdateBillboard(data)\n\tsendPartyState(data)\nend\n\nlocal function teleportParty(data)\n\tif data.State == \"Teleporting\"\n\t\tor #data.Players == 0 then\n\n\t\treturn\n\tend\n\n\tdata.State = \"Teleporting\"\n\tdata.Version += 1\n\n\tlocal party = {}\n\n\tfor _, player in ipairs(data.Players) do\n\t\tif player.Parent == Players then\n\t\t\ttable.insert(party, player)\n\t\tend\n\tend\n\n\tif #party == 0 then\n\t\tresetZone(data, false)\n\t\treturn\n\tend\n\n\tupdateBillboard(data)\n\tsendPartyState(data, 0)\n\n\tlocal destinationPlaceId = destinationValue.Value\n\n\tlocal options = Instance.new(\n\t\t\"TeleportOptions\"\n\t)\n\n\toptions.ShouldReserveServer = true\n\n local playtimeTickets={}\n for _,player in ipairs(party) do\n  local token,reason=PlayerData.PreparePlaytimeTeleport(player,destinationPlaceId)\n  if not token then\n   for _,prepared in ipairs(party) do\n    local ticket=playtimeTickets[tostring(prepared.UserId)]\n    if ticket then PlayerData.CancelPlaytimeTeleport(prepared,ticket) end\n   end\n   for _,member in ipairs(party) do\n    if member.Parent==Players then queueEvent:FireClient(member,\"Error\",reason or \"Save busy. Please retry.\") end\n   end\n   resetZone(data,true)\n   return\n  end\n  playtimeTickets[tostring(player.UserId)]=token\n end\n options:SetTeleportData({\n  GBloxPlaytimeTickets=playtimeTickets,\n\t\tFromLobby = true,\n\t\tPartySize = data.MaxPlayers,\n\t\tHumanCount = #party,\n\t\tBotCount = data.BotCount,\n\t\tZone = data.Model.Name\n\t})\n\n\tlocal success, message =\n\t\tpcall(function()\n\t\t\tTeleportService:TeleportAsync(\n\t\t\t\tdestinationPlaceId,\n\t\t\t\tparty,\n\t\t\t\toptions\n\t\t\t)\n\t\tend)\n\n\tif not success then\n  for _,player in ipairs(party) do PlayerData.CancelPlaytimeTeleport(player,playtimeTickets[tostring(player.UserId)]) end\n\t\twarn(\n\t\t\t\"[Queue]\",\n\t\t\t\"Teleport failed:\",\n\t\t\tmessage\n\t\t)\n\n\t\tfor _, player in ipairs(party) do\n\t\t\tif player.Parent == Players then\n\t\t\t\tqueueEvent:FireClient(\n\t\t\t\t\tplayer,\n\t\t\t\t\t\"Error\",\n\t\t\t\t\t\"Teleport failed. Please try again.\"\n\t\t\t\t)\n\t\t\tend\n\t\tend\n\n\t\tresetZone(data, true)\n\tend\nend\n\nTeleportService.TeleportInitFailed:Connect(function(player,_,message,placeId,options)\n if placeId~=destinationValue.Value or not options then return end\n local payload=options:GetTeleportData()\n local tickets=typeof(payload)==\"table\" and payload.GBloxPlaytimeTickets\n local token=typeof(tickets)==\"table\" and tickets[tostring(player.UserId)]\n if not token then return end\n PlayerData.CancelPlaytimeTeleport(player,token)\n local data=playerZones[player]\n if data and data.State==\"Teleporting\" then\n  -- Other party members may already be in flight: preserve their handoff tickets.\n  warn(\"[Queue] Teleport initialization failed:\",message)\n  resetZone(data,true)\n end\nend)\n\nlocal function startCountdown(data)\n\tif data.State == \"Teleporting\" then\n\t\treturn\n\tend\n\n\tdata.State = \"Waiting\"\n\tdata.Version += 1\n\n\tlocal version = data.Version\n\n\tupdateBillboard(data)\n\n\ttask.spawn(function()\n\t\tfor timeLeft = countdownLength, 0, -1 do\n\t\t\tif version ~= data.Version\n\t\t\t\tor data.State ~= \"Waiting\" then\n\n\t\t\t\treturn\n\t\t\tend\n\n\t\t\tupdateBillboard(data)\n\t\t\tsendPartyState(data, timeLeft)\n\n\t\t\tif #data.Players >= data.MaxPlayers\n\t\t\t\tor timeLeft == 0 then\n\n\t\t\t\tteleportParty(data)\n\t\t\t\treturn\n\t\t\tend\n\n\t\t\ttask.wait(1)\n\t\tend\n\tend)\nend\n\nlocal function startCreateTimer(data)\n\tdata.Version += 1\n\n\tlocal version = data.Version\n\tlocal expiresAt =\n\t\tworkspace:GetServerTimeNow()\n\t\t+ createTime\n\n\tdata.ExpiresAt = expiresAt\n\n\tqueueEvent:FireClient(\n\t\tleader(data),\n\t\t\"ShowCreate\",\n\t\t{\n\t\t\tZone = data.Model.Name,\n\t\t\tPlayerCount = data.MaxPlayers,\n\t\t\tBotCount = data.BotCount,\n\t\t\tHighestPlayer = highestPlayers,\n\t\t\tExpiresAt = expiresAt\n\t\t}\n\t)\n\n\ttask.delay(createTime, function()\n\t\tif version ~= data.Version\n\t\t\tor data.State ~= \"Configuring\"\n\t\t\tor #data.Players == 0 then\n\n\t\t\treturn\n\t\tend\n\n\t\tstartCountdown(data)\n\tend)\nend\n\nlocal function addPlayer(player, data)\n\tif player:GetAttribute(\"GBloxLobbyReady\") ~= true then\n\t\treturn\n\tend\n\n\tlocal oldData =\n\t\tplayerZones[player]\n\n\tif oldData == data then\n\t\treturn\n\tend\n\n\tif oldData then\n\t\tremovePlayer(\n\t\t\tplayer,\n\t\t\toldData,\n\t\t\tfalse\n\t\t)\n\tend\n\n\tif data.State == \"Teleporting\"\n\t\tor #data.Players >= data.MaxPlayers then\n\n\t\tmovePlayer(player, lobbyPosition)\n\t\treturn\n\tend\n\n\ttable.insert(\n\t\tdata.Players,\n\t\tplayer\n\t)\n\n\tplayerZones[player] = data\n player:SetAttribute(\"GBloxInParty\",true)\n\n\tmovePlayer(\n\t\tplayer,\n\t\tdata.Container\n\t)\n\n\tif #data.Players == 1 then\n\t\tdata.State = \"Configuring\"\n\t\tdata.MaxPlayers = defaultPlayers\n\t\tdata.BotCount = 0\n\n\t\tstartCreateTimer(data)\n\tend\n\n\tupdateBillboard(data)\n\tsendPartyState(data)\n\n\tif data.State == \"Waiting\"\n\t\tand #data.Players >= data.MaxPlayers then\n\n\t\tteleportParty(data)\n\tend\nend\n\nqueueEvent.OnServerEvent:Connect(\n\tfunction(player, action, settings)\n\t\tlocal data =\n\t\t\tplayerZones[player]\n\n\t\tif action == \"Leave\" then\n\t\t\tif data\n\t\t\t\tand data.State\n\t\t\t\t\t~= \"Teleporting\" then\n\n\t\t\t\tremovePlayer(\n\t\t\t\t\tplayer,\n\t\t\t\t\tdata,\n\t\t\t\t\ttrue\n\t\t\t\t)\n\t\t\tend\n\n\t\t\treturn\n\t\tend\n\n\t\tif not data\n\t\t\tor leader(data) ~= player\n\t\t\tor data.State ~= \"Configuring\" then\n\n\t\t\treturn\n\t\tend\n\n\t\tif action == \"SetOptions\"\n\t\t\tand typeof(settings) == \"table\" then\n\n\t\t\tlocal maxPlayers =\n\t\t\t\tmath.clamp(\n\t\t\t\t\tmath.floor(\n\t\t\t\t\t\ttonumber(\n\t\t\t\t\t\t\tsettings.PlayerCount\n\t\t\t\t\t\t) or data.MaxPlayers\n\t\t\t\t\t),\n\t\t\t\t\tmath.max(\n\t\t\t\t\t\t#data.Players,\n\t\t\t\t\t\tlowestPlayers\n\t\t\t\t\t),\n\t\t\t\t\thighestPlayers\n\t\t\t\t)\n\n\t\t\tlocal botCount =\n\t\t\t\tmath.clamp(\n\t\t\t\t\tmath.floor(\n\t\t\t\t\t\ttonumber(\n\t\t\t\t\t\t\tsettings.BotCount\n\t\t\t\t\t\t) or data.BotCount\n\t\t\t\t\t),\n\t\t\t\t\t0,\n\t\t\t\t\thighestPlayers - maxPlayers\n\t\t\t\t)\n\n\t\t\tdata.MaxPlayers = maxPlayers\n\t\t\tdata.BotCount = botCount\n\n\t\t\tupdateBillboard(data)\n\t\t\tsendPartyState(data)\n\n\t\telseif action == \"Create\" then\n\t\t\tstartCountdown(data)\n\t\tend\n\tend\n)\n\nPlayers.PlayerRemoving:Connect(\n\tfunction(player)\n\t\tlocal data =\n\t\t\tplayerZones[player]\n\n\t\tif data then\n\t\t\tremovePlayer(\n\t\t\t\tplayer,\n\t\t\t\tdata,\n\t\t\t\tfalse\n\t\t\t)\n\t\tend\n\tend\n)\n\nfor _, zoneModel in ipairs(\n\tteleportZones:GetChildren()\n) do\n\tif zoneModel:IsA(\"Model\") then\n\t\tlocal container =\n\t\t\tzoneModel:FindFirstChild(\n\t\t\t\t\"ZoneContainer\"\n\t\t\t)\n\n\t\tif container\n\t\t\tand container:IsA(\"BasePart\") then\n\n\t\t\tlocal data = {\n\t\t\t\tModel = zoneModel,\n\t\t\t\tContainer = container,\n\t\t\t\tPlayers = {},\n\t\t\t\tMaxPlayers = defaultPlayers,\n\t\t\t\tBotCount = 0,\n\t\t\t\tState = \"Idle\",\n\t\t\t\tVersion = 0,\n\t\t\t\tExpiresAt = 0\n\t\t\t}\n\n\t\t\tzoneData[zoneModel] = data\n\n\t\t\tlocal zone =\n\t\t\t\tZone.new(container)\n\n\t\t\tdata.Zone = zone\n\n\t\t\tzone.playerEntered:Connect(\n\t\t\t\tfunction(player)\n\t\t\t\t\taddPlayer(\n\t\t\t\t\t\tplayer,\n\t\t\t\t\t\tdata\n\t\t\t\t\t)\n\t\t\t\tend\n\t\t\t)\n\n\t\t\tzone.playerExited:Connect(\n\t\t\t\tfunction(player)\n\t\t\t\t\tif playerZones[player] == data\n\t\t\t\t\t\tand data.State\n\t\t\t\t\t\t\t~= \"Teleporting\" then\n\n\t\t\t\t\t\tremovePlayer(\n\t\t\t\t\t\t\tplayer,\n\t\t\t\t\t\t\tdata,\n\t\t\t\t\t\t\tfalse\n\t\t\t\t\t\t)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t)\n\n\t\t\tupdateBillboard(data)\n\t\tend\n\tend\nend","ServerScriptService.GBloxEggService":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal CollectionService = game:GetService(\"CollectionService\")\nlocal MarketplaceService = game:GetService(\"MarketplaceService\")\n\nlocal Data = require(script.Parent:WaitForChild(\"PlayerData\"))\nlocal Policy=require(script.Parent:WaitForChild(\"GBloxPurchasePolicy\"))\nlocal busy={}\nlocal orbitConfirmed={}\nlocal Catalog = require(ReplicatedStorage:WaitForChild(\"GBloxPetCatalog\"))\n\nlocal remote = ReplicatedStorage:FindFirstChild(\"GBloxEggRequest\") or Instance.new(\"RemoteEvent\")\nremote.Name = \"GBloxEggRequest\"\nremote.Parent = ReplicatedStorage\n\nlocal rng = Random.new()\nlocal lastRequest = {}\nlocal autoOpening = {}\nlocal lastTheme = {}\n\nlocal function reply(player, payload)\n payload.Theme=payload.Theme or lastTheme[player]\n remote:FireClient(player, payload)\nend\n\nlocal function nearbyEgg(player, requestedTheme)\n local root = player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\n if not root then return nil end\n for _,stand in CollectionService:GetTagged(\"GBloxEggStand\") do\n  local theme = stand:GetAttribute(\"EggTheme\")\n  if stand:IsA(\"BasePart\") and stand:IsDescendantOf(workspace) and theme == requestedTheme then\n   local delta = root.Position - stand.Position\n   if Vector2.new(delta.X,delta.Z).Magnitude <= 14 and math.abs(delta.Y) <= 11 then\n    return stand\n   end\n  end\n end\n return nil\nend\n\nlocal function rollPet(egg)\n local roll = rng:NextNumber(0,100)\n local total = 0\n for _,pet in egg.Pets do\n  total += pet.Chance\n  if roll <= total then return pet end\n end\n return egg.Pets[#egg.Pets]\nend\n\nlocal function hatchTrophyEggs(player, theme, count)\n local egg = Catalog.Eggs[theme]\n if not egg or egg.Currency ~= \"Trophies\" or not nearbyEgg(player,theme) then\n  return false,\"Move closer to the egg.\"\n end\n local allowed,message=Policy.CanRandom(player)\n if not allowed then return false,message end\n local profile = Data.Get(player)\n if not profile then return false,\"Your data is still loading.\" end\n local cost = count == 3 and egg.TripleCost or egg.SingleCost\n if (profile.Trophies or 0) < cost then return false,\"You need \"..cost..\" trophies.\" end\n\n local results, ids = {}, {}\n local best\n for _=1,count do\n  local pet = rollPet(egg)\n  table.insert(ids,pet.Id)\n  table.insert(results,{\n   Id=pet.Id,\n   Chance=pet.Chance,\n   CashMultiplier=pet.CashMultiplier,\n   TrophyMultiplier=pet.TrophyMultiplier,\n  })\n  if not best or pet.CashMultiplier > best.CashMultiplier then best=pet end\n end\n if not Data.TrySpendTrophies(player,cost) then return false,\"Purchase could not be completed. Try again.\" end\n if not Data.AddPets(player,ids,best.Id) then\n  warn(\"[GBloxEggs] Pets could not be recorded after trophy charge for\",player.UserId)\n  return false,\"Your hatch could not be recorded. Please rejoin.\"\n end\n return true,results\nend\n\nlocal function ownsPass(player,passId)\n local checked,owned=Data.CheckPass(player,passId)\n return owned,not checked and \"check_failed\" or nil\nend\n\nlocal function stopAuto(player,message)\n if autoOpening[player] then\n  autoOpening[player]=nil\n  reply(player,{Ok=true,AutoActive=false,Message=message or \"Auto open stopped.\"})\n end\nend\n\nlocal function startAuto(player,theme)\n if Catalog.Eggs[theme].Currency ~= \"Trophies\" then\n  reply(player,{Ok=false,Message=\"Auto open is only configured for trophy eggs.\"})\n  return\n end\n local owned,reason=ownsPass(player,Catalog.Gamepasses.AutoOpen)\n if not owned then\n  if reason==\"missing\" then\n   reply(player,{Ok=false,Message=\"Auto-open gamepass ID still needs to be added.\"})\n  elseif reason==\"check_failed\" then\n   reply(player,{Ok=false,Message=\"Could not verify the auto-open gamepass. Try again.\"})\n  else\n   reply(player,{Ok=false,Message=\"Auto open requires its gamepass.\",PromptPass=Catalog.Gamepasses.AutoOpen})\n  end\n  return\n end\n autoOpening[player]=theme\n reply(player,{Ok=true,AutoActive=true,Message=\"Auto open started.\"})\n task.spawn(function()\n  while autoOpening[player]==theme and player.Parent do\n   local ok,result=hatchTrophyEggs(player,theme,1)\n   if not ok then stopAuto(player,result) break end\n   reply(player,{Ok=true,AutoActive=true,Results=result})\n   task.wait(8)\n  end\n end)\nend\n\nlocal function handleRequest(player,action,theme)\n if typeof(action)~=\"string\" or typeof(theme)~=\"string\" or not Catalog.Eggs[theme] then return end\n lastTheme[player]=theme\n if not nearbyEgg(player,theme) then\n  stopAuto(player)\n  reply(player,{Ok=false,Message=\"Move closer to the egg.\"})\n  return\n end\n\n if action~=\"One\" and action~=\"Three\" and action~=\"Auto\" and action~=\"BuyOrbit\" then return end\n if action==\"Auto\" and autoOpening[player] then stopAuto(player) return end\n local eligible,reason=Policy.CanRandom(player)\n if not eligible then reply(player,{Ok=false,Message=reason}) return end\n if action==\"Auto\" then\n  if autoOpening[player] then stopAuto(player) else startAuto(player,theme) end\n  return\n end\n\n local now=os.clock()\n if now-(lastRequest[player] or 0)<.35 then return end\n lastRequest[player]=now\n stopAuto(player)\n\n local egg=Catalog.Eggs[theme]\n if egg.Currency==\"Robux\" then\n  if action==\"One\" then\n   orbitConfirmed[player]=os.clock()+60\n   reply(player,{Ok=true,ConfirmOrbit=true,Message=\"Orbit odds: Orca 85%, Swordfish 10%, Shark 4.5%, Alien 0.5%.\"})\n  elseif action==\"BuyOrbit\" and (orbitConfirmed[player] or 0)>os.clock() then\n   orbitConfirmed[player]=nil\n   local allowed,message=Data.CanPromptPurchase(player,\"Product\",Catalog.Products.OrbitSingle)\n   if allowed then MarketplaceService:PromptProductPurchase(player,Catalog.Products.OrbitSingle)\n   else reply(player,{Ok=false,Message=message}) end\n  else reply(player,{Ok=false,Message=\"Select one Orbit egg to see the odds.\"}) end\n  return\n end\n if action==\"BuyOrbit\" then return end\n\n local count=action==\"Three\" and 3 or 1\n if count==3 then\n  local owned,reason=ownsPass(player,Catalog.Gamepasses.TripleOpen)\n  if not owned then\n   if reason==\"missing\" then\n    reply(player,{Ok=false,Message=\"3-egg gamepass ID still needs to be added.\"})\n   elseif reason==\"check_failed\" then\n    reply(player,{Ok=false,Message=\"Could not verify the 3-egg gamepass. Try again.\"})\n   else\n    reply(player,{Ok=false,Message=\"Opening 3 eggs requires its gamepass.\",PromptPass=Catalog.Gamepasses.TripleOpen})\n   end\n   return\n  end\n end\n\n local ok,result=hatchTrophyEggs(player,theme,count)\n if ok then reply(player,{Ok=true,Results=result})\n else reply(player,{Ok=false,Message=result}) end\nend\n\nlocal function guardedRequest(player,action,theme)\n if busy[player] then return end\n busy[player]=true\n local ok,err=pcall(handleRequest,player,action,theme)\n busy[player]=nil\n if not ok then warn(\"[GBloxEggs]\",err) reply(player,{Ok=false,Message=\"Egg unavailable. Please try again.\"}) end\nend\nremote.OnServerEvent:Connect(guardedRequest)\nfor _,stand in CollectionService:GetTagged(\"GBloxEggStand\") do\n for _,object in stand:GetDescendants() do\n  if object:IsA(\"ProximityPrompt\") and object:GetAttribute(\"EggAction\") then\n   object.Triggered:Connect(function(player)\n    guardedRequest(player,object:GetAttribute(\"EggAction\"),object:GetAttribute(\"EggTheme\"))\n   end)\n  end\n end\nend\n\nPlayers.PlayerRemoving:Connect(function(player)\n autoOpening[player]=nil\n busy[player]=nil orbitConfirmed[player]=nil\n lastRequest[player]=nil\n lastTheme[player]=nil\nend)\n\n","StarterPlayer.StarterPlayerScripts.LobbyInteractions":"local Players=game:GetService(\"Players\")\nlocal CS=game:GetService(\"CollectionService\")\nlocal Run=game:GetService(\"RunService\")\nlocal CAS=game:GetService(\"ContextActionService\")\nlocal MarketplaceService=game:GetService(\"MarketplaceService\")\nlocal ReplicatedStorage=game:GetService(\"ReplicatedStorage\")\n\nlocal player=Players.LocalPlayer\nlocal pg=player:WaitForChild(\"PlayerGui\")\nlocal shop=pg:WaitForChild(\"GBloxShopMockups\")\nlocal event=shop:WaitForChild(\"OpenPanel\")\nlocal exit=ReplicatedStorage:WaitForChild(\"TreadmillExit\")\nlocal eggRemote=ReplicatedStorage:WaitForChild(\"GBloxEggRequest\")\n\nlocal overlay=Instance.new(\"ScreenGui\")\noverlay.Name=\"GBloxInteractionUI\"\noverlay.ResetOnSpawn=false\noverlay.DisplayOrder=60\noverlay.Parent=pg\n\nlocal exitButton=Instance.new(\"TextButton\")\nexitButton.Name=\"ExitTreadmill\"\nexitButton.AnchorPoint=Vector2.new(.5,1)\nexitButton.Position=UDim2.new(.5,0,1,-106)\nexitButton.Size=UDim2.fromOffset(180,40)\nexitButton.BackgroundColor3=Color3.fromRGB(0,140,167)\nexitButton.Text=\"EXIT TREADMILL\"\nexitButton.Font=Enum.Font.GothamBold\nexitButton.TextSize=16\nexitButton.TextColor3=Color3.new(1,1,1)\nexitButton.Visible=false\nexitButton.Parent=overlay\nlocal corner=Instance.new(\"UICorner\")\ncorner.Parent=exitButton\nexitButton.Activated:Connect(function() exit:FireServer() end)\n\nlocal status=Instance.new(\"BillboardGui\")\nstatus.Name=\"GBloxEggStatus\"\nstatus.Size=UDim2.fromOffset(400,76)\nstatus.StudsOffsetWorldSpace=Vector3.new(0,13,0)\nstatus.AlwaysOnTop=true\nstatus.LightInfluence=0\nstatus.MaxDistance=18\nstatus.Enabled=false\nstatus.Parent=pg\nlocal statusFrame=Instance.new(\"Frame\")\nstatusFrame.Size=UDim2.fromScale(1,1)\nstatusFrame.BackgroundColor3=Color3.fromRGB(10,13,18)\nstatusFrame.BackgroundTransparency=.08\nstatusFrame.Parent=status\nlocal statusCorner=Instance.new(\"UICorner\")\nstatusCorner.CornerRadius=UDim.new(.22,0)\nstatusCorner.Parent=statusFrame\nlocal statusStroke=Instance.new(\"UIStroke\")\nstatusStroke.Color=Color3.fromRGB(24,241,255)\nstatusStroke.Thickness=2\nstatusStroke.Parent=statusFrame\nlocal statusText=Instance.new(\"TextLabel\")\nstatusText.Size=UDim2.new(1,-24,1,-12)\nstatusText.Position=UDim2.fromOffset(12,6)\nstatusText.BackgroundTransparency=1\nstatusText.TextColor3=Color3.new(1,1,1)\nstatusText.TextStrokeTransparency=.6\nstatusText.TextWrapped=true\nstatusText.TextScaled=true\nstatusText.Font=Enum.Font.GothamMedium\nstatusText.Parent=statusFrame\nlocal textLimit=Instance.new(\"UITextSizeConstraint\")\ntextLimit.MinTextSize=11\ntextLimit.MaxTextSize=18\ntextLimit.Parent=statusText\nlocal statusToken=0\n\nlocal function standFor(theme)\n for _,stand in CS:GetTagged(\"GBloxEggStand\") do\n  if stand:IsA(\"BasePart\") and stand:IsDescendantOf(workspace) and stand:GetAttribute(\"EggTheme\")==theme then return stand end\n end\nend\n\nlocal function showStatus(theme,text,bad,duration)\n local stand=standFor(theme)\n if not stand then return end\n statusToken+=1\n local token=statusToken\n status.Adornee=stand\n status.StudsOffsetWorldSpace=Vector3.new(0,13,0)\n statusFrame.BackgroundColor3=bad and Color3.fromRGB(91,24,34) or Color3.fromRGB(10,13,18)\n statusStroke.Color=bad and Color3.fromRGB(255,91,112) or Color3.fromRGB(24,241,255)\n statusText.Text=text\n status.Enabled=true\n task.delay(duration or 2.7,function()\n  if statusToken==token then status.Enabled=false end\n end)\nend\n\n-- Show all outcomes before the player requests paid Orbit checkout.\nlocal orbitPanel=Instance.new(\"Frame\")\norbitPanel.Name=\"OrbitConfirmation\" orbitPanel.AnchorPoint=Vector2.new(.5,.5)\norbitPanel.Position=UDim2.fromScale(.5,.5) orbitPanel.Size=UDim2.new(.85,0,0,285)\norbitPanel.BackgroundColor3=Color3.fromRGB(3,39,57) orbitPanel.Visible=false orbitPanel.Parent=overlay\nlocal maximum=Instance.new(\"U