local function deactivateCopy(copy)
 local nodes=copy:GetDescendants() table.insert(nodes,copy)
 for _,o in nodes do
  local tags=CS:GetTags(o)
  if #tags>0 then o:SetAttribute("MigrationArchivedTags",H:JSONEncode(tags)) for _,tag in tags do CS:RemoveTag(o,tag) end end
  if o:IsA("LuaSourceContainer") then
   local saved=Instance.new("StringValue") saved.Name=o.Name.." SourceBackup" saved.Value=o.Source
   saved:SetAttribute("OriginalScriptClass",o.ClassName) saved:SetAttribute("OriginalScriptName",o.Name)
   if o:IsA("BaseScript") then saved:SetAttribute("OriginalDisabled",o.Disabled) end
   saved.Parent=o.Parent o:Destroy()
  end
  if o:IsA("SpawnLocation") then o:SetAttribute("MigrationSpawnWasEnabled",o.Enabled) o.Enabled=false end
 end
end
