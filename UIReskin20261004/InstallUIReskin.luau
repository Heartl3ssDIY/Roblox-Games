Transparency\" }) do\n\t\tconnect(record.connections, target:GetPropertyChangedSignal(property), refresh)\n\tend\n\tif target:IsA(\"TextButton\") or target:IsA(\"TextLabel\") then\n\t\tfor _, property in ipairs({ \"Text\", \"TextColor3\", \"TextTransparency\", \"TextStrokeTransparency\" }) do\n\t\t\tconnect(record.connections, target:GetPropertyChangedSignal(property), refresh)\n\t\tend\n\tend\n\tconnect(record.connections, target.AttributeChanged, refresh)\n\tconnect(record.connections, skin.AttributeChanged, refresh)\n\tlocal gradient = target:FindFirstChild(\"Progress\")\n\tif gradient and gradient:IsA(\"UIGradient\") then\n\t\tfor _, property in ipairs({ \"Color\", \"Transparency\", \"Offset\", \"Rotation\", \"Enabled\" }) do\n\t\t\tconnect(record.connections, gradient:GetPropertyChangedSignal(property), refresh)\n\t\tend\n\tend\n\tlocal outline = target:FindFirstChild(\"Outline\")\n\tif outline and outline:IsA(\"UIStroke\") then connect(record.connections, outline:GetPropertyChangedSignal(\"Enabled\"), refresh) end\n\tif target:IsA(\"GuiButton\") then\n\t\tconnect(record.connections, target.MouseEnter, function() record.hovering = true refresh() end)\n\t\tconnect(record.connections, target.MouseLeave, function() record.hovering = false record.pressed = false refresh() end)\n\t\tconnect(record.connections, target.MouseButton1Down, function() record.pressed = target.Active refresh() end)\n\t\tconnect(record.connections, target.MouseButton1Up, function() record.pressed = false refresh() end)\n\t\tconnect(record.connections, target.Activated, function() record.pressed = false refresh() end)\n\t\tconnect(record.connections, target:GetPropertyChangedSignal(\"Active\"), function()\n\t\t\tif not target.Active then record.pressed = false record.hovering = false end\n\t\t\trefresh()\n\t\tend)\n\t\tconnect(record.connections, target:GetPropertyChangedSignal(\"Visible\"), function()\n\t\t\tif not target.Visible then record.pressed = false record.hovering = false end\n\t\t\trefresh()\n\t\tend)\n\tend\n\tlocal function rebind(child)\n\t\tif child.Name ~= \"ReusableSkin\" and child.Name ~= \"Progress\" and child.Name ~= \"Outline\" and child.Name ~= \"LiveCaption\" and child.Name ~= \"SelectionMark\" then return end\n\t\trelease(target)\n\t\ttask.defer(function() if target:IsDescendantOf(gui) then bind(target) end end)\n\tend\n\tconnect(record.connections, target.ChildAdded, rebind)\n\tconnect(record.connections, target.ChildRemoved, rebind)\n\tconnect(record.connections, target.AncestryChanged, function()\n\t\tif not target:IsDescendantOf(gui) then release(target) end\n\tend)\n\trefresh()\nend\n\nconnect(connections, gui.DescendantAdded, function(descendant)\n\ttask.defer(function()\n\t\tif not alive or not descendant:IsDescendantOf(gui) then return end\n\t\tbind(descendant)\n\t\tlocal parent = descendant.Parent\n\t\tif parent and parent:IsA(\"GuiObject\") then bind(parent) end\n\tend)\nend)\n\nconnect(connections, script.Destroying, function()\n\talive = false\n\tfor target in pairs(records) do release(target) end\n\tfor _, connection in ipairs(connections) do connection:Disconnect() end\nend)\n\nfor _, descendant in ipairs(gui:GetDescendants()) do bind(descendant) end\n","builders":{"RemovePlaceholderContent":"return function()\n\tlocal RunService = game:GetService(\"RunService\")\n\tassert(not RunService:IsRunning(), \"Placeholder cleanup must run in Edit mode\")\n\tlocal StarterGui = game:GetService(\"StarterGui\")\n\tlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\tlocal shell = assert(StarterGui:FindFirstChild(\"PlaygroundShell\"), \"PlaygroundShell is missing\")\n\tlocal shop = assert(shell:FindFirstChild(\"ShopPanel\"), \"ShopPanel is missing\")\n\tlocal cards = assert(shop:FindFirstChild(\"Cards\"), \"Shop card container is missing\")\n\tlocal templates = assert(shell:FindFirstChild(\"Templates\"), \"Editable templates are missing\")\n\tlocal template = assert(templates:FindFirstChild(\"ItemCard\"), \"ItemCard template is missing\")\n\tlocal assets = assert(ReplicatedStorage:FindFirstChild(\"PlaygroundCosmeticAssets\"), \"Cosmetic asset folder is missing\")\n\tassert(assets:IsA(\"Folder\"), \"Cosmetic assets must remain a Folder\")\n\tlocal retired = {\n\t\tBubbleBee = true, CloudPup = true, Wave = true, Cheer = true,\n\t\tStar = true, Heart = true, SunsetTrail = true, RainbowTrail = true,\n\t\tSkyOutline = true, RainbowOutline = true, SnowPotion = true, StarWand = true,\n\t}\n\tlocal targets = { template }\n\tfor index = 1, 12 do\n\t\tlocal card = assert(cards:FindFirstChild(string.format(\"Slot%02d\", index)), \"An editable shop slot is missing\")\n\t\tassert(card:IsA(\"Frame\"), \"Shop slots must remain editable Frames\")\n\t\tlocal id = card:GetAttribute(\"CatalogId\")\n\t\tassert(id == nil or retired[id], \"A shop slot now contains a different item; preserve it before cleanup\")\n\t\ttable.insert(targets, card)\n\tend\n\tfor _, card in ipairs(targets) do\n\t\tlocal preview = assert(card:FindFirstChild(\"Preview\"), \"A card preview is missing\")\n\t\tassert(preview:IsA(\"ViewportFrame\"), \"Card previews must remain ViewportFrames\")\n\t\tassert(preview:FindFirstChild(\"World\") and preview.World:IsA(\"WorldModel\"), \"A card WorldModel is missing\")\n\t\tlocal camera = preview:FindFirstChild(\"Camera\")\n\t\tassert(camera == nil or camera:IsA(\"Camera\"), \"A card Camera has an unexpected type\")\n\tend\n\tlocal report = { assetsRemoved = 0, previewModelsRemoved = 0, previewPedestalsRemoved = 0, effectsRemoved = 0, emptySlots = 12, templates = 1 }\n\tfor _, object in ipairs(assets:GetChildren()) do\n\t\tif object:IsA(\"Model\") and retired[object.Name] and object:GetAttribute(\"CatalogId\") == object.Name then\n\t\t\tobject:Destroy()\n\t\t\treport.assetsRemoved += 1\n\t\tend\n\tend\n\tfor _, card in ipairs(targets) do\n\t\tcard:SetAttribute(\"CatalogId\", nil)\n\t\tcard:SetAttribute(\"Category\", nil)\n\t\tcard:SetAttribute(\"EmptyShopSlot\", true)\n\t\tfor _, name in ipairs({ \"Name\", \"Price\", \"Category\", \"Action\", \"Try\" }) do\n\t\t\tlocal object = card:FindFirstChild(name)\n\t\t\tif object then\n\t\t\t\tif object:IsA(\"TextLabel\") or object:IsA(\"TextButton\") or object:IsA(\"TextBox\") then object.Text = \"\" end\n\t\t\t\tfor _, label in ipairs(object:GetDescendants()) do\n\t\t\t\t\tif label:IsA(\"TextLabel\") or label:IsA(\"TextButton\") or label:IsA(\"TextBox\") then label.Text = \"\" end\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tfor _, name in ipairs({ \"Action\", \"Try\" }) do\n\t\t\tlocal button = card:FindFirstChild(name)\n\t\t\tif button and button:IsA(\"GuiButton\") then\n\t\t\t\tbutton.Active = false\n\t\t\t\tbutton.Selectable = false\n\t\t\t\tbutton.AutoButtonColor = false\n\t\t\t\tbutton.Visible = false\n\t\t\tend\n\t\tend\n\t\tlocal preview = card.Preview\n\t\tfor _, object in ipairs(preview.World:GetChildren()) do\n\t\t\tif object:IsA(\"Model\") and object.Name == \"ItemModel\" and retired[object:GetAttribute(\"CatalogId\")] then\n\t\t\t\tobject:Destroy()\n\t\t\t\treport.previewModelsRemoved += 1\n\t\t\telseif object:IsA(\"BasePart\") and object.Name == \"PreviewPedestal\" then\n\t\t\t\tobject:Destroy()\n\t\t\t\treport.previewPedestalsRemoved += 1\n\t\t\tend\n\t\tend\n\t\tlocal camera = preview:FindFirstChild(\"Camera\") or preview.CurrentCamera\n\t\tif not camera then\n\t\t\tcamera = Instance.new(\"Camera\")\n\t\t\tcamera.Name = \"Camera\"\n\t\t\tcamera.FieldOfView = 32\n\t\t\tcamera.CFrame = CFrame.lookAt(Vector3.new(0, 1, 5), Vector3.zero)\n\t\t\tcamera.Parent = preview\n\t\tend\n\t\tpreview.CurrentCamera = camera\n\t\tcard.Visible = card ~= template\n\tend\n\tlocal effects = workspace:FindFirstChild(\"PlaygroundCosmeticEffects\")\n\tif effects then\n\t\tfor _, object in ipairs(effects:GetChildren()) do\n\t\t\tif object:IsA(\"Model\") and retired[object:GetAttribute(\"CatalogId\")] then\n\t\t\t\tobject:Destroy()\n\t\t\t\treport.effectsRemoved += 1\n\t\t\tend\n\t\tend\n\tend\n\tlocal status = shop:FindFirstChild(\"Status\")\n\tif status and status:IsA(\"TextLabel\") then status.Text = \"Items are being added.\" end\n\treturn report\nend\n","ApplyScreenSkins":"return function(assets, plan)\n\tassert(not game:GetService(\"RunService\"):IsRunning(), \"Screen skins must be authored in Edit mode\")\n\tlocal StarterGui = game:GetService(\"StarterGui\")\n\tlocal HttpService = game:GetService(\"HttpService\")\n\tlocal report = { skins = 0, captions = 0, textOutlines = 0, icons = 0, libraryAssets = 0, removedArtwork = 0, hiddenShadows = 0, nativeColourFills = 0, missingIcons = {} }\n\tlocal roots = {}\n\tlocal styledText = {}\n\tlocal mappings = plan.mappings or {}\n\tlocal mappingByPath = {}\n\tfor _, mapping in ipairs(mappings) do mappingByPath[mapping.path] = mapping end\n\tlocal textInk = Color3.fromRGB(24, 30, 51)\n\tlocal textFill = Color3.fromRGB(255, 249, 224)\n\n\tlocal function resolve(path)\n\t\tlocal current = game\n\t\tfor segment in string.gmatch(path, \"[^.]+\") do\n\t\t\tif segment ~= \"game\" then\n\t\t\t\tcurrent = current and current:FindFirstChild(segment)\n\t\t\tend\n\t\tend\n\t\treturn current\n\tend\n\n\tlocal function imageId(key)\n\t\tlocal value = assets[key]\n\t\tif typeof(value) == \"table\" then value = value.imageId or value.assetId or value.id or value.image or value.contentUri end\n\t\tif typeof(value) == \"number\" then return \"rbxassetid://\" .. tostring(value) end\n\t\tassert(typeof(value) == \"string\" and value ~= \"\", \"Missing uploaded image: \" .. tostring(key))\n\t\tif string.match(value, \"^%d+$\") then return \"rbxassetid://\" .. value end\n\t\treturn value\n\tend\n\n\tlocal function rememberRoot(target)\n\t\tlocal root = target:FindFirstAncestorOfClass(\"ScreenGui\")\n\t\tif root then roots[root] = true end\n\tend\n\n\tfor _, mapping in ipairs(mappings) do\n\t\tlocal target = assert(resolve(mapping.path), \"Skin target is missing: \" .. mapping.path)\n\t\tassert(target:IsA(\"GuiObject\"), \"Skin target is not a GuiObject: \" .. mapping.path)\n\t\timageId(mapping.asset)\n\t\tfor _, key in pairs(mapping.variantAssets or {}) do imageId(key) end\n\t\trememberRoot(target)\n\tend\n\tfor _, mapping in ipairs(plan.meterFills or {}) do\n\t\tlocal target = assert(resolve(mapping.path), \"Meter target is missing: \" .. mapping.path)\n\t\tassert(target:IsA(\"GuiObject\"), \"Meter target is not a GuiObject: \" .. mapping.path)\n\t\timageId(mapping.asset)\n\t\trememberRoot(target)\n\tend\n\n\tlocal function muteStrokes(target)\n\t\tfor _, child in ipairs(target:GetChildren()) do\n\t\t\tif child:IsA(\"UIStroke\") then child.Transparency = 1 end\n\t\tend\n\tend\n\n\tlocal function styleText(target)\n\t\tif not target:IsA(\"TextLabel\") and not target:IsA(\"TextButton\") then return end\n\t\tif target:GetAttribute(\"UISkinHiddenText\") == true then\n\t\t\ttarget.TextTransparency = 1\n\t\t\ttarget.TextStrokeTransparency = 1\n\t\t\tmuteStrokes(target)\n\t\t\treturn\n\t\tend\n\t\tmuteStrokes(target)\n\t\ttarget.Font = Enum.Font.FredokaOne\n\t\ttarget.TextColor3 = textFill\n\t\ttarget.TextTransparency = 0\n\t\ttarget.TextStrokeTransparency = 1\n\t\tlocal stroke = target:FindFirstChild(\"TextOutline\")\n\t\tif stroke and not stroke:IsA(\"UIStroke\") then stroke:Destroy() stroke = nil end\n\t\tif not stroke then\n\t\t\tstroke = Instance.new(\"UIStroke\")\n\t\t\tstroke.Name = \"TextOutline\"\n\t\t\tstroke.Parent = target\n\t\tend\n\t\tstroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual\n\t\tstroke.StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize\n\t\tstroke.Thickness = 0.085\n\t\tstroke.Color = textInk\n\t\tstroke.Transparency = 0\n\t\tstroke.LineJoinMode = Enum.LineJoinMode.Round\n\t\tstroke.Enabled = true\n\t\tif not styledText[target] then styledText[target] = true report.textOutlines += 1 end\n\tend\n\n\tfor root in pairs(roots) do\n\t\tfor _, object in ipairs(root:GetDescendants()) do\n\t\t\tif object.Parent then\n\t\t\t\tif object.Name == \"UserArtwork\" or object.Name == \"TextlessSkin\" or object.Name == \"LiveCaption\" or object.Name == \"UserArtworkController\" then\n\t\t\t\t\tobject:Destroy()\n\t\t\t\t\treport.removedArtwork += 1\n\t\t\t\telseif object:IsA(\"GuiObject\") and object.Name == \"Shadow\" then\n\t\t\t\t\tobject.Visible = false\n\t\t\t\t\treport.hiddenShadows += 1\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\tfor _, path in ipairs(plan.clearShadows or {}) do\n\t\tlocal shadow = resolve(path)\n\t\tif shadow and shadow:IsA(\"GuiObject\") then shadow.Visible = false end\n\tend\n\tfor _, path in ipairs(plan.clearIconFallbacks or {}) do\n\t\tlocal fallback = resolve(path)\n\t\tif fallback and fallback:IsA(\"GuiObject\") then fallback.Visible = false end\n\tend\n\n\tlocal function configureImage(image, mapping)\n\t\timage.Image = imageId(mapping.asset)\n\t\timage.ImageColor3 = Color3.new(1, 1, 1)\n\t\timage.ImageTransparency = 0\n\t\timage.BackgroundTransparency = 1\n\t\timage.BorderSizePixel = 0\n\t\timage.Active = false\n\t\timage.Selectable = false\n\t\timage:SetAttribute(\"AssetKey\", mapping.asset)\n\t\timage:SetAttribute(\"DefaultImage\", image.Image)\n\t\timage:SetAttribute(\"UISkinTargetPath\", mapping.path)\n\t\timage.ScaleType = mapping.mode == \"Slice\" and Enum.ScaleType.Slice or mapping.mode == \"Stretch\" and Enum.ScaleType.Stretch or Enum.ScaleType.Fit\n\t\tif mapping.sliceCenter then\n\t\t\tlocal rect = mapping.sliceCenter\n\t\t\timage.SliceCenter = Rect.new(rect[1], rect[2], rect[3], rect[4])\n\t\t\timage.SliceScale = mapping.sliceScale or 0.25\n\t\tend\n\t\tfor colour, key in pairs(mapping.variantAssets or {}) do image:SetAttribute(colour .. \"Image\", imageId(key)) end\n\tend\n\n\tlocal function captionBounds(caption, target, mapping)\n\t\tlocal rect = mapping.textFaceRect or { 0.065, 0.078, 0.87, 0.78 }\n\t\tcaption.AnchorPoint = Vector2.zero\n\t\tcaption.Position = UDim2.fromScale(rect[1], rect[2])\n\t\tcaption.Size = UDim2.fromScale(rect[3], rect[4])\n\t\tcaption.BackgroundTransparency = 1\n\t\tcaption.BorderSizePixel = 0\n\t\tcaption.TextXAlignment = Enum.TextXAlignment.Center\n\t\tcaption.TextYAlignment = Enum.TextYAlignment.Center\n\t\tcaption.TextScaled = true\n\t\tcaption.TextWrapped = true\n\t\tcaption.ZIndex = math.max(caption.ZIndex, target.ZIndex + 2)\n\t\tlocal constraint = caption:FindFirstChildOfClass(\"UITextSizeConstraint\")\n\t\tif not constraint then constraint = Instance.new(\"UITextSizeConstraint\") constraint.Parent = caption end\n\t\tlocal height = target.AbsoluteSize.Y > 0 and target.AbsoluteSize.Y or math.max(target.Size.Y.Offset, 48)\n\t\tlocal multiline = string.find(caption.Text, \"\\n\", 1, true) ~= nil\n\t\tconstraint.MinTextSize = 8\n\t\tconstraint.MaxTextSize = math.clamp(math.floor(height * (multiline and 0.5 or 0.6)), 12, multiline and 24 or 26)\n\t\tstyleText(caption)\n\tend\n\n\tlocal function applySkin(mapping)\n\t\tlocal target = resolve(mapping.path)\n\t\tif mapping.colourPolicy == \"PreserveNativeFill\" then\n\t\t\tlocal old = target:FindFirstChild(\"ReusableSkin\")\n\t\t\tif old then old:Destroy() end\n\t\t\ttarget:SetAttribute(\"UISkinManaged\", nil)\n\t\t\ttarget:SetAttribute(\"UISkinColourPolicy\", \"PreserveNativeFill\")\n\t\t\ttarget.BackgroundTransparency = 0\n\t\t\treport.nativeColourFills += 1\n\t\t\treturn\n\t\tend\n\t\ttarget.BackgroundTransparency = 1\n\t\ttarget.BorderSizePixel = 0\n\t\tmuteStrokes(target)\n\t\tlocal previous = target:FindFirstChild(\"ReusableSkin\")\n\t\tif previous then previous:Destroy() end\n\t\tlocal image = Instance.new(\"ImageLabel\")\n\t\timage.Name = \"ReusableSkin\"\n\t\tconfigureImage(image, mapping)\n\t\tif target:IsA(\"ViewportFrame\") then\n\t\t\tlocal name = target.Name .. \"ReusableSkin\"\n\t\t\tlocal oldBackground = target.Parent:FindFirstChild(name)\n\t\t\tif oldBackground and oldBackground:GetAttribute(\"UISkinTargetPath\") == mapping.path then oldBackground:Destroy() end\n\t\t\timage.Name = name\n\t\t\timage.Position = target.Position\n\t\t\timage.Size = target.Size\n\t\t\timage.AnchorPoint = target.AnchorPoint\n\t\t\timage.Rotation = target.Rotation\n\t\t\timage.LayoutOrder = target.LayoutOrder\n\t\t\timage.ZIndex = math.max(1, target.ZIndex - 1)\n\t\t\tif target.ZIndex <= image.ZIndex then target.ZIndex = image.ZIndex + 1 end\n\t\t\timage.Visible = target.Visible\n\t\t\timage.Parent = target.Parent\n\t\t\ttarget:SetAttribute(\"UISkinManaged\", nil)\n\t\telse\n\t\t\tfor _, child in ipairs(target:GetChildren()) do\n\t\t\t\tif child:IsA(\"GuiObject\") and child.ZIndex <= target.ZIndex then\n\t\t\t\t\tlocal shift = target.ZIndex + 1 - child.ZIndex\n\t\t\t\t\tchild.ZIndex += shift\n\t\t\t\t\tfor _, descendant in ipairs(child:GetDescendants()) do\n\t\t\t\t\t\tif descendant:IsA(\"GuiObject\") then descendant.ZIndex += shift end\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\timage.Size = UDim2.fromScale(1, 1)\n\t\t\timage.Position = UDim2.fromScale(0, 0)\n\t\t\timage.AnchorPoint = Vector2.zero\n\t\t\timage.ZIndex = target.ZIndex\n\t\t\timage.Parent = target\n\t\t\ttarget:SetAttribute(\"UISkinManaged\", true)\n\t\t\ttarget:SetAttribute(\"UISkinDynamic\", mapping.dynamic == true)\n\t\tend\n\t\ttarget:SetAttribute(\"UISkinAssetKey\", mapping.asset)\n\t\tlocal progress = target:FindFirstChild(\"Progress\")\n\t\tif progress and progress:IsA(\"UIGradient\") then progress:Clone().Parent = image end\n\t\tlocal caption = target:FindFirstChild(\"Caption\")\n\t\tif caption and caption:IsA(\"TextLabel\") then\n\t\t\tcaption.Visible = true\n\t\t\tcaptionBounds(caption, target, mapping)\n\t\t\tif target:IsA(\"TextButton\") or target:IsA(\"TextLabel\") then\n\t\t\t\ttarget:SetAttribute(\"UISkinHiddenText\", true)\n\t\t\t\ttarget.TextTransparency = 1\n\t\t\t\ttarget.TextStrokeTransparency = 1\n\t\t\tend\n\t\telseif target:IsA(\"TextButton\") or target:IsA(\"TextLabel\") then\n\t\t\tcaption = Instance.new(\"TextLabel\")\n\t\t\tcaption.Name = \"LiveCaption\"\n\t\t\tcaption.Text = target.Text\n\t\t\tcaption.RichText = target.RichText\n\t\t\tcaption.Visible = true\n\t\t\tcaption.Parent = target\n\t\t\tcaptionBounds(caption, target, mapping)\n\t\t\ttarget.TextColor3 = textFill\n\t\t\ttarget:SetAttribute(\"UISkinHiddenText\", true)\n\t\t\ttarget.TextTransparency = 1\n\t\t\ttarget.TextStrokeTransparency = 1\n\t\t\treport.captions += 1\n\t\tend\n\t\ttarget:SetAttribute(\"UISkinSelectionFromColour\", mapping.selectionFromColour == true)\n\t\ttarget:SetAttribute(\"UISkinSelectionFromOutline\", mapping.selectionFromOutline == true)\n\t\tif mapping.selectionFromColour or mapping.selectionFromOutline then\n\t\t\tlocal selection = target:FindFirstChild(\"SelectionMark\")\n\t\t\tif selection and not selection:IsA(\"TextLabel\") then selection:Destroy() selection = nil end\n\t\t\tif not selection then selection = Instance.new(\"TextLabel\") selection.Name = \"SelectionMark\" selection.Parent = target end\n\t\t\tselection.AnchorPoint = Vector2.new(1, 0)\n\t\t\tselection.Position = UDim2.new(1, -5, 0, 4)\n\t\t\tselection.Size = UDim2.fromOffset(18, 18)\n\t\t\tselection.BackgroundTransparency = 1\n\t\t\tselection.Text = \"✓\"\n\t\t\tselection.TextScaled = true\n\t\t\tselection.ZIndex = target.ZIndex + 3\n\t\t\tselection.Visible = false\n\t\t\tstyleText(selection)\n\t\tend\n\t\treport.skins += 1\n\tend\n\n\tfor _, mapping in ipairs(mappings) do applySkin(mapping) end\n\tfor _, mapping in ipairs(plan.meterFills or {}) do applySkin(mapping) end\n\n\tlocal function applyIcon(mapping)\n\t\tlocal target = resolve(mapping.path)\n\t\tif not target or not target:IsA(\"GuiObject\") then\n\t\t\ttable.insert(report.missingIcons, mapping.path)\n\t\t\treturn\n\t\tend\n\t\tlocal image\n\t\tif not mapping.createChild and (target:IsA(\"ImageLabel\") or target:IsA(\"ImageButton\")) then\n\t\t\timage = target\n\t\telse\n\t\t\tlocal childName = mapping.childName or \"ReusableIcon\"\n\t\t\tlocal old = target:FindFirstChild(childName)\n\t\t\tif old then old:Destroy() end\n\t\t\timage = Instance.new(\"ImageLabel\")\n\t\t\timage.Name = childName\n\t\t\tlocal rect = mapping.imageRect or (mapping.replaceBackground and { 0, 0, 1, 1 }) or { 0.14, 0.10, 0.72, 0.72 }\n\t\t\timage.AnchorPoint = Vector2.zero\n\t\t\timage.Position = UDim2.fromScale(rect[1], rect[2])\n\t\t\timage.Size = UDim2.fromScale(rect[3], rect[4])\n\t\t\timage.ZIndex = target.ZIndex + 2\n\t\t\timage.Parent = target\n\t\t\tif target:IsA(\"TextLabel\") or target:IsA(\"TextButton\") then\n\t\t\t\ttarget:SetAttribute(\"UISkinHiddenText\", true)\n\t\t\t\ttarget.TextTransparency = 1\n\t\t\t\ttarget.TextStrokeTransparency = 1\n\t\t\t\tmuteStrokes(target)\n\t\t\tend\n\t\t\tlocal caption = target:FindFirstChild(\"LiveCaption\")\n\t\t\tif caption and caption:IsA(\"GuiObject\") then caption.Visible = false end\n\t\tend\n\t\tconfigureImage(image, { asset = mapping.asset, mode = \"Fit\", path = mapping.path })\n\t\timage.Visible = true\n\t\tif mapping.replaceBackground then\n\t\t\ttarget.BackgroundTransparency = 1\n\t\t\tmuteStrokes(target)\n\t\t\tlocal skin = target:FindFirstChild(\"ReusableSkin\")\n\t\t\tif skin then skin:Destroy() end\n\t\tend\n\t\tfor _, path in ipairs(mapping.clearText or {}) do\n\t\t\tlocal label = resolve(path)\n\t\t\tif label and (label:IsA(\"TextLabel\") or label:IsA(\"TextButton\")) then\n\t\t\t\tlabel:SetAttribute(\"UISkinHiddenText\", true)\n\t\t\t\tlabel.TextTransparency = 1\n\t\t\t\tlabel.TextStrokeTransparency = 1\n\t\t\t\tlabel.Visible = false\n\t\t\t\tmuteStrokes(label)\n\t\t\tend\n\t\tend\n\t\tlocal iconParent = target.Parent\n\t\tif target.Name == \"Icon\" and iconParent:IsA(\"GuiButton\") then\n\t\t\ttarget.Visible = true\n\t\t\tlocal fallback = iconParent:FindFirstChild(\"IconFallback\")\n\t\t\tif fallback and fallback:IsA(\"GuiObject\") then fallback.Visible = false end\n\t\t\tlocal caption = iconParent:FindFirstChild(\"Caption\") or iconParent:FindFirstChild(\"LiveCaption\")\n\t\t\tif caption and caption:IsA(\"TextLabel\") then\n\t\t\t\tlocal face = mappingByPath[iconParent:GetFullName()]\n\t\t\t\tlocal rect = face and face.textFaceRect or { 0.065, 0.078, 0.87, 0.78 }\n\t\t\t\ttarget.AnchorPoint = Vector2.new(0, 0.5)\n\t\t\t\ttarget.Position = UDim2.fromScale(rect[1], rect[2] + rect[4] * 0.5)\n\t\t\t\ttarget.Size = UDim2.fromScale(rect[3] * 0.17, rect[4] * 0.7)\n\t\t\t\tcaption.Position = UDim2.fromScale(rect[1] + rect[3] * 0.22, rect[2])\n\t\t\t\tcaption.Size = UDim2.fromScale(rect[3] * 0.78, rect[4])\n\t\t\tend\n\t\tend\n\t\treport.icons += 1\n\tend\n\tfor _, mapping in ipairs(plan.icons or {}) do applyIcon(mapping) end\n\n\tfor root in pairs(roots) do\n\t\tfor _, object in ipairs(root:GetDescendants()) do styleText(object) end\n\tend\n\n\tlocal shell = assert(StarterGui:FindFirstChild(\"PlaygroundShell\"), \"PlaygroundShell is missing\")\n\tlocal templates = assert(shell:FindFirstChild(\"Templates\"), \"Editable templates are missing\")\n\tlocal oldLibrary = templates:FindFirstChild(\"AssetLibrary\")\n\tif oldLibrary then\n\t\tassert(oldLibrary:GetAttribute(\"UISkinAssetLibrary\") == true, \"Preserve the existing unrecognised AssetLibrary\")\n\t\toldLibrary:Destroy()\n\tend\n\tlocal library = Instance.new(\"Folder\")\n\tlibrary.Name = \"AssetLibrary\"\n\tlibrary:SetAttribute(\"UISkinAssetLibrary\", true)\n\tlibrary.Parent = templates\n\tlocal byImage = {}\n\tlocal allKeys = {}\n\tfor key in pairs(assets) do table.insert(allKeys, key) end\n\ttable.sort(allKeys)\n\tfor _, key in ipairs(allKeys) do\n\t\tlocal id = imageId(key)\n\t\tif not byImage[id] then byImage[id] = {} end\n\t\ttable.insert(byImage[id], key)\n\tend\n\tlocal metadata = plan.libraryAssets or {}\n\tlocal metadataByKey = {}\n\tfor key, entry in pairs(metadata) do\n\t\tif typeof(key) == \"string\" then metadataByKey[key] = entry\n\t\telseif typeof(entry) == \"table\" then\n\t\t\tlocal assetKey = entry.asset or entry.key or entry.png\n\t\t\tif assetKey then metadataByKey[assetKey] = entry end\n\t\tend\n\tend\n\tlocal groups = {}\n\tfor id, aliases in pairs(byImage) do table.insert(groups, { id = id, aliases = aliases }) end\n\ttable.sort(groups, function(a, b) return a.aliases[1] < b.aliases[1] end)\n\tfor _, group in ipairs(groups) do\n\t\tlocal key = group.aliases[1]\n\t\tlocal data = metadataByKey[key] or {}\n\t\tlocal sample = Instance.new(\"ImageLabel\")\n\t\tsample.Name = string.gsub(string.gsub(key, \"%.png$\", \"\"), \"[/\\\\]\", \"__\")\n\t\tconfigureImage(sample, { asset = key, mode = data.mode or \"Fit\", sliceCenter = data.sliceCenter, sliceScale = data.sliceScale })\n\t\tlocal size = data.logicalSize\n\t\tlocal width = size and size[1] or data.width and data.width / 4 or 128\n\t\tlocal height = size and size[2] or data.height and data.height / 4 or 80\n\t\tsample.Size = UDim2.fromOffset(width, height)\n\t\tsample.Visible = false\n\t\tsample:SetAttribute(\"Aliases\", HttpService:JSONEncode(group.aliases))\n\t\tif data.width then sample:SetAttribute(\"SourceWidth\", data.width) end\n\t\tif data.height then sample:SetAttribute(\"SourceHeight\", data.height) end\n\t\tsample.Parent = library\n\t\treport.libraryAssets += 1\n\tend\n\treturn report\nend\n","ApplyLeaderboardSkins":"return function(assets)\n\tassert(typeof(assets) == \"table\", \"Provide the uploaded artwork asset map\")\n\tlocal lobby = assert(workspace:FindFirstChild(\"Playground Lobby\"), \"Playground Lobby is missing\")\n\tlocal boards = assert(lobby:FindFirstChild(\"Leaderboards\"), \"Authored leaderboards are missing\")\n\tlocal ink = Color3.fromRGB(24, 30, 51)\n\tlocal light = Color3.fromRGB(255, 249, 224)\n\tlocal keys = { \"avatar-border\", \"board-background\", \"header-background\", \"player-row\", \"rank-bronze\", \"rank-fourth-onwards\", \"rank-gold\", \"rank-silver\" }\n\tlocal images = {}\n\tfor _, name in ipairs(keys) do\n\t\tlocal key = \"Leaderboard/\" .. name .. \".png\"\n\t\tlocal value = assets[key]\n\t\tassert(typeof(value) == \"string\" and value ~= \"\", \"Uploaded artwork is missing: \" .. key)\n\t\timages[name] = value\n\tend\n\tlocal function required(parent, name, className)\n\t\tlocal child = assert(parent:FindFirstChild(name), parent:GetFullName() .. \".\" .. name .. \" is missing\")\n\t\tassert(child:IsA(className), child:GetFullName() .. \" must be a \" .. className)\n\t\treturn child\n\tend\n\tlocal targets = {}\n\tfor _, name in ipairs({ \"HighestLevel\", \"MostWins\" }) do\n\t\tlocal model = required(boards, name, \"Model\")\n\t\tlocal gui = required(required(model, \"Face\", \"BasePart\"), \"Display\", \"SurfaceGui\")\n\t\tlocal header = required(gui, \"Header\", \"Frame\")\n\t\tlocal body = required(gui, \"Body\", \"Frame\")\n\t\tlocal rows = {}\n\t\tfor rank = 1, 10 do table.insert(rows, { row = required(body, string.format(\"Row%02d\", rank), \"Frame\"), rank = rank }) end\n\t\tlocal template = required(required(gui, \"Templates\", \"Folder\"), \"RowTemplate\", \"Frame\")\n\t\ttable.insert(rows, { row = template, rank = 4 })\n\t\tfor _, entry in ipairs(rows) do\n\t\t\trequired(entry.row, \"RankBadge\", \"Frame\")\n\t\t\trequired(entry.row, \"Avatar\", \"ImageLabel\")\n\t\t\tfor _, label in ipairs({ \"Rank\", \"PlayerName\", \"Value\" }) do required(entry.row, label, \"TextLabel\") end\n\t\tend\n\t\ttable.insert(targets, { gui = gui, header = header, body = body, rows = rows })\n\tend\n\tlocal imageCount = 0\n\tlocal glyphCount = 0\n\tlocal function clearBackground(target)\n\t\ttarget.BackgroundTransparency = 1\n\t\ttarget.BorderSizePixel = 0\n\t\tfor _, child in ipairs(target:GetChildren()) do\n\t\t\tif child:IsA(\"UIStroke\") then child.Enabled = false end\n\t\tend\n\tend\n\tlocal function image(parent, name, content, zIndex, key)\n\t\tlocal artwork = parent:FindFirstChild(name)\n\t\tassert(not artwork or artwork:IsA(\"ImageLabel\"), parent:GetFullName() .. \".\" .. name .. \" is not an ImageLabel\")\n\t\tif not artwork then\n\t\t\tartwork = Instance.new(\"ImageLabel\")\n\t\t\tartwork.Name = name\n\t\t\tartwork.Parent = parent\n\t\tend\n\t\tartwork.AnchorPoint = Vector2.zero\n\t\tartwork.Position = UDim2.fromScale(0, 0)\n\t\tartwork.Size = UDim2.fromScale(1, 1)\n\t\tartwork.BackgroundTransparency = 1\n\t\tartwork.BorderSizePixel = 0\n\t\tartwork.Image = content\n\t\tartwork.ImageColor3 = Color3.new(1, 1, 1)\n\t\tartwork.ImageTransparency = 0\n\t\tartwork.ScaleType = Enum.ScaleType.Fit\n\t\tartwork.ZIndex = zIndex\n\t\tartwork.Active = false\n\t\tartwork.Selectable = false\n\t\tartwork.Visible = true\n\t\tartwork:SetAttribute(\"UISkinAssetKey\", key)\n\t\tartwork:SetAttribute(\"UISkinPixelPolicy\", \"Original PNG; fit without distortion\")\n\t\timageCount += 1\n\t\treturn artwork\n\tend\n\tlocal function glyph(label)\n\t\tclearBackground(label)\n\t\tlabel.TextColor3 = light\n\t\tlabel.TextTransparency = 0\n\t\tlabel.TextStrokeTransparency = 1\n\t\tlabel.ZIndex = 15\n\t\tlocal outline = label:FindFirstChild(\"TextOutline\")\n\t\tassert(not outline or outline:IsA(\"UIStroke\"), label:GetFullName() .. \".TextOutline is not a UIStroke\")\n\t\tif not outline then\n\t\t\toutline = Instance.new(\"UIStroke\")\n\t\t\toutline.Name = \"TextOutline\"\n\t\t\toutline.Parent = label\n\t\tend\n\t\toutline.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual\n\t\toutline.StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize\n\t\toutline.Thickness = 0.085\n\t\toutline.Color = ink\n\t\toutline.Transparency = 0\n\t\toutline.LineJoinMode = Enum.LineJoinMode.Round\n\t\toutline.Enabled = true\n\t\tglyphCount += 1\n\tend\n\tfor _, target in ipairs(targets) do\n\t\tlocal gui, header, body = target.gui, target.header, target.body\n\t\tfor _, descendant in ipairs(gui:GetDescendants()) do\n\t\t\tif descendant:IsA(\"TextLabel\") then\n\t\t\t\tglyph(descendant)\n\t\t\telseif descendant:IsA(\"Frame\") or descendant:IsA(\"ImageLabel\") then\n\t\t\t\tclearBackground(descendant)\n\t\t\tend\n\t\tend\n\t\timage(gui, \"LeaderboardBoardArtwork\", images[\"board-background\"], 1, \"Leaderboard/board-background.png\")\n\t\theader.ZIndex = 5\n\t\tbody.ZIndex = 5\n\t\timage(header, \"LeaderboardHeaderArtwork\", images[\"header-background\"], 6, \"Leaderboard/header-background.pn