{
  "researchDate": "2026-10-04",
  "verifiedFacts": [
    {
      "fact": "A UIStroke parented directly to a TextLabel/TextButton and using Contextual outlines glyphs; Border outlines the rectangular GuiObject bounds.",
      "source": "https://create.roblox.com/docs/ui/appearance-modifiers#text-outline-or-border"
    },
    {
      "fact": "Custom BorderStrokePosition and BorderOffset apply only to border strokes. Contextual text strokes can only be placed on the outer text boundary.",
      "source": "https://devforum.roblox.com/t/full-release-uistroke-improvements-scaling-offsets-and-more/3958036/1"
    },
    {
      "fact": "Text fill transparency and UIStroke transparency are independent. Keep TextTransparency=0 to retain fill.",
      "source": "https://create.roblox.com/docs/reference/engine/classes/UIStroke#Transparency"
    },
    {
      "fact": "With StrokeSizingMode=ScaledSize on contextual text, Thickness is relative to font size.",
      "source": "https://create.roblox.com/docs/ui/appearance-modifiers#thickness"
    }
  ],
  "recommendedNativeSetup": {
    "parent": "The actual editable TextLabel or TextButton, not its image/frame background",
    "UIStroke.Name": "TextOutline",
    "UIStroke.ApplyStrokeMode": "Contextual",
    "UIStroke.ColorRGB": [
      24,
      30,
      51
    ],
    "UIStroke.Thickness": 0.09,
    "UIStroke.StrokeSizingMode": "ScaledSize",
    "UIStroke.Transparency": 0,
    "UIStroke.LineJoinMode": "Round",
    "TextColorRGB": [
      255,
      249,
      224
    ],
    "TextTransparency": 0,
    "TextStrokeTransparency": 1,
    "BackgroundTransparency": 1,
    "Font": "FredokaOne",
    "TextScaled": "Keep existing authored policy; add or retain UITextSizeConstraint where necessary. Do not alter layout each frame.",
    "BorderStrokePosition": "Leave unused for glyph strokes; changing this does not move the glyph outline.",
    "fallbackIfScaledSizeUnavailable": "FixedSize, Thickness=1.5 for 14\u201317px text, 1.8 for 18\u201322px text, 2.2 for 24\u201332px text."
  },
  "implementationGuidance": [
    "Author exactly one contextual UIStroke per text element. Remove or disable older duplicate contextual strokes and legacy TextStroke rather than layering ambiguous outlines.",
    "Do not add a new panel-border UIStroke to simulate the requested glyph stroke; the provided PNG already includes its perimeter artwork.",
    "Do not use UIStroke with TextTransparency=1 for filled captions, since that explicitly produces hollow lettering.",
    "Avoid UIStroke thickness tweens; animate button image/state or overall control feedback instead.",
    "Use padding or authored child-label bounds to center on coloured face, which is above the full asset midpoint due to the lower bevel.",
    "The exact measured centres apply inside the rendered image rectangle. If ScaleType=Fit letterboxes inside a different-aspect parent, offset and scale the text rectangle with the actual fitted image rectangle; do not blindly center on the whole click target.",
    "For a parent rectangle W,H and source w,h: fitScale=min(W/w,H/h); imageOrigin=((W-w*fitScale)/2,(H-h*fitScale)/2); textRect=imageOrigin+logicalRect*fitScale.",
    "Alternative for varying target proportions: use group 07 nine-slice and native text on a consistent authored inset, avoiding mismatched Fit artwork.",
    "Suggested native text sizes are visual starting points. Roblox font line metrics differ from SVG glyph-bound centering, so do not apply old Text-Centring-Checks verticalAdjustment values directly.",
    "Leave leaderboard artwork untouched this turn; user will provide it later."
  ],
