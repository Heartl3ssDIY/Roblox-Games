ultiplier=45,TrophyMultiplier=20},\n  },\n },\n}\n\nCatalog.Opening = {\n Spark = \"rbxassetid://103737951311976\",\n Velocity = {\n  \"rbxassetid://128676837374186\",\n  \"rbxassetid://138854897765218\",\n  \"rbxassetid://128496864395216\",\n  \"rbxassetid://133030657838744\",\n  \"rbxassetid://99880644189999\",\n  \"rbxassetid://94597648184890\",\n },\n Gravity = {\n  \"rbxassetid://114188471232462\",\n  \"rbxassetid://79217935565198\",\n  \"rbxassetid://124591957638176\",\n  \"rbxassetid://80061515965879\",\n  \"rbxassetid://72926086167349\",\n  \"rbxassetid://116841699008366\",\n },\n Orbit = {\n  \"rbxassetid://122733989131983\",\n  \"rbxassetid://123575872940346\",\n  \"rbxassetid://84901891964346\",\n  \"rbxassetid://83845824871293\",\n  \"rbxassetid://88492685733440\",\n  \"rbxassetid://94717795756304\",\n },\n}\n\nCatalog.PetImages = {\n Horse=\"rbxassetid://97781987204644\",\n Bloodhound=\"rbxassetid://75976480293805\",\n Hare=\"rbxassetid://82956031277145\",\n Lion=\"rbxassetid://119806516622045\",\n Cheetah=\"rbxassetid://72212484186330\",\n Ostrich=\"rbxassetid://102986685759691\",\n Hummingbird=\"rbxassetid://83988523807505\",\n Bat=\"rbxassetid://130819546758873\",\n Eagle=\"rbxassetid://83186220526952\",\n Falcon=\"rbxassetid://109620318086968\",\n Orca=\"rbxassetid://137191976906162\",\n Swordfish=\"rbxassetid://117774055452177\",\n Shark=\"rbxassetid://112453820735274\",\n Alien=\"rbxassetid://132832657593042\",\n}\n\nfunction Catalog.GetPet(petId)\n for eggName,egg in Catalog.Eggs do\n  for _,pet in egg.Pets do\n   if pet.Id==petId then return pet,eggName end\n  end\n end\nend\n\nreturn Catalog\n"))()
local function read(source,env) local fn=assert(loadstring(source)) setfenv(fn,setmetatable(env,{__index=getfenv()})) return fn() end
local R=read("local Catalog=C\nlocal Pets=P\nlocal M={}\nfunction M.Apply(profile,receipt,roll)\n local item=Catalog.Products[receipt.ProductId]\n local id=receipt.PurchaseId\n if not item or type(id)~=\"string\" or #id==0 or #id>128 then return false end\n profile.ProductReceipts=profile.ProductReceipts or {}\n if profile.ProductReceipts[id] then return true,false,profile.ProductReceipts[id] end\n local pet\n if item.Kind==\"Egg\" then\n  local egg=Pets.Eggs[item.Egg]\n  if not egg or type(roll)~=\"number\" or roll<0 or roll>=100 then return false end\n  local total=0\n  for _,candidate in egg.Pets do total+=candidate.Chance if roll<total then pet=candidate break end end\n  if not pet then return false end\n end\n -- No yields between the reward and its receipt marker. Save both together.\n if item.Kind==\"Cash\" then\n  profile.Cash+=item.Amount profile.TotalCashEarned+=item.Amount\n elseif item.Kind==\"Trophies\" then profile.Trophies+=item.Amount\n elseif item.Kind==\"Ability\" then\n  local a=profile.Abilities[item.Ability] or {Owned=true,Uses=0}\n  a.Owned=true a.Uses=math.max(0,tonumber(a.Uses) or 0)+item.Amount\n  profile.Abilities[item.Ability]=a\n elseif pet then\n  profile.Pets[pet.Id]=(profile.Pets[pet.Id] or 0)+1\n else return false end\n local marker={ProductId=receipt.ProductId,At=os.time(),Pet=pet and pet.Id}\n profile.ProductReceipts[id]=marker\n return true,true,marker\nend\nreturn M\n",{C=C,P=P})
local E=read("local Catalog=P\nlocal M={}\nfunction M.Slots(p)\n return p.CashPasses and p.CashPasses[\"1982264711\"]==true and 2 or 1\nend\nfunction M.Selected(p)\n local raw=type(p.EquippedPets)==\"table\" and table.clone(p.EquippedPets) or {}\n if type(p.EquippedPet)==\"string\" and p.EquippedPet~=\"\" then raw[1]=p.EquippedPet end\n local selected,counts={},{}\n for _,id in ipairs(raw) do\n  if type(id)==\"string\" and Catalog.GetPet(id) and (p.Pets[id] or 0)>(counts[id] or 0) then\n   table.insert(selected,id) counts[id]=(counts[id] or 0)+1\n   if #selected>=M.Slots(p) then break end\n  end\n end\n return selected\nend\nfunction M.Write(p,selected)\n p.EquippedPets=selected p.EquippedPet=selected[1] or \"\"\nend\nfunction M.Equip(p,id)\n if type(id)~=\"string\" or not Catalog.GetPet(id) or (p.Pets[id] or 0)<1 then return false,\"You do not own that pet.\" end\n local selected=M.Selected(p)\n if M.Slots(p)==1 then M.Write(p,{id}) return true,id..\" equipped.\" end\n if #selected>=M.Slots(p) then return false,\"Both slots are full. Unequip a pet first.\" end\n local count=0 for _,v in selected do if v==id then count+=1 end end\n if count>=(p.Pets[id] or 0) then return false,\"That pet is already equipped.\" end\n table.insert(selected,id) M.Write(p,selected) return true,id..\" equipped.\"\nend\nfunction M.Unequip(p,id)\n local selected=M.Selected(p)\n if not id or id==\"\" then table.clear(selected)\n else for i=#selected,1,-1 do if selected[i]==id then table.remove(selected,i) break end end end\n M.Write(p,selected) return true,\"Pet unequipped.\"\nend\nfunction M.Multipliers(p)\n local cash,trophies=1,1\n for _,id in M.Selected(p) do local pet=Catalog.GetPet(id) cash+=pet.CashMultiplier-1 trophies+=pet.TrophyMultiplier-1 end\n return cash,trophies\nend\nreturn M\n",{P=P})
local W=assert(loadstring("-- Preserve the existing match economy. Only the breakdown/display is new.\nlocal M={}\nfunction M.Rank(entries)\n table.sort(entries,function(a,b)\n  if math.abs(a.result.score-b.result.score)>.00001 then return a.result.score>b.result.score end\n  if a.result.time~=b.result.time then return a.result.time<b.result.time end\n  return a.player.UserId<b.player.UserId\n end)\n return entries\nend\nfunction M.Build(place,count,result,petId,pet,petList,cashPass,trophyPass)\n local rows={}\n local scale=math.clamp((count-1)*.2,0,1)\n local cash=math.floor(math.max(0,3000-place*500)*scale+.000001)\n local trophies=math.floor((({10,5,3})[place] or 0)*scale+.000001)\n local function add(label,c,t)\n  table.insert(rows,{label=label,cash=c,trophies=t}) \n end\n add(\"Placing \"..(({\"1st\",\"2nd\",\"3rd\",\"4th\",\"5th\",\"6th\"})[place] or tostring(place)),cash,trophies)\n if place<=3 then cash+=1000 add(\"Podium bonus\",1000,0) end\n if result.score>=49.999 then cash+=10000 trophies+=5 add(\"Perfect score\",10000,5) end\n if place==1 and not result.usedAbility then cash+=1500 add(\"Won without abilities\",1500,0) end\n if not result.died then cash+=5000 add(\"No deaths\",5000,0) end\n local cm,tm=1,1\n local totalCash,totalTrophies=cash,trophies\n petList=petList or (pet and {{Id=petId,CashMultiplier=pet.CashMultiplier,TrophyMultiplier=pet.TrophyMultiplier}} or {})\n for _,entry in petList do\n  cm+=entry.CashMultiplier-1 tm+=entry.TrophyMultiplier-1\n  local nextCash=math.floor(cash*cm+.5)\n  local nextTrophies=math.floor(trophies*tm+.5)\n  add(entry.Id..\" x\"..entry.CashMultiplier..\" cash\",nextCash-totalCash,0)\n  add(entry.Id..\" x\"..entry.TrophyMultiplier..\" trophies\",0,nextTrophies-totalTrophies)\n  totalCash,totalTrophies=nextCash,nextTrophies\n end\n cashPass=cashPass or 1 trophyPass=trophyPass or 1\n if cashPass>1 then\n  local boosted=math.floor(totalCash*cashPass+.5) add(\"Cash pass x\"..cashPass,boosted-totalCash,0) totalCash=boosted\n end\n if trophyPass>1 then\n  local boosted=math.floor(totalTrophies*trophyPass+.5) add(\"Trophy pass x\"..trophyPass,0,boosted-totalTrophies) totalTrophies=boosted\n end\n return {place=place,playerCount=count,time=result.time,deaths=result.deaths or (result.died and 1 or 0),\n  score=result.score,finishes=result.finishes,rows=rows,cash=totalCash,trophies=totalTrophies,\n  baseScale=scale,pet=petId,cashMultiplier=cm,trophyMultiplier=tm}\nend\nreturn M\n"))()
