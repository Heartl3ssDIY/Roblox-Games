layName\n    board.Description.Text = arena.description\n    board.Illustration.Visible = selected == 1\n    board.Locked.Visible = selected ~= 1\n    board.Locked.Text = \"ARENA \" .. arena.number .. \"\\nREADY TO VISIT\"\n    board.ProgressBorder.Visible = first\n    board.ProgressTrack.Visible = first\n    board.Progress.Visible = first\n    board.ProgressText.Visible = first\n    board.ProgressText.Text = string.format(\"%g/10\", value)\n    local fraction = math.clamp(value / 10, 0, 1)\n    local fill = board.Progress.FillClip\n    local loss = board.Progress.LossClip\n    local previous = fill.Size.X.Scale\n    if fillTween then fillTween:Cancel() end\n    if lossTween then lossTween:Cancel() end\n    if instant or not gui.Enabled then\n        fill.Size = UDim2.fromScale(fraction, 1)\n        loss.Size = fill.Size\n    else\n        loss.Size = UDim2.fromScale(math.max(previous, fraction), 1)\n        fillTween = TweenService:Create(fill, TweenInfo.new(.3, Enum.EasingStyle.Quad), {Size = UDim2.fromScale(fraction, 1)})\n        lossTween = TweenService:Create(loss, TweenInfo.new(.65, Enum.EasingStyle.Quad), {Size = UDim2.fromScale(fraction, 1)})\n        fillTween:Play()\n        lossTween:Play()\n    end\n    for index, milestone in ipairs(milestones) do\n        local icon = board.Milestones[\"Reward\" .. index]\n        icon.Visible = first\n        icon.Check.Visible = progress.claimed[milestone.points] == true\n    end\n    for index, reward in ipairs(PlayerData.dailyWinRewards()) do\n        local icon = board.DailyRewards[\"Reward\" .. index]\n        icon.Check.Visible = reward.earned and not reward.claimed\n        icon.Pack.ImageTransparency = reward.claimed and .6 or 0\n        icon.ImageTransparency = reward.claimed and .35 or 0\n    end\n    local pending = PlayerData.pendingDailyPack() ~= nil\n    board.Action.Image = pending and Assets.Claim or Assets.Battle\n    board.Action.Visible = pending or first\n    board.Teleport.Visible = not pending and not first\n    board.Teleport.Interactable = not teleporting and arena.teleportReady\n    board.Action.Interactable = not claiming and (pending or first)\n    board.Action.ImageTransparency = (pending or first) and 0 or .5\n    board.Back.Interactable = not claiming\n    board.Next.Interactable = not claiming\n    gui:SetAttribute(\"SelectedArena\", selected)\n    gui:SetAttribute(\"Action\", pending and \"Claim\" or (first and \"Battle\" or \"Teleport\"))\nend\n\nfunction ArenaSelectionUI.close()\n    if gui then gui.Enabled = false end\nend\n\nfunction ArenaSelectionUI.back()\n    if claiming or teleporting or visiting then return end\n    ArenaSelectionUI.close()\n    ModePickerUI.open()\nend\n\nfunction ArenaSelectionUI.nextArena()\n    if claiming then return end\n    selected = selected % ArenaCatalog.count() + 1\n    board.Notice.Visible = false\n    refresh(true)\nend\n\nfunction ArenaSelectionUI.activate()\n    if claiming or not gui or not gui.Enabled then return false end\n    local pending = PlayerData.pendingDailyPack()\n    if pending then\n        claiming = true\n        local result = PackOpening.roll(pending.packId)\n        if not result then\n            claiming = false\n            Feedback.play(\"Unavailable\")\n            notify(\"This pack cannot be opened yet.\")\n            return false\n        end\n        if not PlayerData.consumeDailyPack() then claiming = false; refresh(true); return false end\n        PackOpening.apply(result)\n        Feedback.play(\"Confirm\")\n        gui.Enabled = false\n        PackReveal.play(playerGui, result, function()\n            claiming = false\n            ArenaSelectionUI.open(playerGui)\n        end)\n        return true\n    end\n    local arena = ArenaCatalog.get(selected)\n    if not arena or not arena.matchReady then return false end\n    if Loadout.count() < 4 then\n        Feedback.play(\"Unavailable\")\n        notify(\"Equip 4 units before battling.\")\n        return false\n    end\n    gui.Enabled = false\n    ReplicatedStorage:WaitForChild(\"ArenaEvents\"):WaitForChild(\"EnterArena\"):Fire(arena.modelName)\n    return true\nend\n\nfunction ArenaSelectionUI.teleport()\n    if claiming or teleporting or visiting or not gui or not gui.Enabled then return false end\n    local arena = ArenaCatalog.get(selected)\n    if not arena or not arena.teleportReady then return false end\n    teleporting = true\n    board.Teleport.Interactable = false\n    local success, message = ArenaTravelClient.visit(arena.modelName)\n    teleporting = false\n    if not success then refresh(true); notify(message or \"Teleport is unavailable.\"); return false end\n    visiting = true\n    for _, screen in ipairs(playerGui:GetChildren()) do\n        if screen:IsA(\"ScreenGui\") and screen ~= gui and screen.Name ~= \"TouchGui\" then\n            hiddenVisitGuis[screen] = screen.Enabled\n            screen.Enabled = false\n        end\n    end\n    board.Visible = false\n    gui.ReturnToLobby.Visible = true\n    return true\nend\n\nfunction ArenaSelectionUI.returnFromVisit()\n    if not visiting or teleporting then return end\n    teleporting = true\n    local success, message = ArenaTravelClient.leave()\n    teleporting = false\n    if not success then warn(message); return end\n    visiting = false\n    restoreVisitGuis()\n    gui.ReturnToLobby.Visible = false\n    board.Visible = true\n    ArenaSelectionUI.open(playerGui)\nend\n\nfunction ArenaSelectionUI.build(pg)\n    if gui then return gui end\n    playerGui = pg\n    gui = pg:WaitForChild(\"ArenaSelectGui\")\n    board = gui.Board\n    local outline = board:FindFirstChild(\"TitleWhiteOutline\")\n    if outline then\n        local function syncTitle()\n            outline.Text = board.Title.Text\n            outline.Visible = board.Title.Visible\n        end\n        board.Title:GetPropertyChangedSignal(\"Text\"):Connect(syncTitle)\n        board.Title:GetPropertyChangedSignal(\"Visible\"):Connect(syncTitle)\n        syncTitle()\n    end\n    Feedback.bind(gui)\n    board.Back.Activated:Connect(ArenaSelectionUI.back)\n    board.Next.Activated:Connect(ArenaSelectionUI.nextArena)\n    board.Action.Activated:Connect(ArenaSelectionUI.activate)\n    board.Teleport.Activated:Connect(ArenaSelectionUI.teleport)\n    gui.ReturnToLobby.Activated:Connect(ArenaSelectionUI.returnFromVisit)\n    Players.LocalPlayer.CharacterRemoving:Connect(function()\n        if not visiting then return end\n        visiting = false\n        teleporting = false\n        restoreVisitGuis()\n        ArenaTravelClient.restore()\n        gui.ReturnToLobby.Visible = false\n        board.Visible = true\n        gui.Enabled = false\n    end)\n    for index, milestone in ipairs(milestones) do\n        local icon = board.Milestones[\"Reward\" .. index]\n        icon.Activated:Connect(function() notify(milestone.description) end)\n    end\n    for index = 1, 4 do\n        local icon = board.DailyRewards[\"Reward\" .. index]\n        icon.Activated:Connect(function()\n            local reward = PlayerData.dailyWinRewards()[index]\n            notify(reward.claimed and \"Pack claimed.\"\n                or (reward.earned and \"Pack earned. Press Claim to open it.\"\n                or (\"Daily win \" .. index .. \": \" .. (index == 4 and \"Silver\" or \"Common\") .. \" Unit Pack\")))\n        end)\n    end\n    PlayerData.Changed:Connect(function() refresh(false) end)\n    gui:GetPropertyChangedSignal(\"AbsoluteSize\"):Connect(fit)\n    gui:GetPropertyChangedSignal(\"AbsolutePosition\"):Connect(fit)\n    task.spawn(function()\n        local previousRemaining = PlayerData.dailyWinPacksRemaining()\n        while gui.Parent do\n            task.wait(1)\n            local remaining = PlayerData.dailyWinPacksRemaining()\n            if remaining ~= previousRemaining then refresh(true); previousRemaining = remaining end\n        end\n    end)\n    refresh(true)\n    fit()\n    return gui\nend\n\nfunction ArenaSelectionUI.open(pg)\n    ArenaSelectionUI.build(pg or Players.LocalPlayer.PlayerGui)\n    if claiming or visiting then return end\n    ModePickerUI.close()\n    board.Notice.Visible = false\n    refresh(true)\n    fit()\n    gui.Enabled = true\nend\n\nreturn ArenaSelectionUI\n"},{"name":"ArenaTravelService","source":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ArenaCatalog = require(ReplicatedStorage:WaitForChild(\"ArenaCatalog\"))\nlocal ArenaConfig = require(ReplicatedStorage:WaitForChild(\"ArenaConfig\"))\nlocal LobbyConfig = require(ReplicatedStorage:WaitForChild(\"LobbyConfig\"))\nlocal events = ReplicatedStorage:WaitForChild(\"ArenaEvents\")\nlocal travel = events:WaitForChild(\"TravelRequest\")\nassert(travel:IsA(\"RemoteFunction\"), \"ArenaEvents.TravelRequest must be a RemoteFunction\")\n\nlocal visits = {}\nlocal lastRequest = {}\nlocal actions = { Enter = true, Visit = true, Leave = true, LobbyPortal = true, PackPortal = true, Destination = true }\n\nlocal function finite(value)\n\treturn type(value) == \"number\" and value == value and math.abs(value) < math.huge\nend\n\nlocal function numberSetting(key, fallback)\n\tlocal value = LobbyConfig[key]\n\treturn finite(value) and value >= 0 and value or fallback\nend\n\nlocal function validName(value)\n\treturn type(value) == \"string\" and #value > 0 and #value <= 128\nend\n\nlocal function getCharacter(player)\n\tlocal character = player.Character\n\tlocal humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n\tlocal root = character and character:FindFirstChild(\"HumanoidRootPart\")\n\tif not humanoid or humanoid.Health <= 0 or not root or not root:IsA(\"BasePart\") then return nil end\n\treturn root, humanoid\nend\n\nlocal function moveRoot(root, target)\n\troot.AssemblyLinearVelocity = Vector3.zero\n\troot.AssemblyAngularVelocity = Vector3.zero\n\troot.CFrame = target\nend\n\nlocal function rootClearance(root, humanoid)\n\tlocal fallback = numberSetting(\"RootClearance\", 3.5)\n\tlocal halfRoot = root.Size.Y * 0.5\n\tlocal hipHeight = humanoid.HipHeight\n\tif not finite(halfRoot) or halfRoot <= 0 or not finite(hipHeight) or hipHeight < 0 then return fallback end\n\tif humanoid.RigType == Enum.HumanoidRigType.R6 and hipHeight <= 0.001 then\n\t\tlocal leg = root.Parent:FindFirstChild(\"Right Leg\") or root.Parent:FindFirstChild(\"Left Leg\")\n\t\tif not leg or not leg:IsA(\"BasePart\") or not finite(leg.Size.Y) or leg.Size.Y <= 0 then return fallback end\n\t\treturn halfRoot + leg.Size.Y\n\tend\n\treturn halfRoot + hipHeight\nend\n\nlocal function lobbyRoot()\n\tlocal name = LobbyConfig.RootName\n\treturn validName(name) and workspace:FindFirstChild(name) or nil\nend\n\nlocal function markerAt(lobby, name)\n\tif not validName(name) then return nil end\n\tlocal markers = lobby:FindFirstChild(\"Markers\")\n\tlocal marker = markers and markers:FindFirstChild(name)\n\treturn marker and marker:IsA(\"BasePart\") and marker or nil\nend\n\nlocal function finitePosition(position)\n\treturn finite(position.X) and finite(position.Y) and finite(position.Z)\nend\n\nlocal function lobbyTarget(root, humanoid, destination)\n\tlocal definitions = LobbyConfig.Destinations\n\tlocal entry = type(definitions) == \"table\" and definitions[destination] or nil\n\tif type(entry) ~= \"table\" or not validName(entry.marker) then return nil, \"Unknown destination\" end\n\tif entry.lookAt ~= nil and not validName(entry.lookAt) then return nil, \"Destination is unavailable\" end\n\tlocal lobby = lobbyRoot()\n\tif not lobby then return nil, \"Lobby is unavailable\" end\n\tlocal marker = markerAt(lobby, entry.marker)\n\tif not marker or not finitePosition(marker.Position) then return nil, \"Destination is unavailable\" end\n\tlocal lookAt = entry.lookAt and markerAt(lobby, entry.lookAt) or nil\n\tif entry.lookAt and (not lookAt or not finitePosition(lookAt.Position)) then\n\t\treturn nil, \"Destination is unavailable\"\n\tend\n\tlocal floor = marker.Position\n\tlocal position = floor + Vector3.new(0, rootClearance(root, humanoid) + numberSetting(\"SafeLandingOffset\", 0.12), 0)\n\tlocal direction = lookAt and lookAt.Position - floor or marker.CFrame.LookVector\n\tdirection = Vector3.new(direction.X, 0, direction.Z)\n\tif direction.Magnitude <= 0.001 then\n\t\tdirection = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)\n\tend\n\tif direction.Magnitude <= 0.001 then direction = Vector3.new(0, 0, -1) end\n\treturn CFrame.lookAt(position, position + direction.Unit)\nend\n\nlocal function clearVisit(player, root, returnToLobby)\n\tlocal visit = visits[player]\n\tif visit then\n\t\tlocal visitedRoot = visit.root\n\t\tif visitedRoot.Parent then\n\t\t\tif returnToLobby and root == visitedRoot then moveRoot(visitedRoot, visit.returnCFrame) end\n\t\t\tvisitedRoot.Anchored = visit.wasAnchored\n\t\tend\n\tend\n\tvisits[player] = nil\n\tplayer:SetAttribute(\"ActiveArena\", nil)\n\tplayer:SetAttribute(\"ArenaVisitOnly\", nil)\nend\n\nlocal function arenaEntry(destination)\n\tif destination == nil then destination = ArenaConfig.arenaName end\n\tif not validName(destination) and not (finite(destination) and destination >= 1 and destination % 1 == 0) then\n\t\treturn nil\n\tend\n\treturn ArenaCatalog.find(destination)\nend\n\ntravel.OnServerInvoke = function(player, action, destination)\n\tif type(action) ~= \"string\" or not actions[action] then return false, \"Unknown destination\" end\n\tif action == \"Leave\" then\n\t\tif destination ~= nil then return false, \"Unknown destination\" end\n\t\tclearVisit(player, getCharacter(player), true)\n\t\treturn true\n\tend\n\tlocal destinationKey\n\tlocal entry\n\tif action == \"Destination\" then\n\t\tif not validName(destination) then return false, \"Unknown destination\" end\n\t\tdestinationKey = destination\n\telseif action == \"LobbyPortal\" or action == \"PackPortal\" then\n\t\tif destination ~= nil then return false, \"Unknown destination\" end\n\t\tdestinationKey = action == \"LobbyPortal\" and \"MainMode\" or \"Packs\"\n\telse\n\t\tentry = arenaEntry(destination)\n\t\tif not entry then return false, \"Unknown arena\" end\n\tend\n\tlocal root, humanoid = getCharacter(player)\n\tif not root then return false, \"Your character is not ready\" end\n\tlocal visit = visits[player]\n\tif visit then\n\t\tif entry and visit.root == root and visit.arenaName == entry.modelName and visit.action == action then\n\t\t\treturn true\n\t\tend\n\t\treturn false, \"Leave the match first\"\n\tend\n\tlocal now = os.clock()\n\tlocal previous = lastRequest[player]\n\tif previous and now - previous < numberSetting(\"RequestCooldown\", 0.4) then return false, \"Please wait\" end\n\tif destinationKey then\n\t\tlocal target, message = lobbyTarget(root, humanoid, destinationKey)\n\t\tif not target then return false, message end\n\t\tmoveRoot(root, target)\n\t\tlastRequest[player] = now\n\t\treturn true\n\tend\n\tlocal arena = ArenaConfig.getArena(entry.modelName)\n\tif not arena or arena:GetAttribute(\"TeleportReady\") ~= true then return false, \"Arena is unavailable\" end\n\tif action == \"Enter\" and arena:GetAttribute(\"MatchReady\") ~= true then\n\t\treturn false, \"This arena is available for visits only\"\n\tend\n\tlocal sidelines = arena:FindFirstChild(\"Sidelines\")\n\tlocal spawn = sidelines and sidelines:FindFirstChild(\"Spawn_Player\")\n\tif not spawn or not spawn:IsA(\"BasePart\") or not finitePosition(spawn.Position) then\n\t\treturn false, \"Arena spawn is missing\"\n\tend\n\tlocal target = spawn.CFrame * CFrame.new(0, 3, 0)\n\tvisits[player] = {\n\t\troot = root, returnCFrame = root.CFrame, wasAnchored = root.Anchored,\n\t\tarenaName = entry.modelName, action = action,\n\t}\n\troot.Anchored = action == \"Enter\"\n\tmoveRoot(root, target)\n\tplayer:SetAttribute(\"ActiveArena\", arena.Name)\n\tplayer:SetAttribute(\"ArenaVisitOnly\", action == \"Visit\")\n\tlastRequest[player] = now\n\treturn true\nend\n\nlocal function setupPlayer(player)\n\tplayer.CharacterRemoving:Connect(function()\n\t\tclearVisit(player, nil, false)\n\t\tlastRequest[player] = nil\n\tend)\nend\n\nPlayers.PlayerAdded:Connect(setupPlayer)\nPlayers.PlayerRemoving:Connect(function(player)\n\tclearVisit(player, nil, false)\n\tlastRequest[player] = nil\nend)\nfor _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end","parent":"ServerScriptService","path":"ServerScriptService.ArenaTravelService","class":"Script","before":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ArenaConfig = require(ReplicatedStorage:WaitForChild(\"ArenaConfig\"))\nlocal events = ReplicatedStorage:WaitForChild(\"ArenaEvents\")\nlocal travel = events:FindFirstChild(\"TravelRequest\") or Instance.new(\"RemoteFunction\")\ntravel.Name = \"TravelRequest\"\ntravel.Parent = events\n\nlocal visits = {}\nlocal lastRequest = {}\n\nlocal function getRoot(player)\n\tlocal character = player.Character\n\tlocal humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n\tif not humanoid or humanoid.Health <= 0 then return nil end\n\treturn character:FindFirstChild(\"HumanoidRootPart\")\nend\n\nlocal function moveRoot(root, target)\n\troot.AssemblyLinearVelocity = Vector3.zero\n\troot.AssemblyAngularVelocity = Vector3.zero\n\troot.CFrame = target\nend\n\nlocal function lobbySpawn()\n\tlocal lobby = workspace:FindFirstChild(\"Lobby_MainModeZone\")\n\treturn lobby and lobby:FindFirstChild(\"MainModeSpawn\", true)\nend\n\nlocal function leaveArena(player, root)\n\tlocal visit = visits[player]\n\tif visit and root == visit.root then\n\t\tmoveRoot(root, visit.returnCFrame)\n\t\troot.Anchored = visit.wasAnchored\n\tend\n\tvisits[player] = nil\n\tplayer:SetAttribute(\"ActiveArena\", nil)\n    player:SetAttribute(\"ArenaVisitOnly\", nil)\n\treturn true\nend\n\ntravel.OnServerInvoke = function(player, action, destination)\n\tlocal root = getRoot(player)\n\tif action == \"Leave\" then return leaveArena(player, root) end\n\tif not root then return false, \"Your character is not ready\" end\n\tif action ~= \"Enter\" and action ~= \"LobbyPortal\" and action ~= \"PackPortal\" and action ~= \"Destination\" and action ~= \"Visit\" then return false, \"Unknown destination\" end\n\tlocal now = os.clock()\n\tif now - (lastRequest[player] or 0) < 0.4 then return false, \"Please wait\" end\n\tlastRequest[player] = now\n\tif action == \"Destination\" then\n\t\tif visits[player] then return false, \"Leave the match first\" end\n\t\tif destination ~= \"Ranked\" and destination ~= \"PvP\" and destination ~= \"Clans\" then\n\t\t\treturn false, \"Unknown destination\"\n\t\tend\n\t\tlocal lobby = workspace:FindFirstChild(\"Lobby_MainModeZone\")\n\t\tlocal destinations = lobby and lobby:FindFirstChild(\"Destinations\")\n\t\tlocal marker = destinations and destinations:FindFirstChild(destination)\n\t\tif not marker then return false, \"Destination is unavailable\" end\n\t\tmoveRoot(root, CFrame.lookAt(marker.Position, Vector3.new(0, marker.Position.Y, 4)))\n\t\treturn true\n\tend\n\tif action == \"PackPortal\" then\n\t\tif visits[player] then return false, \"Leave the match first\" end\n\t\tlocal lobby = workspace:FindFirstChild(\"Lobby_MainModeZone\")\n\t\tlocal zone = lobby and lobby:FindFirstChild(\"Lobby_PackShopZone\")\n\t\tlocal trigger = zone and zone:FindFirstChild(\"PackShopTrigger\")\n\t\tif not trigger then return false, \"Pack shop is unavailable\" end\n\t\tmoveRoot(root, trigger.CFrame)\n\t\treturn true\n\tend\n\n\tif action == \"LobbyPortal\" then\n\t\tif visits[player] then return false, \"Leave the match first\" end\n\t\tlocal spawn = lobbySpawn()\n\t\tif not spawn then return false, \"Lobby spawn is missing\" end\n\t\tmoveRoot(root, CFrame.lookAt(spawn.Position + Vector3.new(0, 3, 0), spawn.Position + Vector3.new(0, 3, -15)))\n\t\treturn true\n\tend\n\n\tif visits[player] then return true end\n\tlocal arena = ArenaConfig.getArena(destination)\n    if not arena or arena:GetAttribute(\"TeleportReady\") ~= true then return false, \"Arena is unavailable\" end\n\tif action == \"Enter\" and arena:GetAttribute(\"MatchReady\") ~= true then return false, \"This arena is available for visits only\" end\n\tlocal sidelines = arena and arena:FindFirstChild(\"Sidelines\")\n\tlocal spawn = sidelines and sidelines:FindFirstChild(\"Spawn_Player\")\n\tif not spawn then return false, \"Arena spawn is missing\" end\n\tvisits[player] = { root = root, returnCFrame = root.CFrame, wasAnchored = root.Anchored }\n\troot.Anchored = true\n\tmoveRoot(root, spawn.CFrame * CFrame.new(0, 3, 0))\n\tplayer:SetAttribute(\"ActiveArena\", arena.Name)\n    player:SetAttribute(\"ArenaVisitOnly\", action == \"Visit\")\n\treturn true\nend\n\nlocal function setupPlayer(player)\n\tplayer.CharacterRemoving:Connect(function()\n\t\tleaveArena(player, getRoot(player))\n\tend)\nend\n\nPlayers.PlayerAdded:Connect(setupPlayer)\nPlayers.PlayerRemoving:Connect(function(player)\n\tvisits[player] = nil\n\tlastRequest[player] = nil\nend)\nfor _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end\n\n"},{"name":"LobbyClient","source":"local Players        = game:GetService(\"Players\")\nlocal RunService     = game:GetService(\"RunService\")\nlocal TweenService   = game:GetService(\"TweenService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ArenaTravelClient = require(ReplicatedStorage:WaitForChild(\"ArenaTravelClient\"))\nlocal LobbyConfig = require(ReplicatedStorage:WaitForChild(\"LobbyConfig\"))\n\nlocal player     = Players.LocalPlayer\nlocal playerGui  = player:WaitForChild(\"PlayerGui\")\nlocal character  = player.Character or player.CharacterAdded:Wait()\n\nplayer.CharacterAdded:Connect(function(c)\n    character = c\nend)\n\nlocal mmz       = workspace:WaitForChild(\"Lobby_MainModeZone\")\nlocal spawnPart = mmz:WaitForChild(\"MainModeSpawn\")\nlocal ringOuter = mmz:WaitForChild(\"RingOuter\")\n\nlocal RING_RADIUS = LobbyConfig.StoryAutoOpenRadius\n\nlocal C = {\n    bg      = Color3.fromRGB(18, 12, 36),\n    panel   = Color3.fromRGB(32, 20, 62),\n    border  = Color3.fromRGB(148, 88, 255),\n    accent  = Color3.fromRGB(180, 120, 255),\n    btnBg   = Color3.fromRGB(50, 28, 98),\n    btnHov  = Color3.fromRGB(78, 48, 145),\n    btnTxt  = Color3.fromRGB(230, 210, 255),\n    title   = Color3.fromRGB(220, 190, 255),\n    sub     = Color3.fromRGB(155, 130, 195),\n    close   = Color3.fromRGB(200, 70, 95),\n    play    = Color3.fromRGB(90, 215, 130),\n    playTxt = Color3.fromRGB(15, 55, 28),\n    gold    = Color3.fromRGB(255, 210, 80),\n    lock    = Color3.fromRGB(90, 80, 120),\n    lockTxt = Color3.fromRGB(140, 120, 170),\n    arena   = Color3.fromRGB(22, 14, 48),\n    arenaBorder = Color3.fromRGB(255, 180, 50),\n}\n\nlocal function corner(p, r)\n    Instance.new(\"UICorner\", p).CornerRadius = UDim.new(0, r or 14)\nend\nlocal function stroke(p, col, thick)\n    local s = Instance.new(\"UIStroke\", p)\n    s.Color = col or C.border; s.Thickness = thick or 2\nend\n\nlocal playGui = playerGui:WaitForChild(\"PlayButtonGui\")\nlocal playBtn = playGui:WaitForChild(\"PlayBtn\")\nplayBtn.Activated:Connect(function()\n    local success, message = ArenaTravelClient.toLobbyPortal()\n    if not success then warn(message) end\nend)\n\nlocal ModePickerUI = require(ReplicatedStorage:WaitForChild(\"ModePickerUI\"))\nlocal modeGui = ModePickerUI.build(playerGui)\nlocal mainBtn = modeGui.Panel.Content.Main\n\nlocal ArenaSelectionUI = require(ReplicatedStorage:WaitForChild(\"ArenaSelectionUI\"))\nlocal arenaGui = ArenaSelectionUI.build(playerGui)\nmainBtn.Activated:Connect(function()\n    ArenaSelectionUI.open(playerGui)\nend)\n\nlocal function modalOpen()\n    for _, name in ipairs({\"ArenaSelectGui\", \"PackShopGui\", \"ShopGui\", \"UnitsGui\", \"BattlePassGui\", \"PackRevealGui\", \"LobbyTravelGui\"}) do\n        local screen = playerGui:FindFirstChild(name)\n        if screen and screen.Enabled then return true end\n    end\n    return false\nend\n\nlocal onRing = false\n\nRunService.Heartbeat:Connect(function()\n    if player:GetAttribute(\"ActiveArena\") then\n        onRing = false\n        modeGui.Enabled = false\n        return\n    end\n    local c = player.Character; if not c then return end\n    local hrp = c:FindFirstChild(\"HumanoidRootPart\"); if not hrp then return end\n    local pos = hrp.Position\n    local dist = Vector2.new(pos.X - ringOuter.Position.X, pos.Z - ringOuter.Position.Z).Magnitude\n    local scale = mmz:GetScale()\n    local inside = dist <= RING_RADIUS * scale and math.abs(pos.Y - ringOuter.Position.Y) <= 8\n\n    if inside and not onRing then\n        if modeGui.Enabled then\n            onRing = true\n        elseif not modalOpen() then\n            onRing = true\n            ModePickerUI.open()\n        end\n    elseif not inside and onRing then\n        onRing = false\n        if modeGui.Enabled then\n            ModePickerUI.close()\n        end\n    end\nend)","parent":"StarterPlayer.StarterPlayerScripts","path":"StarterPlayer.StarterPlayerScripts.LobbyClient","class":"LocalScript","before":"local Players        = game:GetService(\"Players\")\nlocal RunService     = game:GetService(\"RunService\")\nlocal TweenService   = game:GetService(\"TweenService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ArenaTravelClient = require(ReplicatedStorage:WaitForChild(\"ArenaTravelClient\"))\n\nlocal player     = Players.LocalPlayer\nlocal playerGui  = player:WaitForChild(\"PlayerGui\")\nlocal character  = player.Character or player.CharacterAdded:Wait()\n\nplayer.CharacterAdded:Connect(function(c)\n    character = c\nend)\n\nlocal mmz       = workspace:WaitForChild(\"Lobby_MainModeZone\")\nlocal spawnPart = mmz:WaitForChild(\"MainModeSpawn\")\nlocal ringOuter = mmz:WaitForChild(\"RingOuter\")\n\nlocal RING_RADIUS = 11\n\nlocal C = {\n    bg      = Color3.fromRGB(18, 12, 36),\n    panel   = Color3.fromRGB(32, 20, 62),\n    border  = Color3.fromRGB(148, 88, 255),\n    accent  = Color3.fromRGB(180, 120, 255),\n    btnBg   = Color3.fromRGB(50, 28, 98),\n    btnHov  = Color3.fromRGB(78, 48, 145),\n    btnTxt  = Color3.fromRGB(230, 210, 255),\n    title   = Color3.fromRGB(220, 190, 255),\n    sub     = Color3.fromRGB(155, 130, 195),\n    close   = Color3.fromRGB(200, 70, 95),\n    play    = Color3.fromRGB(90, 215, 130),\n    playTxt = Color3.fromRGB(15, 55, 28),\n    gold    = Color3.fromRGB(255, 210, 80),\n    lock    = Color3.fromRGB(90, 80, 120),\n    lockTxt = Color3.fromRGB(140, 120, 170),\n    arena   = Color3.fromRGB(22, 14, 48),\n    arenaBorder = Color3.fromRGB(255, 180, 50),\n}\n\nlocal function corner(p, r)\n    Instance.new(\"UICorner\", p).CornerRadius = UDim.new(0, r or 14)\nend\nlocal function stroke(p, col, thick)\n    local s = Instance.new(\"UIStroke\", p)\n    s.Color = col or C.border; s.Thickness = thick or 2\nend\n\nlocal playGui = playerGui:WaitForChild(\"PlayButtonGui\")\nlocal playBtn = playGui:WaitForChild(\"PlayBtn\")\nplayBtn.Activated:Connect(function()\n    local success, message = ArenaTravelClient.toLobbyPortal()\n    if not success then warn(message) end\nend)\n\nlocal ModePickerUI = require(ReplicatedStorage:WaitForChild(\"ModePickerUI\"))\nlocal modeGui = ModePickerUI.build(playerGui)\nlocal mainBtn = modeGui.Panel.Content.Main\n\nlocal ArenaSelectionUI = require(ReplicatedStorage:WaitForChild(\"ArenaSelectionUI\"))\nlocal arenaGui = ArenaSelectionUI.build(playerGui)\nmainBtn.Activated:Connect(function()\n    ArenaSelectionUI.open(playerGui)\nend)\n\nlocal onRing = false\n\nRunService.Heartbeat:Connect(function()\n    if player:GetAttribute(\"ActiveArena\") then\n        onRing = false\n        modeGui.Enabled = false\n        return\n    end\n    local c = player.Character; if not c then return end\n    local hrp = c:FindFirstChild(\"HumanoidRootPart\"); if not hrp then return end\n    local pos = hrp.Position\n    local dist = Vector2.new(pos.X - ringOuter.Position.X, pos.Z - ringOuter.Position.Z).Magnitude\n    local inside = dist <= RING_RADIUS + 1\n\n    if inside and not onRing then\n        onRing = true\n        ModePickerUI.open()\n    elseif not inside and onRing then\n        onRing = false\n        if modeGui.Enabled then\n            ModePickerUI.close()\n        end\n    end\nend)\n"},{"name":"LobbyCollision","source":"local Collision = {}\nfunction Collision.apply(root)\n assert(root and root:IsA(\"Model\"), \"Lobby root is required\")\n local visuals = root:FindFirstChild(\"Visuals\")\n local colliders = root:FindFirstChild(\"Collision\")\n assert(visuals and colliders, \"Lobby Visuals and Collision folders are required\")\n local visualCount, collisionCount = 0, 0\n for _, part in ipairs(visuals:GetDescendants()) do\n  if part:IsA(\"BasePart\") then\n   part.Anchored = true\n   part.CanCollide = false\n   part.CanTouch = false\n   part.CanQuery = false\n   visualCount += 1\n  end\n end\n for _, part in ipairs(colliders:GetDescendants()) do\n  if part:IsA(\"BasePart\") then\n   part.Anchored = true\n   part.CanCollide = true\n   part.CanTouch = false\n   part.CanQuery = true\n   part.Transparency = 1\n   collisionCount += 1\n  end\n end\n return visualCount, collisionCount\nend\nreturn Collision","parent":"ReplicatedStorage","path":"ReplicatedStorage.LobbyCollision","class":"ModuleScript","before":null},{"name":"LobbyCollisionService","source":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Config = require(ReplicatedStorage:WaitForChild(\"LobbyConfig\"))\nlocal Collision = require(ReplicatedStorage:WaitForChild(\"LobbyCollision\"))\nCollision.apply(workspace:WaitForChild(Config.RootName))","parent":"ServerScriptService","path":"ServerScriptService.LobbyCollisionService","class":"Script","before":null},{"name":"LobbyConfig","source":"local Config = {}\nConfig.RootName = \"Lobby_MainModeZone\"\nConfig.RequestCooldown = 0.4\nConfig.PromptCooldown = 0.4\nConfig.PromptDistance = 10\nConfig.RootClearance = 3.5\nConfig.SafeLandingOffset = 0.12\nConfig.StoryAutoOpenRadius = 6\nConfig.PacksAutoOpenRadius = 6\nConfig.Destinations = {\n Arrival = { marker = \"PlayerArrival\", label = \"Arrival Plaza\", lookAt = \"FOCUS_CentralChampion\" },\n MainMode = { marker = \"PORTAL_Story\", label = \"Story Gate\", lookAt = \"StoryDestination\" },\n Packs = { marker = \"INTERACT_Summon\", label = \"Summon Hall\", lookAt = \"SummonDestination\" },\n Shop = { marker = \"INTERACT_Shop\", label = \"Unit Shop\", lookAt = \"NPC_Shopkeeper\" },\n Ranked = { marker = \"PORTAL_Ranked\", label = \"Ranked Hall\", lookAt = \"RankedDestination\" },\n PvP = { marker = \"PORTAL_Unranked\", label = \"Duel Court\", lookAt = \"RankedDestination\" },\n Clans = { marker = \"DISTRICT_NorthGate\", label = \"Guild Gate\", lookAt = \"NorthernSanctumFastTravel\" },\n Leaderboards = { marker = \"INTERACT_Leaderboards\", label = \"Champions Court\", lookAt = \"DISPLAY_SeasonChampion\" },\n Promenade = { marker = \"ARRIVAL_Arena_Promenade\", label = \"Arena Portals\", lookAt = \"PORTAL_01_Tenkaichi\" },\n Academy = { marker = \"AcademyFastTravel\", label = \"Training Academy\", lookAt = \"DISTRICT_Academy\" },\n Market = { marker = \"MarketFastTravel\", label = \"Merchant Quarter\", lookAt = \"DISTRICT_MerchantQuarter\" },\n Gardens = { marker = \"OuterGardenFastTravel\", label = \"Moon Gardens\", lookAt = \"HOBBY_TeaCeremony\" },\n Pagoda = { marker = \"DISTRICT_CelestialPagoda\", label = \"Celestial Pagoda\", lookAt = \"ACCESS_PagodaUpperGallery\" },\n Sanctum = { marker = \"NorthernSanctumFastTravel\", label = \"Northern Sanctum\", lookAt = \"DISTRICT_NorthGate\" },\n}\nConfig.TravelOrder = {\"Arrival\",\"MainMode\",\"Packs\",\"Shop\",\"Promenade\",\"Ranked\",\"PvP\",\"Leaderboards\",\"Academy\",\"Market\",\"Gardens\",\"Pagoda\",\"Sanctum\",\"Clans\"}\nreturn Config","parent":"ReplicatedStorage","path":"ReplicatedStorage.LobbyConfig","class":"ModuleScript","before":null},{"name":"LobbyDestinations","source":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ProximityPromptService = game:GetService(\"ProximityPromptService\")\nlocal StarterGui = game:GetService(\"StarterGui\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"LobbyConfig\"))\nlocal ArenaCatalog = require(ReplicatedStorage:WaitForChild(\"ArenaCatalog\"))\nlocal PlayerData = require(ReplicatedStorage:WaitForChild(\"PlayerData\"))\nlocal ArenaSelectionUI = require(ReplicatedStorage:WaitForChild(\"ArenaSelectionUI\"))\nlocal ArenaTravelClient = require(ReplicatedStorage:WaitForChild(\"ArenaTravelClient\"))\nlocal ModePickerUI = require(ReplicatedStorage:WaitForChild(\"ModePickerUI\"))\nlocal PackShopUI = require(ReplicatedStorage:WaitForChild(\"PackShopUI\"))\nlocal PackReveal = require(ReplicatedStorage:WaitForChild(\"PackReveal\"))\nlocal UnitsUI = require(ReplicatedStorage:WaitForChild(\"UnitsUI\"))\nlocal LevelPassUI = require(ReplicatedStorage:WaitForChild(\"LevelPassUI\"))\n\nlocal player = Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\nlocal lobby = workspace:WaitForChild(Config.RootName or \"Lobby_MainModeZone\")\nlocal travelGui = playerGui:WaitForChild(\"LobbyTravelGui\")\nlocal travelPanel = travelGui:WaitForChild(\"Panel\")\nlocal travelButtons = travelPanel:WaitForChild(\"Destinations\")\nlocal travelClose = travelPanel:WaitForChild(\"Close\")\nlocal travelConnections = {}\ntravelGui.Enabled = false\nlocal promptDistance = math.max(0, tonumber(Config.PromptDistance) or 10)\nlocal promptCooldown = math.max(0, tonumber(Config.PromptCooldown) or .4)\nlocal lastPrompt = -math.huge\nlocal lastTravel = -math.huge\nlocal busy = false\n\nlocal function attribute(prompt, name)\n    local current = prompt\n    while current and current ~= lobby do\n        local value = current:GetAttribute(name)\n        if value ~= nil then return value end\n        current = current.Parent\n    end\n    return nil\nend\n\nlocal arenaPrompts = {}\n\nlocal function refreshArenaPrompt(prompt)\n    if not prompt:IsDescendantOf(lobby) or attribute(prompt, \"LobbyAction\") ~= \"Arena\" or attribute(prompt, \"FreePlay\") == false then return end\n    local arena = ArenaCatalog.find(attribute(prompt, \"ArenaKey\"))\n    prompt.ActionText = arena and PlayerData.isArenaCompleted(arena.key) and \"Open Free Play\" or \"Locked\"\nend\n\nlocal function trackPrompt(instance)\n    if not instance:IsA(\"ProximityPrompt\") then return end\n    arenaPrompts[instance] = true\n    refreshArenaPrompt(instance)\nend\n\nfor _, descendant in ipairs(lobby:GetDescendants()) do trackPrompt(descendant) end\ntable.insert(travelConnections, lobby.DescendantAdded:Connect(trackPrompt))\ntable.insert(travelConnections, lobby.DescendantRemoving:Connect(function(instance)\n    arenaPrompts[instance] = nil\nend))\ntable.insert(travelConnections, PlayerData.Changed:Connect(function()\n    for prompt in pairs(arenaPrompts) do refreshArenaPrompt(prompt) end\nend))\n\nlocal function notification(title, message)\n    pcall(function()\n        StarterGui:SetCore(\"SendNotification\", {Title = title, Text = message, Duration = 5})\n    end)\nend\n\nlocal function position(prompt)\n    local parent = prompt.Parent\n    if not parent then return nil end\n    if parent:IsA(\"Attachment\") then return parent.WorldPosition end\n    if parent:IsA(\"BasePart\") then return parent.Position end\n    if parent:IsA(\"Model\") then return parent:GetPivot().Position end\n    return nil\nend\n\nlocal function allowed(prompt, triggeringPlayer)\n    if triggeringPlayer and triggeringPlayer ~= player then return false end\n    if not lobby:IsDescendantOf(workspace) or not prompt:IsA(\"ProximityPrompt\") or not prompt.Enabled or not prompt:IsDescendantOf(lobby) then return false end\n    if player:GetAttribute(\"ActiveArena\") ~= nil or ArenaSelectionUI.isBusy() or PackReveal.isOpen() then return false end\n    local character = player.Character\n    if not character or not character:IsDescendantOf(workspace) then return false end\n    local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n    local root = character and character:FindFirstChild(\"HumanoidRootPart\")\n    if not humanoid or humanoid.Health <= 0 or not root or not root:IsA(\"BasePart\") then return false end\n    local target = position(prompt)\n    if not target then return false end\n    local distance = math.min(promptDistance, prompt.MaxActivationDistance)\n    return (root.Position - target).Magnitude <= distance + 1\nend\n\nlocal function closeOtherPanels(action)\n    if action ~= \"TravelMenu\" then travelGui.Enabled = false end\n    if action ~= \"Story\" then ModePickerUI.close() end\n    if action ~= \"Arena\" then ArenaSelectionUI.close() end\n    if action ~= \"Summon\" then PackShopUI.close() end\n    if action ~= \"Units\" then UnitsUI.close() end\n    if action ~= \"BattlePass\" then LevelPassUI.close() end\n    if action ~= \"Shop\" then\n        local shopGui = playerGui:FindFirstChild(\"ShopGui\")\n        if shopGui then shopGui.Enabled = false end\n    end\nend\n\nlocal function dispatch(prompt)\n    local action = attribute(prompt, \"LobbyAction\")\n    if action == \"Arena\" then\n        local arena = ArenaCatalog.find(attribute(prompt, \"ArenaKey\"))\n        if not arena then return false, \"That arena is unavailable.\" end\n        local index\n        for current = 1, ArenaCatalog.count() do\n            if ArenaCatalog.get(current).key == arena.key then index = current; break end\n        end\n        if not index then return false, \"That arena is unavailable.\" end\n        local success, message = ArenaSelectionUI.open(playerGui, index, attribute(prompt, \"FreePlay\") ~= false)\n        if not success then return false, message end\n        closeOtherPanels(\"Arena\")\n    elseif action == \"Story\" then\n        ModePickerUI.build(playerGui)\n        closeOtherPanels(\"Story\")\n        ModePickerUI.open()\n    elseif action == \"Summon\" then\n        closeOtherPanels(\"Summon\")\n        PackShopUI.open(playerGui)\n    elseif action == \"Shop\" then\n        local shopGui = playerGui:FindFirstChild(\"ShopGui\")\n        if not shopGui or not shopGui:IsA(\"ScreenGui\") then return false, \"The shop is unavailable.\" end\n        closeOtherPanels(\"Shop\")\n        shopGui.Enabled = true\n    elseif action == \"Units\" then\n        closeOtherPanels(\"Units\")\n        UnitsUI.open(playerGui)\n    elseif action == \"BattlePass\" then\n        closeOtherPanels(\"BattlePass\")\n        LevelPassUI.open(playerGui)\n    elseif action == \"Notice\" then\n        local title = attribute(prompt, \"NoticeTitle\")\n        local message = attribute(prompt, \"NoticeText\")\n        if type(message) ~= \"string\" or message == \"\" then return false, \"This destination is not available yet.\" end\n        notification(type(title) == \"string\" and title ~= \"\" and title or \"Anime Combat Units\", message)\n    elseif action == \"TravelMenu\" then\n        closeOtherPanels(\"TravelMenu\")\n        travelGui.Enabled = true\n    elseif action == \"Travel\" then\n        local destination = attribute(prompt, \"Destination\")\n        if type(destination) ~= \"string\" or destination == \"\" then return false, \"That destination is unavailable.\" end\n        local success, message = ArenaTravelClient.toDestination(destination)\n        if not success then return false, message or \"Travel is unavailable.\" end\n        closeOtherPanels(\"Travel\")\n    else\n        return false, \"This destination is not available yet.\"\n    end\n    return true\nend\n\nlocal connection = ProximityPromptService.PromptTriggered:Connect(function(prompt, triggeringPlayer)\n    if busy or os.clock() - lastPrompt < promptCooldown or not allowed(prompt, triggeringPlayer) then return end\n    lastPrompt = os.clock()\n    busy = true\n    local ok, success, message = pcall(dispatch, prompt)\n    busy = false\n    if not ok then\n        warn(\"Lobby destination could not open: \" .. tostring(success))\n        notification(\"Anime Combat Units\", \"This destination is temporarily unavailable.\")\n    elseif not success then\n        notification(\"Anime Combat Units\", message or \"This destination is unavailable.\")\n    end\nend)\n\nlocal function menuTravel(button)\n    if busy or os.clock() - lastTravel < promptCooldown then return end\n    if player:GetAttribute(\"ActiveArena\") ~= nil or ArenaSelectionUI.isBusy() or PackReveal.isOpen() then return end\n    if not travelGui.Enabled or not button:IsDescendantOf(travelButtons) then return end\n    local character = player.Character\n    local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n    local root = character and character:FindFirstChild(\"HumanoidRootPart\")\n    if not character or not character:IsDescendantOf(workspace) or not humanoid or humanoid.Health <= 0 or not root or not root:IsA(\"BasePart\") then return end\n    local destination = button:GetAttribute(\"Destination\")\n    if type(destination) ~= \"string\" or destination == \"\" then\n        notification(\"Travel\", \"That destination is unavailable.\")\n        return\n    end\n    busy = true\n    lastTravel = os.clock()\n    local ok, success, message = pcall(ArenaTravelClient.toDestination, destination)\n    busy = false\n    if ok and success then\n        travelGui.Enabled = false\n    else\n        notification(\"Travel\", ok and message or \"Travel is temporarily unavailable.\")\n    end\nend\n\ntable.insert(travelConnections, travelClose.Activated:Connect(function()\n    travelGui.Enabled = false\nend))\nfor _, button in ipairs(travelButtons:GetChildren()) do\n    if button:IsA(\"GuiButton\") then\n        table.insert(travelConnections, button.Activated:Connect(function() menuTravel(button) end))\n    end\nend\ntable.insert(travelConnections, player:GetAttributeChangedSignal(\"ActiveArena\"):Connect(function()\n    if player:GetAttribute(\"ActiveArena\") ~= nil then travelGui.Enabled = false end\nend))\ntable.insert(travelConnections, player.CharacterRemoving:Connect(function()\n    travelGui.Enabled = false\nend))\n\nscript.Destroying:Connect(function()\n    connection:Disconnect()\n    for _, item in ipairs(travelConnections) do item:Disconnect() end\nend)","parent":"StarterPlayer.StarterPlayerScripts","path":"StarterPlayer.StarterPlayerScripts.LobbyDestinations","class":"LocalScript","before":"local Players = game:GetService(\"Players\")\nlocal StarterGui = game:GetService(\"StarterGui\")\nlocal ProximityPromptService = game:GetService(\"ProximityPromptService\")\nlocal player = Players.LocalPlayer\nlocal destinations = workspace:WaitForChild(\"Lobby_MainModeZone\"):WaitForChild(\"Destinations\")\nlocal messages = {\n\tRanked = \"The Season Hall is ready. Ranked battles are coming soon.\",\n\tPvP = \"The Duel Court is ready. Player challenges are coming soon.\",\n\tClans = \"The Guild House is ready. Clan features are coming soon.\",\n}\nlocal lastNotice = 0\n\nProximityPromptService.PromptTriggered:Connect(function(prompt)\n\tif player:GetAttribute(\"ActiveArena\") or not prompt:IsDescendantOf(destinations) then return end\n\tlocal name = prompt.Parent.Name\n\tlocal message = messages[name]\n\tif not message or os.clock() - lastNotice < 2 then return end\n\tlastNotice = os.clock()\n\tpcall(function()\n\t\tStarterGui:SetCore(\"SendNotification\", { Title = name, Text = message, Duration = 5 })\n\tend)\nend)\n\n"},{"name":"PackShopClient","source":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal player = Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\nlocal PackShopUI = require(ReplicatedStorage:WaitForChild(\"PackShopUI\"))\nlocal PlayerData = require(ReplicatedStorage:WaitForChild(\"PlayerData\"))\nlocal ArenaTravelClient = require(ReplicatedStorage:WaitForChild(\"ArenaTravelClient\"))\nlocal LobbyConfig = require(ReplicatedStorage:WaitForChild(\"LobbyConfig\"))\n\nlocal btnGui = playerGui:WaitForChild(\"PacksButtonGui\")\nlocal packsBtn = btnGui:WaitForChild(\"PacksBtn\")\nlocal packBadge = packsBtn:WaitForChild(\"PackBadge\")\nlocal function totalPacks()\n\tlocal n = 0\n\tfor _, c in pairs(PlayerData.allPackCounts()) do n += c end\n\treturn n\nend\nlocal function refreshPackBadge()\n\tlocal n = totalPacks()\n\tpackBadge.Visible = n > 0\n\tpackBadge.Value.Text = tostring(n)\nend\nrefreshPackBadge()\nPlayerData.Changed:Connect(refreshPackBadge)\npacksBtn.Activated:Connect(function()\n\tlocal success, message = ArenaTravelClient.toPackShop()\n\tif not success then warn(message) end\nend)\n\nPackShopUI.build(playerGui)\n\nlocal lobby = workspace:WaitForChild(\"Lobby_MainModeZone\")\nlocal zone = lobby:WaitForChild(\"Lobby_PackShopZone\")\nlocal trigger = zone:WaitForChild(\"PackShopTrigger\")\nlocal RADIUS = LobbyConfig.PacksAutoOpenRadius\nlocal function modalOpen()\n    for _, name in ipairs({\"ArenaSelectGui\", \"PackShopGui\", \"ShopGui\", \"UnitsGui\", \"BattlePassGui\", \"PackRevealGui\", \"LobbyTravelGui\"}) do\n        local screen = playerGui:FindFirstChild(name)\n        if screen and screen.Enabled then return true end\n    end\n    return false\nend\n\nlocal inside = false\n\nRunService.Heartbeat:Connect(function()\n\tlocal inMatch = player:GetAttribute(\"ActiveArena\") ~= nil\n\n\tpacksBtn.Visible = not inMatch\n\n\tlocal char = player.Character\n\tlocal hrp = char and char:FindFirstChild(\"HumanoidRootPart\")\n\tif inMatch or not hrp then\n\t\tif inside then inside = false; PackShopUI.close() end\n\t\treturn\n\tend\n\n\tlocal offset = hrp.Position - trigger.Position\n    local d = Vector2.new(offset.X, offset.Z).Magnitude\n    local inZone = d <= RADIUS * lobby:GetScale() and math.abs(offset.Y) <= 8\n\tif inZone and not inside then\n        local packGui = playerGui:FindFirstChild(\"PackShopGui\")\n        if packGui and packGui.Enabled then\n            inside = true\n        elseif not modalOpen() then\n            inside = true\n            PackShopUI.open(playerGui)\n        end\n\telseif not inZone and inside then\n\t\tinside = false\n\t\tPackShopUI.close()\n\tend\nend)","parent":"StarterPlayer.StarterPlayerScripts","path":"StarterPlayer.StarterPlayerScripts.PackShopClient","class":"LocalScript","before":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal player = Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\nlocal PackShopUI = require(ReplicatedStorage:WaitForChild(\"PackShopUI\"))\nlocal PlayerData = require(ReplicatedStorage:WaitForChild(\"PlayerData\"))\nlocal ArenaTravelClient = require(ReplicatedStorage:WaitForChild(\"ArenaTravelClient\"))\n\nlocal btnGui = playerGui:WaitForChild(\"PacksButtonGui\")\nlocal packsBtn = btnGui:WaitForChild(\"PacksBtn\")\nlocal packBadge = packsBtn:WaitForChild(\"PackBadge\")\nlocal function totalPacks()\n\tlocal n = 0\n\tfor _, c in pairs(PlayerData.allPackCounts()) do n += c end\n\treturn n\nend\nlocal function refreshPackBadge()\n\tlocal n = totalPacks()\n\tpackBadge.Visible = n > 0\n\tpackBadge.Value.Text = tostring(n)\nend\nrefreshPackBadge()\nPlayerData.Changed:Connect(refreshPackBadge)\npacksBtn.Activated:Connect(function()\n\tlocal success, message = ArenaTravelClient.toPackShop()\n\tif not success then warn(message) end\nend)\n\nPackShopUI.build(playerGui)\n\nlocal lobby = workspace:WaitForChild(\"Lobby_MainModeZone\")\nlocal zone = lobby:WaitForChild(\"Lobby_PackShopZone\")\nlocal trigger = zone:WaitForChild(\"PackShopTrigger\")\nlocal RADIUS = 11\nlocal inside = false\n\nRunService.Heartbeat:Connect(function()\n\tlocal inMatch = player:GetAttribute(\"ActiveArena\") ~= nil\n\n\tpacksBtn.Visible = not inMatch\n\n\tlocal char = player.Character\n\tlocal hrp = char and char:FindFirstChild(\"HumanoidRootPart\")\n\tif inMatch or not hrp then\n\t\tif inside then inside = false; PackShopUI.close() end\n\t\treturn\n\tend\n\n\tlocal d = (hrp.Position - trigger.Position).Magnitude\n\tif d <= RADIUS and not inside then\n\t\tinside = true\n\t\tPackShopUI.open(playerGui)\n\telseif d > RADIUS and inside then\n\t\tinside = false\n\t\tPackShopUI.close()\n\tend\nend)\n"},{"name":"PlayerData","source":"local PlayerData = {}\n\nlocal changed = Instance.new(\"BindableEvent\")\nPlayerData.Changed = changed.Event\nlocal function fire() changed:Fire() end\n\nlocal state = {\n\tcoins = 1000,\n\tgems = 100,\n\tmasteryChips = 0,\n\n\tlevel = 1,\n\txp = 0,\n\n\tarenaProgress = {\n\t\t[\"Tenkaichi\"] = { points = 0, wins = 0, losses = 0 },\n\t},\n\n\tclaimedMilestones = { [\"Tenkaichi\"] = {} },\n\n\tunitUnlock = {\n\t\tBluma = \"locked\",\n\t\tPikkolo = \"locked\",\n\t},\n\n\tunitLevels = {},\n\tunitXp = {},\n\tunitLocks = {},\n\n\tmasteryPoints = {},\n\n\tclaimedLevels = {},\n\n\tpackInventory = { bronze = 0, silver = 0, gold = 0 },\n\n\tdailyWin = { windowStart = 0, winsThisWindow = 0 },\n}\n\nlocal POINTS_PER_WIN = 10\nlocal POINTS_PER_LOSS = -10\n\nlocal MASTERY_THRESHOLD = { Common = 40, Rare = 60, Epic = 80, Legendary = 100 }\nlocal MASTERY_PER_MATCH = 10\nlocal ARENA_MILESTONES = {\n\t[\"Tenkaichi\"] = {\n\t\t{ points = 20,  reward = { coins = 1000 } },\n\t\t{ points = 40,  unlockUnit = \"Bluma\" },\n\t\t{ points = 80,  reward = { gems = 10 } },\n\t\t{ points = 100, unlockUnit = \"Pikkolo\" },\n\t},\n}\n\nfunction PlayerData.xpForLevel(level: number): number\n\n\treturn math.floor(100 * (1.25 ^ (level - 1)) + 0.5)\nend\n\nfunction PlayerData.get(key: string) return state[key] end\nfunction PlayerData.coins() return state.coins end\nfunction PlayerData.gems() return state.gems end\nfunction PlayerData.masteryChips() return state.masteryChips end\nfunction PlayerData.level() return state.level end\nfunction PlayerData.xp() return state.xp end\nfunction PlayerData.xpNeeded() return PlayerData.xpForLevel(state.level) end\n\nfunction PlayerData.unitLevel(id: string): number\n\treturn state.unitLevels[id] or 1\nend\nfunction PlayerData.unitXp(id: string): number\n\treturn state.unitXp[id] or 0\nend\nfunction PlayerData.masteryFor(id: string): number\n\treturn state.masteryPoints[id] or 0\nend\nfunction PlayerData.arenaWins(arena: string): number\n\tlocal prog = state.arenaProgress[arena]\n\treturn prog and prog.wins or 0\nend\n\nfunction PlayerData.addCoins(n: number) state.coins = math.max(0, state.coins + n); fire() end\nfunction PlayerData.addGems(n: number) state.gems = math.max(0, state.gems + n); fire() end\nfunction PlayerData.addMasteryChips(n: number) state.masteryChips = math.max(0, state.masteryChips + n); fire() end\nfunction PlayerData.spendCoins(n: number): boolean\n\tif state.coins < n then return false end\n\tstate.coins -= n; fire(); return true\nend\nfunction PlayerData.spendGems(n: number): boolean\n\tif state.gems < n then return false end\n\tstate.gems -= n; fire(); return true\nend\n\nfunction PlayerData.addXp(n: number): number\n\tstate.xp += n\n\tlocal gained = 0\n\twhile state.xp >= PlayerData.xpForLevel(state.level) do\n\t\tstate.xp -= PlayerData.xpForLevel(state.level)\n\t\tstate.level += 1\n\t\tgained += 1\n\tend\n\tfire()\n\treturn gained\nend\n\nfunction PlayerData.isArenaCompleted(arena: string): boolean\n    local prog = state.arenaProgress[arena]\n    local claimed = state.claimedMilestones[arena]\n    local completed = (prog and (prog.completed == true or (tonumber(prog.points) or 0) >= 100))\n        or (claimed and (claimed[100] == true or claimed[\"100\"] == true))\n    if not completed then return false end\n    if not prog then\n        prog = { points = 0, wins = 0, losses = 0 }\n        state.arenaProgress[arena] = prog\n    end\n    prog.completed = true\n    return true\nend\n\nfunction PlayerData.recordResult(arena: string, won: boolean)\n\tlocal prog = state.arenaProgress[arena]\n\tif not prog then prog = { points = 0, wins = 0, losses = 0 }; state.arenaProgress[arena] = prog end\n\tlocal claimed = state.claimedMilestones[arena]\n\tif not claimed then claimed = {}; state.claimedMilestones[arena] = claimed end\n\n\tPlayerData.isArenaCompleted(arena)\n    local before = prog.points\n\tif won then prog.wins += 1 else prog.losses += 1 end\n\tprog.points = math.clamp(prog.points + (won and POINTS_PER_WIN or POINTS_PER_LOSS), 0, 100)\n\tif prog.points >= 100 then prog.completed = true end\n\tlocal after = prog.points\n\n\tlocal result = {\n\t\tpoints = after, delta = after - before, won = won,\n\t\twins = prog.wins, losses = prog.losses,\n\t\tcoinsAwarded = 0, gemsAwarded = 0, unlockedUnits = {},\n\t}\n\n\tlocal milestones = ARENA_MILESTONES[arena]\n\tif milestones and after > before then\n\t\tfor _, ms in ipairs(milestones) do\n\t\t\tif after >= ms.points and not claimed[ms.points] then\n\t\t\t\tclaimed[ms.points] = true\n\t\t\t\tif ms.reward then\n\t\t\t\t\tif ms.reward.coins then state.coins += ms.reward.coins; result.coinsAwarded += ms.reward.coins end\n\t\t\t\t\tif ms.reward.gems then state.gems += ms.reward.gems; result.gemsAwarded += ms.reward.gems end\n\t\t\t\tend\n\t\t\t\tif ms.unlockUnit then\n\n\t\t\t\t\tif state.unitUnlock[ms.unlockUnit] ~= \"owned\" then\n\t\t\t\t\t\tstate.unitUnlock[ms.unlockUnit] = \"unlockable\"\n\t\t\t\t\tend\n\t\t\t\t\ttable.insert(result.unlockedUnits, ms.unlockUnit)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\tfire()\n\treturn result\nend\n\nfunction PlayerData.arenaProgress(arena: string)\n\tlocal prog = state.arenaProgress[arena] or { points = 0, wins = 0, losses = 0 }\n\treturn {\n\t\tpoints = prog.points, wins = prog.wins, losses = prog.losses,\n\t\tmilestones = ARENA_MILESTONES[arena] or {},\n        progressWins = prog.points / POINTS_PER_WIN,\n        completed = PlayerData.isArenaCompleted(arena),\n        claimed = table.clone(state.claimedMilestones[arena] or {}),\n\t}\nend\n\nfunction PlayerData.unitUnlockState(id: string): string\n\treturn state.unitUnlock[id] or \"owned\"\nend\nfunction PlayerData.isUnitLocked(id: string): boolean\n\treturn state.unitLocks[id] == true\nend\n\nfunction PlayerData.setUnitLocked(id: string, locked: boolean): boolean\n\tif PlayerData.unitUnlockState(id) ~= \"owned\" then return false end\n\tstate.unitLocks[id] = locked == true\n\tfire()\n\treturn true\nend\n\nfunction PlayerData.setUnitUnlockState(id: string, st: string): boolean\n\tif st ~= \"owned\" and PlayerData.isUnitLocked(id) then return false end\n\tstate.unitUnlock[id] = st\n\tfire()\n\treturn true\nend\n\nfunction PlayerData.ownUnit(id: string)\n\tstate.unitUnlock[id] = \"owned\"\n\tif (state.unitLevels[id] or 0) < 1 then state.unitLevels[id] = 1 end\n\tfire()\nend\n\nfunction PlayerData.addMasteryPoints(id: string, n: number)\n\tstate.masteryPoints[id] = (state.masteryPoints[id] or 0) + n\n\tfire()\nend\n\nfunction PlayerData.masteryThreshold(rarity: string): number\n\treturn MASTERY_THRESHOLD[rarity] or 40\nend\n\nfunction PlayerData.masteryLevel(id: string, rarity: string): number\n    return 1 + math.floor(math.max(0, PlayerData.masteryFor(id)) / PlayerData.masteryThreshold(rarity))\nend\n\nfunction PlayerData.masteryUnlocked(id: string, rarity: string): boolean\n\treturn (state.masteryPoints[id] or 0) >= PlayerData.masteryThreshold(rarity)\nend\nPlayerData.MASTERY_PER_MATCH = MASTERY_PER_MATCH\n\nlocal UNIT_BASE_XP = { Common = 5, Rare = 10, Epic = 20, Legendary = 25 }\nlocal UNIT_MAX_LEVEL = 15\n\nfunction PlayerData.unitXpForLevel(rarity: string, level: number): number\n\tlocal base = UNIT_BASE_XP[rarity] or 5\n\treturn base * (2 ^ (level - 1))\nend\n\nfunction PlayerData.boostStat(current: number): number\n\treturn math.floor(current * 1.10 + 0.5)\nend\n\nfunction PlayerData.unitStats(id: string, baseHealth: number, baseDamage: number)\n\tlocal lvl = PlayerData.unitLevel(id)\n\tlocal hp, dmg = baseHealth, baseDamage\n\tfor _ = 2, lvl do\n\t\thp = PlayerData.boostStat(hp)\n\t\tdmg = PlayerData.boostStat(dmg)\n\tend\n\treturn hp, dmg\nend\n\nfunction PlayerData.addUnitXp(id: string, n: number)\n\tstate.unitXp[id] = (state.unitXp[id] or 0) + n\n\tfire()\nend\n\nfunction PlayerData.unitXpProgress(id: string, rarity: string)\n\tlocal lvl = PlayerData.unitLevel(id)\n\tif lvl >= UNIT_MAX_LEVEL then return state.unitXp[id] or 0, nil end\n\treturn state.unitXp[id] or 0, PlayerData.unitXpForLevel(rarity, lvl)\nend\n\nfunction PlayerData.unitReadyToLevel(id: string, rarity: string): boolean\n\tlocal lvl = PlayerData.unitLevel(id)\n\tif lvl >= UNIT_MAX_LEVEL then return false end\n\treturn (state.unitXp[id] or 0) >= PlayerData.unitXpForLevel(rarity, lvl)\nend\n\nfunction PlayerData.unitLevelCost(currentLevel: number): number\n\n\tlocal raw = 1000 * (1.226 ^ (currentLevel - 1))\n\treturn math.floor(raw / 50 + 0.5) * 50\nend\n\nfunction PlayerData.tryLevelUnit(id: string, rarity: string): boolean\n\trarity = rarity or \"Common\"\n\tif not PlayerData.unitReadyToLevel(id, rarity) then return false end\n\tlocal lvl = PlayerData.unitLevel(id)\n\tlocal cost = PlayerData.unitLevelCost(lvl)\n\tif state.coins < cost then return false end\n\tstate.coins -= cost\n\tstate.unitXp[id] = (state.unitXp[id] or 0) - PlayerData.unitXpForLevel(rarity, lvl)\n\tstate.unitLevels[id] = lvl + 1\n\tfire()\n\treturn true\nend\n\nPlayerData.UNIT_MAX_LEVEL = UNIT_MAX_LEVEL\n\nlocal LEVEL_REWARDS = {\n\t[2]  = { coins = 200 },\n\t[3]  = { coins = 300 },\n\t[4]  = { gems = 15 },\n\t[5]  = { coins = 500, masteryChips = 5 },\n\t[6]  = { coins = 600 },\n\t[7]  = { gems = 20 },\n\t[8]  = { coins = 800 },\n\t[9]  = { coins = 1000 },\n\t[10] = { gems = 50, masteryChips = 10 },\n}\n\nlocal function defaultLevelReward(level: number)\n\treturn { coins = 100 + level * 50 }\nend\n\nfunction PlayerData.levelReward(level: number)\n\treturn LEVEL_REWARDS[level] or defaultLevelReward(level)\nend\n\nfunction PlayerData.levelRewardState(level: number): string\n\tif state.claimedLevels[level] then return \"claimed\" end\n\n\tif level >= 2 and state.level >= level then return \"claimable\" end\n\treturn \"locked\"\nend\n\nfunction PlayerData.claimLevelReward(level: number)\n\tif PlayerData.levelRewardState(level) ~= \"claimable\" then return nil end\n\tlocal reward = PlayerData.levelReward(level)\n\tif reward.coins then state.coins += reward.coins end\n\tif reward.gems then state.gems += reward.gems end\n\tif reward.masteryChips then state.masteryChips += reward.masteryChips end\n\tstate.claimedLevels[level] = true\n\tfire()\n\treturn reward\nend\n\nfunction PlayerData.unclaimedLevelCount(): number\n\tlocal n = 0\n\tfor lvl = 2, state.level do\n\t\tif not state.claimedLevels[lvl] then n += 1 end\n\tend\n\treturn n\nend\n\nfunction PlayerData.packCount(packId: string): number\n\treturn (state.packInventory and state.packInventory[packId]) or 0\nend\nfunction PlayerData.allPackCounts()\n\tlocal t = {}\n\tfor id, n in pairs(state.packInventory or {}) do t[id] = n end\n\treturn t\nend\nfunction PlayerData.addPack(packId: string, n: number)\n\tstate.packInventory[packId] = math.max(0, (state.packInventory[packId] or 0) + (n or 1))\n\tfire()\nend\n\nfunction PlayerData.consumePack(packId: string): boolean\n\tif (state.packInventory[packId] or 0) <= 0 then return false end\n\tstate.packInventory[packId] -= 1\n\tfire()\n\treturn true\nend\n\nfunction PlayerData.totalBankedPacks(): number\n\tlocal n = 0\n\tfor _, c in pairs(state.packInventory or {}) do n += c end\n\treturn n\nend\n\nlocal DAILY_WIN_DAY = 24 * 60 * 60\nlocal DAILY_WIN_PACKS = { \"bronze\", \"bronze\", \"bronze\", \"silver\" }\n\nlocal function dailyState(now)\n    now = now or os.time()\n    local dw = state.dailyWin\n    local day = math.floor(now / DAILY_WIN_DAY)\n    dw.pending = dw.pending or {}\n    if dw.day ~= day then\n        dw.day = day\n        dw.windowStart = day * DAILY_WIN_DAY\n        dw.winsThisWindow = 0\n        dw.claimed = {}\n    end\n    return dw\nend\n\nfunction PlayerData.grantDailyWinPack(): string?\n    local dw = dailyState()\n    if dw.winsThisWindow >= #DAILY_WIN_PACKS then return nil end\n    dw.winsThisWindow += 1\n    local packId = DAILY_WIN_PACKS[dw.winsThisWindow]\n    table.insert(dw.pending, {packId = packId, day = dw.day, slot = dw.winsThisWindow})\n    PlayerData.addPack(packId, 1)\n    return packId\nend\n\nfunction PlayerData.pendingDailyPack()\n    local pending = dailyState().pending\n    return pending[1] and table.clone(pending[1]) or nil\nend\n\nfunction PlayerData.consumeDailyPack(): string?\n    local dw = dailyState()\n    local reward = dw.pending[1]\n    if not reward or PlayerData.packCount(reward.packId) < 1 then return nil end\n    table.remove(dw.pending, 1)\n    state.packInventory[reward.packId] -= 1\n    if reward.day == dw.day then dw.claimed[reward.slot] = true end\n    fire()\n    return reward.packId\nend\n\nfunction PlayerData.dailyWinRewards()\n    local dw = dailyState()\n    local result = {}\n    for index, packId in ipairs(DAILY_WIN_PACKS) do\n        result[index] = {\n            packId = packId,\n            earned = index <= dw.winsThisWindow,\n            claimed = dw.claimed[index] == true,\n        }\n    end\n    return result\nend\n\nfunction PlayerData.dailyWinPacksRemaining(): number\n    return math.max(0, #DAILY_WIN_PACKS - dailyState().winsThisWindow)\nend\n\nfunction PlayerData.dailyWinResetIn(): number\n    local dw = dailyState()\n    return math.max(0, (dw.day + 1) * DAILY_WIN_DAY - os.time())\nend\n\nstate.dailyClaims = {}\nlocal DAY = 24 * 60 * 60\n\nfunction PlayerData.canClaimDaily(key: string): boolean\n\tlocal last = state.dailyClaims[key]\n\tif not last then return true end\n\treturn (os.time() - last) >= DAY\nend\n\nfunction PlayerData.secondsUntilDaily(key: string): number\n\tlocal last = state.dailyClaims[key]\n\tif not last then return 0 end\n\treturn math.max(0, DAY - (os.time() - last))\nend\n\nfunction PlayerData.claimDaily(key: string): boolean\n\tif not PlayerData.canClaimDaily(key) then return false end\n\tstate.dailyClaims[key] = os.time()\n\tfire()\n\treturn true\nend\n\nPlayerData.POINTS_PER_WIN = POINTS_PER_WIN\nPlayerData.POINTS_PER_LOSS = POINTS_PER_LOSS\n\nreturn PlayerData","parent":"ReplicatedStorage","path":"ReplicatedStorage.PlayerData","class":"ModuleScript","before":"local PlayerData = {}\n\nlocal changed = Instance.new(\"BindableEvent\")\nPlayerData.Changed = changed.Event\nlocal function fire() changed:Fire() end\n\nlocal state = {\n\tcoins = 1000,\n\tgems = 100,\n\tmasteryChips = 0,\n\n\tlevel = 1,\n\txp = 0,\n\n\tarenaProgress = {\n\t\t[\"Tenkaichi\"] = { points = 0, wins = 0, losses = 0 },\n\t},\n\n\tclaimedMilestones = { [\"Tenkaichi\"] = {} },\n\n\tunitUnlock = {\n\t\tBluma = \"locked\",\n\t\tPikkolo = \"locked\",\n\t},\n\n\tunitLevels = {},\n\tunitXp = {},\n\tunitLocks = {},\n\n\tmasteryPoints = {},\n\n\tclaimedLevels = {},\n\n\tpackInventory = { bronze = 0, silver = 0, gold = 0 },\n\n\tdailyWin = { windowStart = 0, winsThisWindow = 0 },\n}\n\nlocal POINTS_PER_WIN = 10\nlocal POINTS_PER_LOSS = -10\n\nlocal MASTERY_THRESHOLD = { Common = 40, Rare = 60, Epic = 80, Legendary = 100 }\nlocal MASTERY_PER_MATCH = 10\nlocal ARENA_MILESTONES = {\n\t[\"Tenkaichi\"] = {\n\t\t{ points = 20,  reward = { coins = 1000 } },\n\t\t{ points = 40,  unlockUnit = \"Bluma\" },\n\t\t{ points = 80,  reward = { gems = 10 } },\n\t\t{ points = 100, unlockUnit = \"Pikkolo\" },\n\t},\n}\n\nfunction PlayerData.xpForLevel(level: number): number\n\n\treturn math.floor(100 * (1.25 ^ (level - 1)) + 0.5)\nend\n\nfunction PlayerData.get(key: string) return state[key] end\nfunction PlayerData.coins() return state.coins end\nfunction PlayerData.gems() return state.gems end\nfunction PlayerData.masteryChips() return state.masteryChips end\nfunction PlayerData.level() return state.level end\nfunction PlayerData.xp() return state.xp end\nfunction PlayerData.xpNeeded() return PlayerData.xpForLevel(state.level) end\n\nfunction PlayerData.unitLevel(id: string): number\n\treturn state.unitLevels[id] or 1\nend\nfunction PlayerData.unitXp(id: string): number\n\treturn state.unitXp[id] or 0\nend\nfunction PlayerData.masteryFor(id: string): number\n\treturn state.masteryPoints[id] or 0\nend\nfunction PlayerData.arenaWins(arena: string): number\n\tlocal prog = state.arenaProgress[arena]\n\treturn prog and prog.wins or 0\nend\n\nfunction PlayerData.addCoins(n: number) state.coins = math.max(0, state.coins + n); fire() end\nfunction PlayerData.addGems(n: number) state.gems = math.max(0, state.gems + n); fire() end\nfunction PlayerData.addMasteryChips(n: number) state.masteryChips = math.max(0, state.masteryChips + n); fire() end\nfunction PlayerData.spendCoins(n: number): boolean\n\tif state.coins < n then return false end\n\tstate.coins -= n; fire(); return true\nend\nfunction PlayerData.spendGems(n: number): boolean\n\tif state.gems < n then return false end\n\tstate.gems -= n; fire(); return true\nend\n\nfunction PlayerData.addXp(n: number): number\n\tstate.xp += n\n\tlocal gained = 0\n\twhile state.xp >= PlayerData.xpForLevel(state.level) do\n\t\tstate.xp -= PlayerData.xpForLevel(state.level)\n\t\tstate.level += 1\n\t\tgained += 1\n\tend\n\tfire()\n\treturn gained\nend\n\nfunction PlayerData.recordResult(arena: string, won: boolean)\n\tlocal prog = state.arenaProgress[arena]\n\tif not prog then prog = { points = 0, wins = 0, losses = 0 }; state.arenaProgress[arena] = prog end\n\tlocal claimed = state.claimedMilestones[arena]\n\tif not claimed then claimed = {}; state.claimedMilestones[arena] = claimed end\n\n\tlocal before = prog.points\n\tif won then prog.wins += 1 else prog.losses += 1 end\n\tprog.points = math.clamp(prog.points + (won and POINTS_PER_WIN or POINTS_PER_LOSS), 0, 100)\n\tif prog.points >= 100 then prog.completed = true end\n\tlocal after = prog.points\n\n\tlocal result = {\n\t\tpoints = after, delta = after - before, won = won,\n\t\twins = prog.wins, losses = prog.losses,\n\t\tcoinsAwarded = 0, gemsAwarded = 0, unlockedUnits = {},\n\t}\n\n\tlocal milestones = ARENA_MILESTONES[arena]\n\tif milestones and after > before then\n\t\tfor _, ms in ipairs(milestones) do\n\t\t\tif after >= ms.points and not claimed[ms.points] then\n\t\t\t\tclaimed[ms.points] = true\n\t\t\t\tif ms.reward then\n\t\t\t\t\tif ms.reward.coins then state.coins += ms.reward.coins; result.coinsAwarded += ms.reward.coins end\n\t\t\t\t\tif ms.reward.gems then state.gems += ms.reward.gems; result.gemsAwarded += ms.reward.gems end\n\t\t\t\tend\n\t\t\t\tif ms.unlockUnit then\n\n\t\t\t\t\tif state.unitUnlock[ms.unlockUnit] ~= \"owned\" then\n\t\t\t\t\t\tstate.unitUnlock[ms.unlockUnit] = \"unlockable\"\n\t\t\t\t\tend\n\t\t\t\t\ttable.insert(result.unlockedUnits, ms.unlockUnit)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\tfire()\n\treturn result\nend\n\nfunction PlayerData.arenaProgress(arena: string)\n\tlocal prog = state.arenaProgress[arena] or { points = 0, wins = 0, losses = 0 }\n\treturn {\n\t\tpoints = prog.points, wins = prog.wins, losses = prog.losses,\n\t\tmilestones = ARENA_MILESTONES[arena] or {},\n        progressWins = prog.points / POINTS_PER_WIN,\n        completed = prog.completed == true,\n        claimed = table.clone(state.claimedMilestones[arena] or {}),\n\t}\nend\n\nfunction PlayerData.unitUnlockState(id: string): string\n\treturn state.unitUnlock[id] or \"owned\"\nend\nfunction PlayerData.isUnitLocked(id: string): boolean\n\treturn state.unitLocks[id] == true\nend\n\nfunction PlayerData.setUnitLocked(id: string, locked: boolean): boolean\n\tif PlayerData.unitUnlockState(id) ~= \"owned\" then return false end\n\tstate.unitLocks[id] = locked == true\n\tfire()\n\treturn true\nend\n\nfunction PlayerData.setUnitUnlockState(id: string, st: string): boolean\n\tif st ~= \"owned\" and PlayerData.isUnitLocked(id) then return false end\n\tstate.unitUnlock[id] = st\n\tfire()\n\treturn true\nend\n\nfunction PlayerData.ownUnit(id: string)\n\tstate.unitUnlock[id] = \"owned\"\n\tif (state.unitLevels[id] or 0) < 1 then state.unitLevels[id] = 1 end\n\tfire()\nend\n\nfunction PlayerData.addMasteryPoints(id: string, n: number)\n\tstate.masteryPoints[id] = (state.masteryPoints[id] or 0) + n\n\tfire()\nend\n\nfunction PlayerData.masteryThreshold(rarity: string): number\n\treturn MASTERY_THRESHOLD[rarity] or 40\nend\n\nfunction PlayerData.masteryLevel(id: string, rarity: string): number\n    return 1 + math.floor(math.max(0, PlayerData.masteryFor(id)) / PlayerData.masteryThreshold(rarity))\nend\n\nfunction PlayerData.masteryUnlocked(id: string, rarity: string): boolean\n\treturn (state.masteryPoints[id] or 0) >= PlayerData.masteryThreshold(rarity)\nend\nPlayerData.MASTERY_PER_MATCH = MASTERY_PER_MATCH\n\nlocal UNIT_BASE_XP = { Common = 5, Rare = 10, Epic = 20, Legendary = 25 }\nlocal UNIT_MAX_LEVEL = 15\n\nfunction PlayerData.unitXpForLevel(rarity: string, level: number): number\n\tlocal base = UNIT_BASE_XP[rarity] or 5\n\treturn base * (2 ^ (level - 1))\nend\n\nfunction PlayerData.boostStat(current: number): number\n\treturn math.floor(current * 1.10 + 0.5)\nend\n\nfunction PlayerData.unitStats(id: string, baseHealth: number, baseDamage: number)\n\tlocal lvl = PlayerData.unitLevel(id)\n\tlocal hp, dmg = baseHealth, baseDamage\n\tfor _ = 2, lvl do\n\t\thp = PlayerData.boostStat(hp)\n\t\tdmg = PlayerData.boostStat(dmg)\n\tend\n\treturn hp, dmg\nend\n\nfunction PlayerData.addUnitXp(id: string, n: number)\n\tstate.unitXp[id] = (state.unitXp[id] or 0) + n\n\tfire()\nend\n\nfunction PlayerData.unitXpProgress(id: string, rarity: string)\n\tlocal lvl = PlayerData.unitLevel(id)\n\tif lvl >= UNIT_MAX_LEVEL then return state.unitXp[id] or 0, nil end\n\treturn state.unitXp[id] or 0, PlayerData.unitXpForLevel(rarity, lvl)\nend\n\nfunction PlayerData.unitReadyToLevel(id: string, rarity: string): boolean\n\tlocal lvl = PlayerData.unitLevel(id)\n\tif lvl >= UNIT_MAX_LEVEL then return false end\n\treturn (state.unitXp[id] or 0) >= PlayerData.unitXpForLevel(rarity, lvl)\nend\n\nfunction PlayerData.unitLevelCost(currentLevel: number): number\n\n\tlocal raw = 1000 * (1.226 ^ (currentLevel - 1))\n\treturn math.floor(raw / 50 + 0.5) * 50\nend\n\nfunction PlayerData.tryLevelUnit(id: string, rarity: string): boolean\n\trarity = rarity or \"Common\"\n\tif not PlayerData.unitReadyToLevel(id, rarity) then return false end\n\tlocal lvl = PlayerData.unitLevel(id)\n\tlocal cost = PlayerData.unitLevelCost(lvl)\n\tif state.coins < cost then return false end\n\tstate.coins -= cost\n\tstate.unitXp[id] = (state.unitXp[id] or 0) - PlayerData.unitXpForLevel(rarity, lvl)\n\tstate.unitLevels[id] = lvl + 1\n\tfire()\n\treturn true\nend\n\nPlayerData.UNIT_MAX_LEVEL = UNIT_MAX_LEVEL\n\nlocal LEVEL_REWARDS = {\n\t[2]  = { coins = 200 },\n\t[3]  = { coins = 300 },\n\t[4]  = { gems = 15 },\n\t[5]  = { coins = 500, masteryChips = 5 },\n\t[6]  = { coins = 600 },\n\t[7]  = { gems = 20 },\n\t[8]  = { coins = 800 },\n\t[9]  = { coins = 1000 },\n\t[10] = { gems = 50, masteryChips = 10 },\n}\n\nlocal function defaultLevelReward(level: number)\n\treturn { coins = 100 + level * 50 }\nend\n\nfunction PlayerData.levelReward(level: number)\n\treturn LEVEL_REWARDS[level] or defaultLevelReward(level)\nend\n\nfunction PlayerData.levelRewardState(level: number): string\n\tif state.claimedLevels[level] then return \"claimed\" end\n\n\tif level >= 2 and state.level >= level then return \"claimable\" end\n\treturn \"locked\"\nend\n\nfunction PlayerData.claimLevelReward(level: number)\n\tif PlayerData.levelRewardState(level) ~= \"claimable\" then return nil end\n\tlocal reward = PlayerData.levelReward(level)\n\tif reward.coins then state.coins += reward.coins end\n\tif reward.gems then state.gems += reward.gems end\n\tif reward.masteryChips then state.masteryChips += reward.masteryChips end\n\tstate.claimedLevels[level] = true\n\tfire()\n\treturn reward\nend\n\nfunction PlayerData.unclaimedLevelCount(): number\n\tlocal n = 0\n\tfor lvl = 2, state.level do\n\t\tif not state.claimedLevels[lvl] then n += 1 end\n\tend\n\treturn n\nend\n\nfunction PlayerData.packCount(packId: string): number\n\treturn (state.packInventory and state.packInventory[packId]) or 0\nend\nfunction PlayerData.allPackCounts()\n\tlocal t = {}\n\tfor id, n in pairs(state.packInventory or {}) do t[id] = n end\n\treturn t\nend\nfunction PlayerData.addPack(packId: string, n: number)\n\tstate.packInventory[packId] = math.max(0, (state.packInventory[packId] or 0) + (n or 1))\n\tfire()\nend\n\nfunction PlayerData.consumePack(packId: string): boolean\n\tif (state.packInventory[packId] or 0) <= 0 then return false end\n\tstate.packInventory[packId] -= 1\n\tfire()\n\treturn true\nend\n\nfunction PlayerData.totalBankedPacks(): number\n\tlocal n = 0\n\tfor _, c in pairs(state.packInventory or {}) do n += c end\n\treturn n\nend\n\nlocal DAILY_WIN_DAY = 24 * 60 * 60\nlocal DAILY_WIN_PACKS = { \"bronze\", \"bronze\", \"bronze\", \"silver\" }\n\nlocal function dailyState(now)\n    now = now or os.time()\n    local dw = state.dailyWin\n    local day = math.floor(now / DAILY_WIN_DAY)\n    dw.pending = dw.pending or {}\n    if dw.day ~= day then\n        dw.day = day\n        dw.windowStart = day * DAILY_WIN_DAY\n        dw.winsThisWindow = 0\n        dw.claimed = {}\n    end\n    return dw\nend\n\nfunction PlayerData.grantDailyWinPack(): string?\n    local dw = dailyState()\n    if dw.winsThisWindow >= #DAILY_WIN_PACKS then return nil end\n    dw.winsThisWindow += 1\n    local packId = DAILY_WIN_PACKS[dw.winsThisWindow]\n    table.insert(dw.pending, {packId = packId, day = dw.day, slot = dw.winsThisWindow})\n    PlayerData.addPack(packId, 1)\n    return packId\nend\n\nfunction PlayerData.pendingDailyPack()\n    local pending = dailyState().pending\n    return pending[1] and table.clone(pending[1]) or nil\nend\n\nfunction PlayerData.consumeDailyPack(): string?\n    local dw = dailyState()\n    local reward = dw.pending[1]\n    if not reward or PlayerData.packCount(reward.packId) < 1 then return nil end\n    table.remove(dw.pending, 1)\n    state.packInventory[reward.packId] -= 1\n    if reward.day == dw.day then dw.claimed[reward.slot] = true end\n    fire()\n    return reward.packId\nend\n\nfunction PlayerData.dailyWinRewards()\n    local dw = dailyState()\n    local result = {}\n    for index, packId in ipairs(DAILY_WIN_PACKS) do\n        result[index] = {\n            packId = packId,\n            earned = index <= dw.winsThisWindow,\n            claimed = dw.claimed[index] == true,\n        }\n    end\n    return result\nend\n\nfunction PlayerData.dailyWinPacksRemaining(): number\n    return math.max(0, #DAILY_WIN_PACKS - dailyState().winsThisWindow)\nend\n\nfunction PlayerData.dailyWinResetIn(): number\n    local dw = dailyState()\n    return math.max(0, (dw.day + 1) * DAILY_WIN_DAY - os.time())\nend\n\nstate.dailyClaims = {}\nlocal DAY = 24 * 60 * 60\n\nfunction PlayerData.canClaimDaily(key: string): boolean\n\tlocal last = state.dailyClaims[key]\n\tif not last then return true end\n\treturn (os.time() - last) >= DAY\nend\n\nfunction PlayerData.secondsUntilDaily(key: string): number\n\tlocal last = state.dailyClaims[key]\n\tif not last then return 0 end\n\treturn math.max(0, DAY - (os.time() - last))\nend\n\nfunction PlayerData.claimDaily(key: string): boolean\n\tif not PlayerData.canClaimDaily(key) then return false end\n\tstate.dailyClaims[key] = os.time()\n\tfire()\n\treturn true\nend\n\nPlayerData.POINTS_PER_WIN = POINTS_PER_WIN\nPlayerData.POINTS_PER_LOSS = POINTS_PER_LOSS\n\nreturn PlayerData\n\n\n"},{"name":"ArenaTravelClient","source":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Lighting = game:GetService(\"Lighting\")\nlocal player = Players.LocalPlayer\nlocal travel = ReplicatedStorage:WaitForChild(\"ArenaEvents\"):WaitForChild(\"TravelRequest\")\nlocal ArenaCatalog = require(ReplicatedStorage:WaitForChild(\"ArenaCatalog\"))\nlocal PlayerData = require(ReplicatedStorage:WaitForChild(\"PlayerData\"))\nlocal ArenaTravelClient = {}\nlocal savedLighting\nlocal controls\n\nlocal function request(action, destination)\n\tlocal ok, success, message = pcall(function()\n\t\treturn travel:InvokeServer(action, destination)\n\tend)\n\tif not ok then return false, \"Travel is unavailable\" end\n\treturn success, message\nend\n\nlocal function setControls(enabled)\n\tif not controls then\n\t\tlocal module = player.PlayerScripts:FindFirstChild(\"PlayerModule\")\n\t\tif module then controls = require(module):GetControls() end\n\tend\n\tif controls then\n\t\tif enabled then controls:Enable() else controls:Disable() end\n\tend\nend\n\nlocal function enterArena(action, arenaName)\n\tlocal success, message = request(action, arenaName)\n\tif not success then return false, message end\n\tif not savedLighting then\n\t\tsavedLighting = {}\n\t\tfor _, key in ipairs({ \"ClockTime\", \"Brightness\", \"Ambient\", \"OutdoorAmbient\", \"ExposureCompensation\" }) do\n\t\t\tsavedLighting[key] = Lighting[key]\n\t\tend\n\tend\n\tLighting.ClockTime = 13.5\n\tLighting.Brightness = 1.9\n\tLighting.ExposureCompensation = -0.25\n\tLighting.Ambient = Color3.fromRGB(108, 119, 132)\n\tLighting.OutdoorAmbient = Color3.fromRGB(140, 153, 167)\n\tsetControls(action == \"Visit\")\n\treturn true\nend\n\nfunction ArenaTravelClient.enter(arenaName)\n    return enterArena(\"Enter\", arenaName)\nend\n\nfunction ArenaTravelClient.visit(arenaName)\n    local arena = ArenaCatalog.find(arenaName)\n    if not arena or not PlayerData.isArenaCompleted(arena.key) then\n        return false, \"Complete this arena in Story Mode to unlock free play.\"\n    end\n    return enterArena(\"Visit\", arena.modelName)\nend\n\nfunction ArenaTravelClient.restore()\n\tif savedLighting then\n\t\tfor key, value in pairs(savedLighting) do Lighting[key] = value end\n\t\tsavedLighting = nil\n\tend\n\tsetControls(true)\nend\n\nfunction ArenaTravelClient.leave()\n\tlocal success, message = request(\"Leave\")\n\tif success then ArenaTravelClient.restore() end\n\treturn success, message\nend\n\nfunction ArenaTravelClient.toLobbyPortal()\n\treturn request(\"LobbyPortal\")\nend\n\nfunction ArenaTravelClient.toPackShop()\n\treturn request(\"PackPortal\")\nend\n\nfunction ArenaTravelClient.toDestination(destination)\n\treturn request(\"Destination\", destination)\nend\n\nreturn ArenaTravelClient","parent":"ReplicatedStorage","path":"ReplicatedStorage.ArenaTravelClient","class":"ModuleScript","before":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Lighting = game:GetService(\"Lighting\")\nlocal player = Players.LocalPlayer\nlocal travel = ReplicatedStorage:WaitForChild(\"ArenaEvents\"):WaitForChild(\"TravelRequest\")\nlocal ArenaTravelClient = {}\nlocal savedLighting\nlocal controls\n\nlocal function request(action, destination)\n\tlocal ok, success, message = pcall(function()\n\t\treturn travel:InvokeServer(action, destination)\n\tend)\n\tif not ok then return false, \"Travel is unavailable\" end\n\treturn success, message\nend\n\nlocal function setControls(enabled)\n\tif not controls then\n\t\tlocal module = player.PlayerScripts:FindFirstChild(\"PlayerModule\")\n\t\tif module then controls = require(module):GetControls() end\n\tend\n\tif controls then\n\t\tif enabled then controls:Enable() else controls:Disable() end\n\tend\nend\n\nlocal function enterArena(action, arenaName)\n\tlocal success, message = request(action, arenaName)\n\tif not success then return false, message end\n\tif not savedLighting then\n\t\tsavedLighting = {}\n\t\tfor _, key in ipairs({ \"ClockTime\", \"Brightness\", \"Ambient\", \"OutdoorAmbient\", \"ExposureCompensation\" }) do\n\t\t\tsavedLighting[key] = Lighting[key]\n\t\tend\n\tend\n\tLighting.ClockTime = 13.5\n\tLighting.Brightness = 1.9\n\tLighting.ExposureCompensation = -0.25\n\tLighting.Ambient = Color3.fromRGB(108, 119, 132)\n\tLighting.OutdoorAmbient = Color3.fromRGB(140, 153, 167)\n\tsetControls(false)\n\treturn true\nend\n\nfunction ArenaTravelClient.enter(arenaName)\n    return enterArena(\"Enter\", arenaName)\nend\n\nfunction ArenaTravelClient.visit(arenaName)\n    return enterArena(\"Visit\", arenaName)\nend\n\nfunction ArenaTravelClient.restore()\n\tif savedLighting then\n\t\tfor key, value in pairs(savedLighting) do Lighting[key] = value end\n\t\tsavedLighting = nil\n\tend\n\tsetControls(true)\nend\n\nfunction ArenaTravelClient.leave()\n\tlocal success, message = request(\"Leave\")\n\tif success then ArenaTravelClient.restore() end\n\treturn success, message\nend\n\nfunction ArenaTravelClient.toLobbyPortal()\n\treturn request(\"LobbyPortal\")\nend\n\nfunction ArenaTravelClient.toPackShop()\n\treturn request(\"PackPortal\")\nend\n\nfunction ArenaTravelClient.toDestination(destination)\n\treturn request(\"Destination\", destination)\nend\n\nreturn ArenaTravelClient\n\n"},{"name":"ArenaCameraController","source":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal player = Players.LocalPlayer\nlocal arena\nlocal savedCamera\nlocal zoom = 1\nlocal pinchZoom = 1\n\nlocal function restoreCamera()\n\tRunService:UnbindFromRenderStep(\"ArenaCamera\")\n\tarena = nil\n\tlocal camera = workspace.CurrentCamera\n\tif savedCamera and camera then\n\t\tcamera.CameraType = savedCamera.cameraType\n\t\tcamera.FieldOfView = savedCamera.fieldOfView\n\t\tcamera.CameraSubject = player.Character and player.Character:FindFirstChildOfClass(\"Humanoid\") or savedCamera.subject\n\t\tsavedCamera = nil\n\tend\nend\n\nlocal function updateCamera()\n\tlocal camera = workspace.CurrentCamera\n\tlocal focus = arena and arena:FindFirstChild(\"CameraFocus\")\n\tif not camera or not focus then return end\n\tlocal aspect = camera.ViewportSize.X / math.max(1, camera.ViewportSize.Y)\n\tlocal height = math.max(79, 52 / math.max(0.45, aspect)) * zoom\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tcamera.FieldOfView = 52\n\tlocal position = focus.CFrame:PointToWorldSpace(Vector3.new(0, height, -height * 0.7))\n\tcamera.CFrame = CFrame.lookAt(position, focus.Position)\n\tcamera.Focus = focus.CFrame\nend\n\nlocal function arenaChanged()\n    if player:GetAttribute(\"ArenaVisitOnly\") == true then restoreCamera() return end\n\tlocal name = player:GetAttribute(\"ActiveArena\")\n\tlocal nextArena = name and workspace:FindFirstChild(name)\n\tif not nextArena then restoreCamera() return end\n\tif not savedCamera then\n\t\tlocal camera = workspace.CurrentCamera\n\t\tsavedCamera = { cameraType = camera.CameraType, fieldOfView = camera.FieldOfView, subject = camera.CameraSubject }\n\tend\n\tarena = nextArena\n\tzoom = 1\n\tRunService:UnbindFromRenderStep(\"ArenaCamera\")\n\tRunService:BindToRenderStep(\"ArenaCamera\", Enum.RenderPriority.Camera.Value + 1, updateCamera)\nend\n\nplayer:GetAttributeChangedSignal(\"ActiveArena\"):Connect(arenaChanged)\nplayer:GetAttributeChangedSignal(\"ArenaVisitOnly\"):Connect(arenaChanged)\nplayer.CharacterRemoving:Connect(restoreCamera)\nUserInputService.InputChanged:Connect(function(input, processed)\n\tif arena and not processed and input.UserInputType == Enum.UserInputType.MouseWheel then\n\t\tzoom = math.clamp(zoom - input.Position.Z * 0.05, 0.85, 1.25)\n\tend\nend)\nUserInputService.TouchPinch:Connect(function(_, scale, _, state, processed)\n\tif not arena or processed then return end\n\tif state == Enum.UserInputState.Begin then pinchZoom = zoom end\n\tif state == Enum.UserInputState.Change then zoom = math.clamp(pinchZoom / math.max(scale, 0.1), 0.85, 1.25) end\nend)\narenaChanged()","parent":"StarterPlayer.StarterPlayerScripts","path":"StarterPlayer.StarterPlayerScripts.ArenaCameraController","class":"LocalScript","before":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal player = Players.LocalPlayer\nlocal arena\nlocal savedCamera\nlocal zoom = 1\nlocal pinchZoom = 1\n\nlocal function restoreCamera()\n\tRunService:UnbindFromRenderStep(\"ArenaCamera\")\n\tarena = nil\n\tlocal camera = workspace.CurrentCamera\n\tif savedCamera and camera then\n\t\tcamera.CameraType = savedCamera.cameraType\n\t\tcamera.FieldOfView = savedCamera.fieldOfView\n\t\tcamera.CameraSubject = player.Character and player.Character:FindFirstChildOfClass(\"Humanoid\") or savedCamera.subject\n\t\tsavedCamera = nil\n\tend\nend\n\nlocal function updateCamera()\n\tlocal camera = workspace.CurrentCamera\n\tlocal focus = arena and arena:FindFirstChild(\"CameraFocus\")\n\tif not camera or not focus then return end\n\tlocal aspect = camera.ViewportSize.X / math.max(1, camera.ViewportSize.Y)\n\tlocal height = math.max(79, 52 / math.max(0.45, aspect)) * zoom\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tcamera.FieldOfView = 52\n\tlocal position = focus.CFrame:PointToWorldSpace(Vector3.new(0, height, -height * 0.7))\n\tcamera.CFrame = CFrame.lookAt(position, focus.Position)\n\tcamera.Focus = focus.CFrame\nend\n\nlocal function arenaChanged()\n\tlocal name = player:GetAttribute(\"ActiveArena\")\n\tlocal nextArena = name and workspace:FindFirstChild(name)\n\tif not nextArena then restoreCamera() return end\n\tif not savedCamera then\n\t\tlocal camera = workspace.CurrentCamera\n\t\tsavedCamera = { cameraType = camera.CameraType, fieldOfView = camera.FieldOfView, subject = camera.CameraSubject }\n\tend\n\tarena = nextArena\n\tzoom = 1\n\tRunService:UnbindFromRenderStep(\"ArenaCamera\")\n\tRunService:BindToRenderStep(\"ArenaCamera\", Enum.RenderPriority.Camera.Value + 1, updateCamera)\nend\n\nplayer:GetAttributeChangedSignal(\"ActiveArena\"):Connect(arenaChanged)\nplayer.CharacterRemoving:Connect(restoreCamera)\nUserInputService.InputChanged:Connect(function(input, processed)\n\tif arena and not processed and input.UserInputType == Enum.UserInputType.MouseWheel then\n\t\tzoom = math.clamp(zoom - input.Position.Z * 0.05, 0.85, 1.25)\n\tend\nend)\nUserInputService.TouchPinch:Connect(function(_, scale, _, state, processed)\n\tif not arena or processed then return end\n\tif state == Enum.UserInputState.Begin then pinchZoom = zoom end\n\tif state == Enum.UserInputState.Change then zoom = math.clamp(pinchZoom / math.max(scale, 0.1), 0.85, 1.25) end\nend)\narenaChanged()\n\n"}]]====])
local root=assert(workspace:FindFirstChild("ACU_Citadel_Staging"),"Staged lobby missing")
assert(root:GetAttribute("SetupState")=="Validated","Finish the lobby validation first")
assert(root:GetAttribute("MarkersBuiltAtScale")==root:GetScale(),"Scale changed after marker validation")
local old=assert(workspace:FindFirstChild("Lobby_MainModeZone"),"Original lobby missing")
local backup=assert(game.ServerStorage:FindFirstChild(root:GetAttribute("BackupFolder")),"Backup missing")
local menu=assert(backup:FindFirstChild("LobbyTravelGui"),"Authored travel menu missing")
assert(not game.StarterGui:FindFirstChild("LobbyTravelGui"),"Travel menu already installed")
assert(root:FindFirstChild("MainModeSpawn") and root:FindFirstChild("RingOuter") and root:FindFirstChild("Destinations"),"Compatibility markers missing")
assert(root:FindFirstChild("Lobby_PackShopZone") and root.Lobby_PackShopZone:FindFirstChild("PackShopTrigger"),"Pack shop trigger missing")
assert(root:FindFirstChild("SpawnLocation"),"Spawn missing")
assert(#root.Collision.Supplemental:GetChildren()==801,"Collision patch incomplete")
local function resolve(path)
 local current=game
 for segment in path:gmatch("[^.]+") do current=assert(current:FindFirstChild(segment),"Missing "..path) end
 return current
end
local function normalize(s)
 return (s:gsub("\r\n","\n"):gsub("%s+$",""))
end
local prepared={}
for _,change in ipairs(changes) do
 local parent=resolve(change.parent)
 local target=parent:FindFirstChild(change.name)
 assert(loadstring(change.source), "Syntax error in "..change.path)
 if type(change.before) == "string" then
  assert(target and target:IsA("LuaSourceContainer"),"Missing "..change.path)
  assert(normalize(target.Source)==normalize(change.before),"Source changed: "..change.path)
 else
  assert(not target,"New script already exists: "..change.path)
 end
 table.insert(prepared,{change=change,parent=parent,target=target,oldSource=target and target.Source})
end
local sourceBackup=Instance.new("Folder");sourceBackup.Name="Scripts";sourceBackup.Parent=backup
for _,entry in ipairs(prepared) do
 if entry.target then local copy=entry.target:Clone();copy.Name=entry.change.path;copy.Parent=sourceBackup end
end
local gui
local created={}
local ok,err=pcall(function()
 for _,entry in ipairs(prepared) do
  local target=entry.target
  if not target then
   target=Instance.new(entry.change.class);target.Name=entry.change.name
   table.insert(created,target)
  end
  target.Source=entry.change.source
  target.Parent=entry.parent
 end
 gui=menu:Clone();gui.Parent=game.StarterGui
 old.Parent=backup
 root.Name="Lobby_MainModeZone"
 root.SpawnLocation.Enabled=true
 root:SetAttribute("SetupState","Integrated")
 root:SetAttribute("FreePlayLocks","ClientSessionCompletion")
 root:SetAttribute("IntegratedAtUtc",os.date("!%Y-%m-%dT%H:%M:%SZ"))
end)
if not ok then
 for _,entry in ipairs(prepared) do if entry.target then entry.target.Source=entry.oldSource end end
 for _,target in ipairs(created) do target:Destroy() end
 if gui then gui:Destroy() end
 root.Name="ACU_Citadel_Staging";root.SpawnLocation.Enabled=false;root:SetAttribute("SetupState","Validated")
 old.Parent=workspace
 error(err)
end
game:GetService("ChangeHistoryService"):SetWaypoint("ACU Citadel integration")
return Http:JSONEncode({installedScripts=#changes,newLobby=root:GetFullName(),scale=root:GetScale(),oldLobby=old:GetFullName(),travelMenu=gui:GetFullName(),spawnEnabled=root.SpawnLocation.Enabled,freePlayCompletion="100 story points in the same arena; session state"})
