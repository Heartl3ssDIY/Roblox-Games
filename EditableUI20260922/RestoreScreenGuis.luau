 elseif t=="NumberSequence" then local k={} for i=2,#v do table.insert(k,NumberSequenceKeypoint.new(v[i][1],v[i][2],v[i][3])) end return NumberSequence.new(k)
 elseif t=="ColorSequence" then local k={} for i=2,#v do table.insert(k,ColorSequenceKeypoint.new(v[i][1],decode(v[i][2]))) end return ColorSequence.new(k)
 end
 error("Unknown property type "..tostring(t))
end
local function create(n,parent)
